diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.c b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.c
new file mode 100644
index 0000000..2fcd71e
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.c
@@ -0,0 +1,1208 @@
+#include "tdrive.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+#define ST_TIMEOUT 0x02
+#define ST_EOI     0x40
+#define ST_NODEV   0x80
+
+/* ---- status channel ---------------------------------------------------- */
+static const struct { uint8_t code; const char *msg; } MSGS[] = {
+    {0, " OK"}, {1, "FILES SCRATCHED"}, {26, "WRITE PROTECT ON"}, {30, "SYNTAX ERROR"},
+    {31, "SYNTAX ERROR"}, {33, "SYNTAX ERROR"}, {34, "SYNTAX ERROR"}, {62, "FILE NOT FOUND"}, {63, "FILE EXISTS"}, {64, "FILE TYPE MISMATCH"},
+    {20, "READ ERROR"}, {21, "READ ERROR"}, {22, "READ ERROR"}, {23, "READ ERROR"}, {24, "READ ERROR"}, {27, "READ ERROR"},
+    {29, "DISK ID MISMATCH"}, {25, "WRITE ERROR"}, {50, "RECORD NOT PRESENT"}, {51, "OVERFLOW IN RECORD"}, {52, "FILE TOO LARGE"}, {65, "NO BLOCK"}, {66, "ILLEGAL TRACK OR SECTOR"}, {70, "NO CHANNEL"}, {72, "DISK FULL"}, {73, "TRTDRIVE V1.0"}, {74, "DRIVE NOT READY"},
+};
+
+VD_COLD static void set_err(vd_unit_t *u, uint8_t code, uint8_t t, uint8_t s)
+{ u->err = code; u->err_t = t; u->err_s = s; }
+
+static uint8_t *put2(uint8_t *p, unsigned n) { *p++ = (uint8_t)('0' + n / 10 % 10); *p++ = (uint8_t)('0' + n % 10); return p; }
+
+/* Render "NN,MESSAGE,TT,SS\r" into statbuf and clear the error. */
+VD_COLD static uint16_t status_text(vd_unit_t *u)
+{
+    uint8_t *p = u->statbuf;
+    const char *m = "";
+    for (unsigned i = 0; i < sizeof MSGS / sizeof MSGS[0]; i++) if (MSGS[i].code == u->err) m = MSGS[i].msg;
+    p = put2(p, u->err); *p++ = ',';
+    while (*m) *p++ = (uint8_t)*m++;
+    *p++ = ','; p = put2(p, u->err_t); *p++ = ','; p = put2(p, u->err_s); *p++ = '\r';
+    uint16_t n = (uint16_t)(p - u->statbuf);
+    set_err(u, 0, 0, 0);
+    u->stat_len = (uint8_t)n; u->stat_pos = 0;
+    return n;
+}
+
+/* A read failed: the bad sector the image's error table reported (code and track/sector, as a real drive shows them), else code. */
+VD_COLD static void read_err(vd_unit_t *u, uint8_t code, uint8_t t, uint8_t s)
+{
+    if (u->disk && u->disk->bad) { set_err(u, u->disk->bad, u->disk->bad_t, u->disk->bad_s); u->disk->bad = 0; }
+    else set_err(u, code, t, s);
+}
+
+VD_COLD static void err_from(vd_unit_t *u, int r)
+{
+    if (r == D64_E_BADSEC || r == D64_E_IO) { read_err(u, 74, 0, 0); return; }   /* a chain or directory walk collapses codes to -1 */
+    switch (r) {
+    case D64_E_FULL:    set_err(u, 72, 0, 0); break;
+    case D64_E_EXISTS:  set_err(u, 63, 0, 0); break;
+    case D64_E_NAME:    set_err(u, 33, 0, 0); break;
+    case D64_E_RO:
+    case D64_E_LOCKED:  set_err(u, 26, 0, 0); break;
+    case D64_E_NOTFOUND:set_err(u, 62, 0, 0); break;
+    case D64_E_TYPE:    set_err(u, 64, 0, 0); break;
+    case D64_E_TOOBIG:  set_err(u, 52, 0, 0); break;
+    default:            set_err(u, 74, 0, 0); break;
+    }
+}
+
+/* ---- channels ---------------------------------------------------------- */
+VD_COLD static vd_chan_t *chan_find(vd_unit_t *u, int ch)
+{
+    uint8_t i = u->slot_of[ch];
+    return i ? &u->slot[i - 1] : NULL;
+}
+
+VD_COLD static void close_all(vd_unit_t *u);
+
+/* Undo the temporary selection of a listing by path: the folder / image that was selected before is selected again. */
+VD_COLD static void restore_selection(vd_unit_t *u)
+{
+    u->restore_ch = 0;
+    close_all(u);                                                 /* anything opened on the temporary image meanwhile goes with it */
+    tdrive_t *v = u->owner;
+    d64_t *d = NULL;
+    u->disk = NULL;
+    if (v && v->host.pop) v->host.pop(v->host.ctx, u->index, &d);
+    u->disk = d;
+}
+
+VD_COLD static void chan_close(vd_unit_t *u, int ch)
+{
+    vd_chan_t *c = chan_find(u, ch);
+    if (!c) return;
+    if (c->mode == 3 && u->disk) {
+        int r = d64_close_write(u->disk, &c->u.w);
+        if (r) err_from(u, r);
+    }
+    if ((c->mode == 6 || c->mode == 7) && u->owner) {
+        const vd_host_t *h = &u->owner->host;
+        if (c->mode == 7 && c->u.h.pos && h->hf_write && h->hf_write(h->ctx, u->index, c->u.h.buf, c->u.h.pos)) set_err(u, 74, 0, 0);
+        if (h->hf_close) h->hf_close(h->ctx, u->index, c->mode == 7);
+    }
+    if (c->mode == 8 && u->disk) {
+        int r = d64_rel_flush(u->disk, &c->u.l.f);
+        if (r) err_from(u, r);
+    }
+    if (c->mode == 9 && u->owner && u->owner->host.plain_close) u->owner->host.plain_close(u->owner->host.ctx, u->index);
+    c->mode = 0;
+    u->slot_of[ch] = 0;
+    if (u->restore_ch == ch + 1) restore_selection(u);
+}
+
+VD_COLD static vd_chan_t *chan_alloc(vd_unit_t *u, int ch)
+{
+    chan_close(u, ch);
+    for (int i = 0; i < VD_NSLOT; i++) {
+        int used = 0;
+        for (int k = 0; k < 16; k++) if (u->slot_of[k] == i + 1) used = 1;
+        if (!used) { u->slot_of[ch] = (uint8_t)(i + 1); u->slot[i].mode = 0; return &u->slot[i]; }
+    }
+    set_err(u, 70, 0, 0);                              /* NO CHANNEL */
+    return NULL;
+}
+
+VD_COLD static void close_all(vd_unit_t *u) { for (int i = 0; i < 16; i++) chan_close(u, i); }
+
+/* name[0..len) -> split off a leading "0:" style drive prefix; returns pointer to name proper. */
+VD_COLD static const char *strip_prefix(const char *p, const char *end)
+{
+    for (const char *q = p; q < end && q < p + 3; q++) if (*q == ':') return q + 1;
+    return p;
+}
+
+/* CMD path in front of a name: "[n]/dir/dir/:name" is relative to the current folder, "[n]//dir/:name" starts at the card
+ * root ([n] = a drive / partition number, ignored). Rewritten into the syntax path_walk takes: "dir/dir/name", "/dir/name"; a
+ * single "/" before the colon is the current folder ("/:name" -> "name"). The prefix ends at the first ':' ahead of any ','
+ * (OPEN modifiers), everything after the colon is copied unchanged. Returns 0 (no CMD prefix, out untouched), 1 (an empty
+ * prefix: out is just the name), 2 (out holds a path) or -1 (too long). */
+VD_COLD static int cmd_path(const char *s, const char *end, char *out, size_t cap)
+{
+    while (s < end && *s >= '0' && *s <= '9') s++;
+    if (s >= end || *s != '/') return 0;
+    const char *colon = s;
+    while (colon < end && *colon != ':' && *colon != ',') colon++;
+    if (colon >= end || *colon != ':') return 0;
+    size_t n = (size_t)(colon - s - 1), m = (size_t)(end - colon - 1);
+    if (n + m + 2 > cap) return -1;
+    memcpy(out, s + 1, n);                                       /* "//a/" -> "/a/" (root), "/a/" -> "a/" (relative) */
+    if (n && out[n - 1] != '/') out[n++] = '/';
+    memcpy(out + n, colon + 1, m); out[n + m] = 0;
+    return n ? 2 : 1;
+}
+
+typedef struct { char name[VD_CMDBUF]; int has_name; uint8_t type; char mode; int replace; int ok; uint8_t reclen; int cmdpath; } open_spec_t;
+
+VD_COLD static open_spec_t parse_open(const uint8_t *raw, uint8_t len)
+{
+    open_spec_t o; memset(&o, 0, sizeof o);
+    char buf[VD_CMDBUF + 1];
+    memcpy(buf, raw, len); buf[len] = 0;
+    const char *p = buf, *end = buf + len;
+    if (*p == '@') { o.replace = 1; p++; }
+    char cp[VD_CMDBUF + 1];
+    int k = cmd_path(p, end, cp, sizeof cp);                  /* "//GAMES/:NAME", "/SUB/:NAME,S,R" */
+    if (k < 0) return o;                                      /* no name: a syntax error */
+    if (k) { o.cmdpath = k == 2; p = cp; end = cp + strlen(cp); }
+    else p = strip_prefix(p, end);
+    const char *comma = p;
+    while (comma < end && *comma != ',') comma++;
+    size_t nl = (size_t)(comma - p);
+    memcpy(o.name, p, nl); o.name[nl] = 0; o.has_name = nl > 0;
+    o.ok = 1;
+    while (comma < end) {
+        const char *f = comma + 1;
+        switch (*f) {
+        case 'P': o.type = 2; break;
+        case 'S': o.type = 1; break;
+        case 'U': o.type = 3; break;
+        case 'L':                                      /* ",L,"+CHR$(record length): the length is a raw byte, maybe "," or "R" */
+            o.type = 4;
+            if (f + 2 < end && f[1] == ',') { o.reclen = (uint8_t)f[2]; f += 2; }
+            break;
+        case 'R': case 'W': case 'A': o.mode = *f; break;
+        default: break;
+        }
+        comma = f;
+        while (comma < end && *comma != ',') comma++;
+    }
+    return o;
+}
+
+static const char *const DIRTYPES[8] = { "DEL", "SEQ", "PRG", "USR", "REL", "???", "???", "???" };
+
+/* 64, 71 or 81 for a name ending in .D64 / .D71 / .D81 (PETSCII or ASCII, either case), else 0 */
+VD_COLD static int image_kind(const char *s)
+{
+    size_t l = strlen(s);
+    if (l < 4) return 0;
+    const uint8_t *e = (const uint8_t *)s + l - 4;
+    if ((e[0] & 0x7F) != '.' || ((e[1] & 0x7F) | 0x20) != 'd') return 0;
+    if (e[2] == '6' && e[3] == '4') return 64;
+    if (e[2] == '7' && e[3] == '1') return 71;
+    if (e[2] == '8' && e[3] == '1') return 81;
+    return 0;
+}
+
+VD_COLD static const char *image_tag(const char *s) { int k = image_kind(s); return k == 71 ? "D71" : k == 81 ? "D81" : "D64"; }
+
+/* ---- aliases for host names the C64 cannot use (see tdrive.h) ---- */
+VD_COLD static int alias_ok(char c)
+{
+    return c >= 0x20 && c <= 0x7a && c != '`' && !strchr("*?,=:\"", c);
+}
+
+VD_COLD int vd_alias(const char *name, char out[17])
+{
+    size_t n = strlen(name), i;
+    int bad = 0;
+    if (!n) { out[0] = 0; return -1; }
+    for (i = 0; i < n; i++) if (!alias_ok(name[i])) bad = 1;
+    if (n <= 16) {
+        for (i = 0; i < n; i++) { char c = name[i]; out[i] = !alias_ok(c) ? '^' : (c >= 'a' && c <= 'z') ? (char)(c - 0x20) : c; }
+        out[n] = 0;
+        return bad;
+    }
+    char m[256];
+    size_t len = n < sizeof m - 1 ? n : sizeof m - 1;
+    for (i = 0; i < len; i++) { char c = name[i]; m[i] = !alias_ok(c) ? '^' : (c >= 'a' && c <= 'z') ? (char)(c - 0x20) : c; }
+    m[len] = 0;
+    size_t stem = len;                                                 /* extension: '.' + 1-3 characters, not the first */
+    const char *dot = strrchr(m, '.');
+    if (dot && dot > m && len - (size_t)(dot - m) - 1 >= 1 && len - (size_t)(dot - m) - 1 <= 3) stem = (size_t)(dot - m);
+    size_t ext = len - stem, budget = 16 - ext;
+    size_t q = stem;
+    while (q > 0 && !strchr(" -_.", m[q - 1])) q--;                   /* start of the last word */
+    size_t tail = stem - q;
+    if (tail < 1 || tail > 5) tail = 3;
+    size_t head = budget - 1 - tail;                                   /* budget >= 12, tail <= 5: head >= 6 */
+    memcpy(out, m, head);
+    out[head] = '^';
+    memcpy(out + head + 1, m + stem - tail, tail);
+    memcpy(out + head + 1 + tail, m + stem, ext);
+    out[16] = 0;
+    return 1;
+}
+
+VD_COLD static void leave_image(tdrive_t *v, int unit, vd_unit_t *u)
+{
+    if (!u->disk) return;
+    close_all(u); u->disk = NULL;
+    if (v->host.unmount) v->host.unmount(v->host.ctx, unit);
+}
+
+/* Is a name with "/" in it a host path? "/" is a legal character in a disk file name ("A/B"), so with an image mounted only a
+ * name that really walks somewhere is a path: a leading "/", a component with an image suffix, or "..". With nothing mounted every "/" is one. */
+VD_COLD static int is_path(const vd_unit_t *u, const char *s)
+{
+    if (!strchr(s, '/')) return 0;
+    if (!u->disk || *s == '/') return 1;
+    for (;;) {
+        size_t n = strcspn(s, "/");
+        char c[VD_CMDBUF];
+        if (n < sizeof c) {
+            memcpy(c, s, n); c[n] = 0;
+            if (image_kind(c) || !strcmp(c, "..")) return 1;
+        }
+        if (!s[n]) return 0;
+        s += n + 1;
+    }
+}
+
+/* Follow "[/]dir/dir/image.d64[/rest]" on the host: a leading "/" starts at the card root, ".." (or the left arrow "_") goes
+ * up, a component with an image suffix is mounted, any other component is a folder. A component with a wildcard is not
+ * entered: it ends the walk as the pattern. *rest points at what is left (the file name after an image, a pattern, or ""
+ * when the path ended on the folder / image). Returns 0 or a DOS error code. Modifies p. */
+VD_COLD static int path_walk(tdrive_t *v, int unit, vd_unit_t *u, char *p, char **rest)
+{
+    const vd_host_t *h = &v->host;
+    int r;
+    *rest = p + strlen(p);
+    if (!h->chdir || !h->mount) return 33;
+    if (*p == '/') { leave_image(v, unit, u); if ((r = h->chdir(h->ctx, unit, "/"))) return r; }
+    while (*p) {
+        char *c = p, *sl = strchr(p, '/');
+        if (sl) { *sl = 0; p = sl + 1; } else p += strlen(p);
+        if (!*c) continue;                                                  /* "//" or a trailing "/" */
+        if (strpbrk(c, "*?")) { if (sl) *sl = '/'; *rest = c; return 0; }
+        if (!strcmp(c, "..") || !strcmp(c, "_")) {
+            if (u->disk) leave_image(v, unit, u);                           /* up from an image = unmount */
+            else if ((r = h->chdir(h->ctx, unit, ".."))) return r;
+        } else if (image_kind(c)) {
+            d64_t *d = NULL;
+            leave_image(v, unit, u);
+            if ((r = h->mount(h->ctx, unit, c, &d))) return r;
+            u->disk = d;
+            *rest = p;
+            return 0;
+        } else {
+            leave_image(v, unit, u);
+            if ((r = h->chdir(h->ctx, unit, c))) return r;
+        }
+    }
+    return 0;
+}
+
+/* One line of the directory per call into d->line; sets d->phase = 3 and llen = 0 when finished. */
+VD_COLD static void dir_gen(tdrive_t *v, int unit, vd_unit_t *u, vd_dirstream_t *d)
+{
+    d64_bas_t b;
+    char name[17], id[3], dos[3];
+    d->lpos = 0; d->llen = 0;
+    while (d->phase != 3) {
+        d64_bas_begin_at(&b, d->line, sizeof d->line, d->off);
+        if (d->phase == 0) {
+            if (d->host) {
+                char title[17];
+                if (v->host.dir_open(v->host.ctx, unit, title)) { d->phase = 3; return; }
+                { char idn[3] = { (char)('0' + v->dev[unit] / 10 % 10), (char)('0' + v->dev[unit] % 10), 0 };   /* shows the device number */
+                  d64_bas_header(&b, title, idn, "2A"); }
+            } else {
+                if (d64_header(u->disk, name, id, dos) || d64_dir_first(u->disk, &d->it)) { read_err(u, 74, 0, 0); d->phase = 3; return; }
+                d64_bas_header(&b, name, id, dos);
+            }
+            d->phase = 1;
+        } else if (d->phase == 1) {
+            int got = 0;
+            for (;;) {
+                if (d->host) {
+                    uint32_t size; int is_dir;
+                    if (v->host.dir_next(v->host.ctx, unit, name, &size, &is_dir) <= 0) break;
+                    if (d->has_pat && !d64_match(name, d->pat)) continue;
+                    uint32_t blocks = is_dir ? 0 : (size + 253) / 254;
+                    d64_bas_entry(&b, (uint16_t)(blocks > 65535 ? 65535 : blocks), name,
+                                  is_dir ? "DIR" : image_kind(name) ? image_tag(name) : "PRG", 1, 0);
+                    got = 1; break;
+                } else {
+                    d64_entry_t e;
+                    int r = d64_dir_next(u->disk, &d->it, &e);
+                    if (r < 0) { read_err(u, 74, 0, 0); d->phase = 3; return; }   /* damaged directory: stop listing */
+                    if (r == 0) break;
+                    if (d->has_pat && !d64_match(e.name, d->pat)) continue;
+                    d64_bas_entry(&b, e.blocks, e.name, DIRTYPES[e.type & 7], (e.type & 0x80) != 0, (e.type & 0x40) != 0);
+                    got = 1; break;
+                }
+            }
+            if (!got) { d->phase = 2; continue; }
+        } else {
+            int fr = d->host ? 0 : d64_blocks_free(u->disk);
+            if (fr < 0) fr = 0;
+            d64_bas_footer(&b, (uint16_t)fr);
+            d64_bas_end(&b);
+            d->phase = 3;
+        }
+        d->llen = (uint8_t)b.len;
+        d->off = (uint16_t)(d->off + b.len);
+        return;
+    }
+}
+
+VD_COLD static void open_dir_pat(tdrive_t *v, int unit, vd_unit_t *u, int ch, const char *pat)
+{
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    vd_dirstream_t *d = &c->u.d;
+    memset(d, 0, sizeof *d);
+    d->host = u->disk == NULL;
+    size_t n = 0;
+    while (pat[n] && n < 16) { d->pat[n] = pat[n]; n++; }
+    d->pat[n] = 0; d->has_pat = n != 0;
+    c->mode = 4;
+    dir_gen(v, unit, u, d);                            /* first line now, so failures report at OPEN time */
+    if (d->llen == 0) { chan_close(u, ch); set_err(u, 74, 0, 0); }
+}
+
+/* A listing by path only shows what is there: the folder / image selected before is restored when its channel closes.
+ * begin_temp remembers it (first closing an earlier listing that is still open), end_temp arms the restore for channel ch. */
+VD_COLD static void begin_temp(tdrive_t *v, int unit, vd_unit_t *u)
+{
+    if (u->restore_ch) chan_close(u, u->restore_ch - 1);
+    v->host.push(v->host.ctx, unit);
+}
+VD_COLD static void end_temp(vd_unit_t *u, int ch)
+{
+    if (chan_find(u, ch)) u->restore_ch = (uint8_t)(ch + 1);     /* restored by that channel's close */
+    else restore_selection(u);                                    /* the listing never opened */
+}
+
+/* "$[n][:]pattern": the directory of the mounted image, or of the current host folder. A pattern with a "/" in it (or, with
+ * nothing mounted, ending in an image suffix) is a path: LOAD"$/GAMES/DEMO.D64" mounts the image and lists it,
+ * LOAD"$GAMES/" lists that folder, LOAD"$GAMES/DEMO.D64/S*" lists the matching files in the image.
+ * "$==path" (also "$:==" / "$0:==") is always a path, even without a "/" or an image suffix: $==GAMES enters the folder GAMES,
+ * $==T a folder called T (a single "=" is a CBM listing modifier, $=T / $=P, and is left alone).
+ * The CMD form puts the path before a colon: "$//GAMES/:*" (from the root), "$/SUB/:A*" (relative); see cmd_path. */
+VD_COLD static void open_dir(tdrive_t *v, int unit, vd_unit_t *u, int ch, const uint8_t *raw, uint8_t len)
+{
+    char spec[VD_CMDBUF];
+    size_t n = 0;
+    uint8_t i = 1, e = 1;
+    while (e < len && raw[e] != ',') e++;
+    int cmdp = cmd_path((const char *)raw + 1, (const char *)raw + e, spec, sizeof spec);   /* "$//GAMES/:*", "$0/SUB/:A*" */
+    if (cmdp < 0) { set_err(u, 33, 0, 0); return; }
+    int force = 0;
+    if (!cmdp) {
+        while (i < len && raw[i] >= '0' && raw[i] <= '9') i++;
+        if (i < len && raw[i] == ':') i++;
+        force = i + 1 < len && raw[i] == '=' && raw[i + 1] == '=';     /* "$==path": always a path (a single "=" is a CBM listing modifier: $=T, $=P) */
+        if (force) i += 2;
+        while (i < e && n < sizeof spec - 1) spec[n++] = (char)raw[i++];
+        spec[n] = 0;
+    }
+    char *pat = spec;
+    if (force || cmdp == 2 || is_path(u, spec) || (!u->disk && !strpbrk(spec, "*?") && image_kind(spec))) {
+        int temp = !force && v->host.push && v->host.pop;
+        if (temp) begin_temp(v, unit, u);
+        int r = path_walk(v, unit, u, spec, &pat);
+        if (r) { set_err(u, (uint8_t)r, 0, 0); if (temp) restore_selection(u); return; }
+        open_dir_pat(v, unit, u, ch, pat);
+        if (temp) end_temp(u, ch);
+        return;
+    }
+    open_dir_pat(v, unit, u, ch, pat);
+}
+/* "!CONFIG" / "!STATE": text files kept by the host (see vd_host_t); the name is PETSCII, upper or shifted. */
+VD_COLD static void open_hostfile(tdrive_t *v, int unit, vd_unit_t *u, int ch, const char *name, char mode)
+{
+    const vd_host_t *h = &v->host;
+    int kind = -1;
+    if (!strcmp(name, "!CONFIG")) kind = VD_HF_CONFIG; else if (!strcmp(name, "!STATE")) kind = VD_HF_STATE;
+    if (kind < 0 || !h->hf_open) { set_err(u, 62, 0, 0); return; }
+    if (mode != 'R' && mode != 'W') { set_err(u, 33, 0, 0); return; }
+    if (mode == 'W' && kind == VD_HF_STATE) { set_err(u, 26, 0, 0); return; }       /* WRITE PROTECT ON */
+    for (int i = 0; i < 16; i++) {                                                  /* the host keeps one file open: this replaces it */
+        vd_chan_t *o = chan_find(u, i);
+        if (o && (o->mode == 6 || o->mode == 7)) chan_close(u, i);
+    }
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    int r = h->hf_open(h->ctx, unit, kind, mode == 'W');
+    if (r) { set_err(u, (uint8_t)r, 0, 0); chan_close(u, ch); return; }
+    c->u.h.kind = (uint8_t)kind; c->u.h.pos = c->u.h.len = 0;
+    c->mode = mode == 'W' ? 7 : 6;
+}
+
+/* OPEN of a REL file: an existing one (e; a record length given must match), or a new one ("NAME,L,"+CHR$(len)). */
+VD_COLD static void rel_open(vd_unit_t *u, int ch, const d64_entry_t *e, const open_spec_t *o)
+{
+    if (e && o->reclen && o->reclen != e->reclen) { set_err(u, 50, 0, 0); return; }
+    if (!e && !o->reclen) { set_err(u, 62, 0, 0); return; }
+    if (!e && o->reclen == 255) { set_err(u, 33, 0, 0); return; }
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    vd_rel_t *l = &c->u.l;
+    int r = e ? d64_rel_open(u->disk, e, &l->f) : d64_rel_create(u->disk, o->name, o->reclen, &l->f);
+    if (r) { err_from(u, r); chan_close(u, ch); return; }
+    l->rec = 0; l->pos = 0; l->rlen = 0; l->wrote = 0; l->over = 0;
+    c->mode = 8;
+}
+
+/* a byte written to a REL channel: the first of a LISTEN session makes the record exist (the file grows to it) */
+VD_COLD static int rel_write(vd_unit_t *u, vd_rel_t *l, uint8_t b)
+{
+    int r = 0;
+    if (l->over == 2) return 0;                           /* the record could not be made: drop the rest of the session */
+    if (!l->wrote) {
+        l->wrote = 1;
+        if (l->rec >= d64_rel_records(&l->f)) r = d64_rel_extend(u->disk, &l->f, (uint32_t)l->rec + 1);
+        if (r) { err_from(u, r); l->over = 2; return r; }
+    }
+    if (l->pos >= l->f.reclen) { if (!l->over) set_err(u, 51, 0, 0); l->over = 1; return 0; }   /* the rest is dropped */
+    r = d64_rel_put(u->disk, &l->f, (uint32_t)l->rec * l->f.reclen + l->pos, b);
+    if (r) { err_from(u, r); return r; }
+    l->pos++;
+    return 0;
+}
+
+/* UNLSN after bytes to a REL channel: the record ends here, zero-filled, and the next one is current */
+VD_COLD static void rel_end_record(vd_unit_t *u, vd_rel_t *l)
+{
+    if (l->rec < d64_rel_records(&l->f)) {
+        for (uint32_t base = (uint32_t)l->rec * l->f.reclen; l->pos < l->f.reclen; l->pos++)
+            if (d64_rel_put(u->disk, &l->f, base + l->pos, 0)) break;
+        int r = d64_rel_flush(u->disk, &l->f);
+        if (r) err_from(u, r);
+        l->rec++;
+    }
+    l->pos = 0; l->rlen = 0; l->wrote = 0; l->over = 0;
+}
+
+VD_COLD static int rel_read(vd_unit_t *u, vd_rel_t *l, uint8_t *b, int *eoi)
+{
+    uint32_t base = (uint32_t)l->rec * l->f.reclen;
+    if (l->rec >= d64_rel_records(&l->f)) { set_err(u, 50, 0, 0); return 0; }
+    if (!l->rlen) {                                       /* a record is sent up to its last non-zero byte (at least one byte) */
+        l->rlen = 1;
+        for (uint8_t i = 0; i < l->f.reclen; i++) {
+            uint8_t x;
+            if (d64_rel_get(u->disk, &l->f, base + i, &x)) { read_err(u, 21, 0, 0); return 0; }
+            if (x) l->rlen = (uint8_t)(i + 1);
+        }
+    }
+    if (d64_rel_get(u->disk, &l->f, base + l->pos, b)) { read_err(u, 21, 0, 0); return 0; }
+    l->pos++;
+    if (l->pos >= l->rlen) { *eoi = 1; l->rec++; l->pos = 0; l->rlen = 0; }
+    return 1;
+}
+
+/* "P"+CHR$(96+ch)+CHR$(lo)+CHR$(hi)+CHR$(pos): position a REL channel at record lo+256*hi, byte pos (both counted from 1; 0 = 1).
+ * Binary bytes, so this runs before the CR strip; bytes after the fifth (PRINT#'s CR) are ignored. */
+VD_COLD static void cmd_position(vd_unit_t *u, const uint8_t *cmd, uint8_t len)
+{
+    vd_chan_t *c = len >= 2 ? chan_find(u, cmd[1] & 0x0F) : NULL;
+    if (len < 2) { set_err(u, 30, 0, 0); return; }
+    if (!c || c->mode != 8) { set_err(u, 70, 0, 0); return; }
+    vd_rel_t *l = &c->u.l;
+    unsigned rec = (len > 2 ? cmd[2] : 0) | (len > 3 ? cmd[3] << 8 : 0), pos = len > 4 ? cmd[4] : 1;
+    if (rec) rec--;
+    if (pos) pos--;
+    l->rec = (uint16_t)rec; l->rlen = 0; l->wrote = 0; l->over = 0;
+    if (pos >= l->f.reclen) { l->pos = 0; set_err(u, 51, 0, 0); return; }
+    l->pos = (uint8_t)pos;
+    if (rec >= d64_rel_records(&l->f)) set_err(u, 50, 0, 0);    /* not there yet: a write makes it */
+}
+
+/* Nothing mounted: a plain file on the card. The exact name, else NAME.PRG; a pattern matches the first file in the folder
+ * listing that is not a folder or an image. */
+VD_COLD static void host_open(tdrive_t *v, int unit, vd_unit_t *u, int ch, const char *name)
+{
+    const vd_host_t *h = &v->host;
+    char nm[22];
+    uint32_t size = 0;
+    int r = 62;
+    for (int i = 0; i < VD_NSLOT; i++) if (u->slot[i].mode == 9) { set_err(u, 70, 0, 0); return; }   /* one at a time */
+    if (strpbrk(name, "*?")) {
+        char e[17]; uint32_t sz; int dir;
+        nm[0] = 0;
+        if (h->dir_open && h->dir_next && !h->dir_open(h->ctx, unit, e))
+            while (h->dir_next(h->ctx, unit, e, &sz, &dir) > 0)
+                if (!dir && !image_kind(e) && d64_match(e, name)) { strcpy(nm, e); break; }
+        if (nm[0]) r = h->plain_open(h->ctx, unit, nm, &size);
+    } else {
+        strcpy(nm, name);
+        r = h->plain_open(h->ctx, unit, nm, &size);
+        if (r == 62 && !strchr(nm, '.')) { strcat(nm, ".PRG"); r = h->plain_open(h->ctx, unit, nm, &size); }
+    }
+    if (r) { set_err(u, (uint8_t)r, 0, 0); return; }
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) { h->plain_close(h->ctx, unit); return; }
+    c->mode = 9; c->u.p.left = size; c->u.p.pos = c->u.p.len = 0;
+}
+
+VD_COLD static void chan_open(tdrive_t *v, int unit, vd_unit_t *u, int ch, const uint8_t *raw, uint8_t len)
+{
+    chan_close(u, ch);
+    if (len && raw[0] == '$' && (u->disk || (v->host.dir_open && v->host.dir_next))) { open_dir(v, unit, u, ch, raw, len); return; }
+    if (len && raw[0] == '#') {                                      /* direct-access buffer: U1/U2/B-P work on it */
+        vd_chan_t *c = chan_alloc(u, ch);
+        if (!c) return;
+        c->mode = 5; c->u.b.pos = 0;
+        memset(c->u.b.buf, 0, sizeof c->u.b.buf);
+        return;
+    }
+    open_spec_t o = parse_open(raw, len);
+    if (!o.has_name) { set_err(u, u->disk ? 33 : 74, 0, 0); return; }
+    char mode = o.mode ? o.mode : (ch == 1 ? 'W' : 'R');
+    if (o.name[0] == '!') { open_hostfile(v, unit, u, ch, o.name, mode); return; }
+    if (mode != 'R' && mode != 'W' && mode != 'A') { set_err(u, 33, 0, 0); return; }
+    /* "DIR/IMAGE.D64/FILE" (or a bare "IMAGE.D64" read with nothing mounted): walk there first, the file name is what is left.
+     * "DIR/FILE.PRG", no image on the way: the folders are walked and FILE.PRG is a plain file on the card. */
+    if (o.cmdpath || is_path(u, o.name) || (mode == 'R' && !u->disk && image_kind(o.name))) {
+        char *rest, *leaf = strrchr(o.name, '/'), save = 0;
+        int temp = mode == 'R' && v->host.push && v->host.pop, plain = 0;
+        if (mode == 'R' && leaf && leaf[1] && !image_kind(leaf + 1) && v->host.plain_open) {
+            plain = 1;
+            for (char *q = o.name; q < leaf; ) {                                  /* an image on the way: the leaf is a file in it */
+                char *sl = strchr(q, '/');
+                save = *sl; *sl = 0;
+                if (image_kind(q)) plain = 0;
+                *sl = save; q = sl + 1;
+            }
+        }
+        if (temp) begin_temp(v, unit, u);
+        if (plain) { save = leaf[1]; leaf[1] = 0; }                               /* walk "DIR/" only */
+        int r = path_walk(v, unit, u, o.name, &rest);
+        if (plain) { leaf[1] = save; rest = leaf + 1; }
+        if (r) { set_err(u, (uint8_t)r, 0, 0); if (temp) restore_selection(u); return; }
+        if (!*rest) {                                                         /* it named a folder / image: show what is in it, nothing stays selected */
+            open_dir_pat(v, unit, u, ch, "");
+            if (temp) end_temp(u, ch);
+            return;
+        }
+        memmove(o.name, rest, strlen(rest) + 1);                              /* a file through a path: the folder / image stay selected for the program */
+        if (temp) v->host.pop(v->host.ctx, unit, NULL);                       /* (out == NULL: keep the selection, drop the snapshot) */
+    }
+    if (strlen(o.name) > 16) { set_err(u, 33, 0, 0); return; }
+    if (!u->disk && mode == 'R' && v->host.plain_open && v->host.plain_read) { host_open(v, unit, u, ch, o.name); return; }
+    if (!u->disk) { set_err(u, 74, 0, 0); return; }
+    if (o.type == 4 || mode == 'R') {                                         /* a REL file opens for reading and writing alike */
+        d64_entry_t e;
+        int r = d64_find(u->disk, o.name, &e);
+        if (r < 0) { err_from(u, r); return; }
+        if (r ? (e.type & 7) == 4 : o.type == 4) { rel_open(u, ch, r ? &e : NULL, &o); return; }
+        if (r && o.type == 4) { set_err(u, 64, 0, 0); return; }
+    }
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    if (mode == 'R') {
+        d64_entry_t e;
+        int r = d64_find(u->disk, o.name, &e);
+        if (r < 0) { err_from(u, r); chan_close(u, ch); return; }
+        if (r == 0) { set_err(u, 62, 0, 0); chan_close(u, ch); return; }
+        d64_file_open(u->disk, &e, &c->u.r);
+        c->mode = 1;
+    } else if (mode == 'A') {                                                  /* ",A": more data at the end of an existing file */
+        int r = d64_append(u->disk, o.name, &c->u.w);
+        if (r) { err_from(u, r); chan_close(u, ch); return; }
+        c->mode = 3;
+    } else {
+        uint8_t type = o.type ? o.type : (ch == 1 ? 2 : 1);
+        int r = d64_create(u->disk, o.name, type, o.replace, &c->u.w);
+        if (r) { err_from(u, r); chan_close(u, ch); return; }
+        c->mode = 3;
+    }
+}
+
+/* ---- command channel ---------------------------------------------------- */
+/* CD[n]:path -- same path syntax as a LOAD name (see path_walk): CD:/GAMES/DEMO.D64, CD:.., CD:_ (left arrow), CD:/ (root).
+ * The CMD forms (as on a CMD HD and sd2iec): CD/FOO and CD/FOO/BAR (relative), CD//FOO (from the root), CD/FOO/:BAR,
+ * CD//FOO/:BAR, CD0//FOO; a single "/" right after CD (or the drive number) is the current folder, "//" the root. */
+VD_COLD static void cmd_cd(tdrive_t *v, int unit, vd_unit_t *u, const char *p, const char *end)
+{
+    char path[VD_CMDBUF];
+    const char *q = p;
+    while (q < end && *q >= '0' && *q <= '9') q++;
+    int k = cmd_path(p, end, path, sizeof path);
+    if (k < 0) { set_err(u, 33, 0, 0); return; }
+    if (!k) {
+        if (q < end && *q == ':') p = q + 1;                     /* "CD:" and "CD0:" */
+        else if (q < end && *q == '/') p = q + 1;                /* CMD "CD/FOO", "CD//FOO" without a colon: drop the first "/" */
+        size_t n = (size_t)(end - p);
+        if (n >= sizeof path) { set_err(u, 33, 0, 0); return; }
+        memcpy(path, p, n); path[n] = 0;
+    }
+    if (!path[0]) return;
+    char *rest;
+    int r = path_walk(v, unit, u, path, &rest);
+    if (r) set_err(u, (uint8_t)r, 0, 0);
+    else if (*rest) set_err(u, 33, 0, 0);                        /* something after the image / a wildcard: not a directory */
+}
+
+/* "N:[path/]NAME.D64[,ID]" (.D71, .D81) with nothing mounted: a new blank image in the current folder (or the folder the path
+ * names), mounted at once and formatted with the disk name NAME and the ID ("00" when none is given). An existing file is never
+ * replaced (63). */
+VD_COLD static void cmd_new_image(tdrive_t *v, int unit, vd_unit_t *u, const char *p, const char *end)
+{
+    char path[VD_CMDBUF], id[3] = { '0', '0', 0 };
+    if (p < end && *p == ':') p++;
+    const char *comma = p;
+    while (comma < end && *comma != ',') comma++;
+    size_t n = (size_t)(comma - p);
+    if (comma < end) {
+        if (end - comma - 1 != 2) { set_err(u, 33, 0, 0); return; }
+        id[0] = comma[1]; id[1] = comma[2];
+    }
+    if (n < 5 || n >= sizeof path) { set_err(u, 33, 0, 0); return; }
+    memcpy(path, p, n); path[n] = 0;
+    char *leaf = strrchr(path, '/');
+    int kind = image_kind(path);
+    if (!kind || strpbrk(path, "*?")) { set_err(u, 33, 0, 0); return; }
+    if (leaf) {                                                   /* the folders first, then the new file in the last one */
+        char *rest, root[2] = { '/', 0 };
+        *leaf++ = 0;
+        int r = path_walk(v, unit, u, path[0] ? path : root, &rest);   /* "N:/NEW.D64": the card's root */
+        if (!r && (*rest || u->disk)) r = 33;                     /* the path went into an image or ended on a pattern */
+        if (r) { set_err(u, (uint8_t)r, 0, 0); return; }
+    } else leaf = path;
+    size_t ln = strlen(leaf) - 4;                                 /* the disk name: the file name without .D64 */
+    if (ln < 1 || ln > 16) { set_err(u, 33, 0, 0); return; }
+    char name[17];
+    memcpy(name, leaf, ln); name[ln] = 0;
+    d64_t *d = NULL;
+    uint32_t size = kind == 81 ? 819200u : kind == 71 ? 349696u : 174848u;
+    int r = v->host.create(v->host.ctx, unit, leaf, size, &d);
+    if (r) { set_err(u, (uint8_t)r, 0, 0); return; }
+    u->disk = d;
+    if ((r = d64_format_blank(d, name, id))) err_from(u, r);
+}
+
+/* CMD "MD[n]:NAME" / "RD[n]:NAME": a folder on the card, with nothing mounted. With an image mounted they would be D81 partition /
+ * sub-directory commands, which are not supported (31). A CMD path picks the folder it goes in: "MD/GAMES/:NEW" (relative),
+ * "MD//GAMES/:NEW" (from the root), also without the colon ("MD/GAMES/NEW": the name after the last "/"); the selected folder
+ * stays as it was (host push / pop; without them the path stays selected). */
+VD_COLD static void cmd_folder(tdrive_t *v, int unit, vd_unit_t *u, int make, const char *p, const char *end)
+{
+    const vd_host_t *h = &v->host;
+    char name[17], path[VD_CMDBUF];
+    if (u->disk || !(make ? h->mkdir : h->rmdir)) { set_err(u, 31, 0, 0); return; }
+    while (p < end && *p >= '0' && *p <= '9') p++;
+    path[0] = 0;
+    if (p < end && *p == '/') {
+        const char *c = p, *nm;
+        while (c < end && *c != ':') c++;
+        if (c < end) nm = c + 1;
+        else { while (c[-1] != '/') c--; nm = c; }                /* no colon: the name follows the last "/" */
+        size_t pn = (size_t)(c - p - 1);                          /* the first "/" dropped: "//A/" -> "/A/", "/A/" -> "A/" */
+        if (pn >= sizeof path) { set_err(u, 33, 0, 0); return; }
+        memcpy(path, p + 1, pn); path[pn] = 0;
+        p = nm;
+    } else if (p < end && *p == ':') p++;
+    size_t n = (size_t)(end - p);
+    if (n < 1 || n > 16) { set_err(u, 34, 0, 0); return; }
+    memcpy(name, p, n); name[n] = 0;
+    if (strpbrk(name, "/*?:=,\"") || !strcmp(name, "..") || !strcmp(name, ".") || !strcmp(name, "_")) { set_err(u, 33, 0, 0); return; }
+    int r = 0, temp = path[0] && h->push && h->pop;
+    if (temp) h->push(h->ctx, unit);
+    if (path[0]) {
+        char *rest;
+        r = path_walk(v, unit, u, path, &rest);
+        if (!r && (*rest || u->disk)) r = 33;                     /* the path went into an image or ended on a pattern */
+    }
+    if (!r) r = make ? h->mkdir(h->ctx, unit, name) : h->rmdir(h->ctx, unit, name);
+    if (temp) { d64_t *d = NULL; h->pop(h->ctx, unit, &d); u->disk = d; }
+    if (r) set_err(u, (uint8_t)r, 0, 0);
+}
+
+/* "S:[path/]NAME.D64[,NAME2.D81...]" (.D71, .D81) with nothing mounted: delete image files on the card. Exact names only (a
+ * wildcard is 33, anything but an image name 64), a file with the card's read-only attribute set stays (26). A path picks the
+ * folder ("S:GAMES/OLD.D64", "S:/OLD.D64", CMD "S//GAMES/:OLD.D64"); the selected folder stays as it was (host push / pop).
+ * Answers 01,FILES SCRATCHED,nn like a scratch on a disk: a name that is not there counts 0. */
+VD_COLD static void cmd_scratch_images(tdrive_t *v, int unit, vd_unit_t *u, const char *p, const char *end)
+{
+    const vd_host_t *h = &v->host;
+    if (p < end && *p == ':') p++;
+    if (p >= end) { set_err(u, 34, 0, 0); return; }
+    int total = 0;
+    while (p < end) {
+        const char *q = p;
+        while (q < end && *q != ',') q++;
+        char path[VD_CMDBUF];
+        size_t n = (size_t)(q - p);
+        if (n >= sizeof path) { set_err(u, 33, 0, 0); return; }
+        memcpy(path, p, n); path[n] = 0;
+        if (strpbrk(path, "*?")) { set_err(u, 33, 0, 0); return; }
+        if (!image_kind(path) || n < 5 || path[n - 5] == '/') { set_err(u, 64, 0, 0); return; }
+        char *leaf = strrchr(path, '/');
+        int r = 0, temp = leaf && h->push && h->pop;
+        if (temp) h->push(h->ctx, unit);
+        if (leaf) {
+            char *rest, root[2] = { '/', 0 };
+            *leaf++ = 0;
+            r = path_walk(v, unit, u, path[0] ? path : root, &rest);
+            if (!r && (*rest || u->disk)) r = 33;                 /* the path went into an image or ended on a pattern */
+        } else leaf = path;
+        if (!r) { r = h->scratch(h->ctx, unit, leaf); if (!r) total++; else if (r == 62) r = 0; }
+        if (temp) { d64_t *d = NULL; h->pop(h->ctx, unit, &d); u->disk = d; }
+        if (r) { set_err(u, (uint8_t)r, 0, 0); return; }
+        p = q + 1;
+    }
+    set_err(u, 1, (uint8_t)total, 0);
+}
+
+/* UI / UJ / U9: reset the drive. Closes every channel, keeps the mounted image, answers the "73" power-on message. */
+VD_COLD static void cmd_reset(vd_unit_t *u)
+{
+    close_all(u);
+    set_err(u, 73, 0, 0);
+}
+
+/* Device numbers: a unit uses its pinned number, or else the default / next free one until the start-up scan moves it. */
+VD_COLD static void settle(tdrive_t *v)
+{
+    for (int i = 0; i < 2; i++) {
+        uint8_t n = v->pin[i];
+        if (!n) {
+            n = i ? VD_DEV1 : VD_DEV0;
+            while (n <= 30 && (n == v->pin[0] || n == v->pin[1] || (i == 1 && n == v->dev[0]))) n++;
+            if (n > 30) n = 0;
+        }
+        v->dev[i] = n;
+    }
+}
+
+/* "U0>"+CHR$(n): this drive answers as device n from now on (n = 0: automatic again). Persisted via the host. */
+VD_COLD static void cmd_renumber(tdrive_t *v, int unit, vd_unit_t *u, uint8_t n)
+{
+    if (n && (n < 8 || n > 30 || n == v->dev[1 - unit])) { set_err(u, 33, 0, 0); return; }
+    v->pin[unit] = n;
+    settle(v);
+    if (v->host.save_devices) v->host.save_devices(v->host.ctx, v->pin[0], v->pin[1]);
+}
+
+/* Up to max decimal numbers from p (any non-digit separates them: "5,0,18,0", " 5 0 18 0", ":5;0;18;0"); returns how many. */
+VD_COLD static int parse_nums(const char *p, const char *end, int *v, int max)
+{
+    int n = 0;
+    while (p < end && n < max) {
+        if (*p < '0' || *p > '9') { p++; continue; }
+        int x = 0;
+        while (p < end && *p >= '0' && *p <= '9') { x = x * 10 + (*p - '0'); if (x > 999) x = 999; p++; }
+        v[n++] = x;
+    }
+    return n;
+}
+
+/* U1/UA (B-R) and U2/UB (B-W): "U1:ch drive track sector" copies a whole sector to / from the buffer channel `ch`.
+ * B-R / B-W are the same here: the sector is transferred whole and the buffer pointer starts at 0. */
+VD_COLD static void cmd_block_io(vd_unit_t *u, const char *p, const char *end, int write)
+{
+    int a[4];
+    if (parse_nums(p, end, a, 4) != 4) { set_err(u, 30, 0, 0); return; }
+    if (a[0] > 14) { set_err(u, 70, 0, 0); return; }                  /* parse_nums gives no negatives; 15 is the command channel */
+    vd_chan_t *c = chan_find(u, a[0]);
+    if (!c || c->mode != 5) { set_err(u, 70, 0, 0); return; }
+    if (a[2] > 255 || a[3] > 255 || d64_sector_offset(u->disk, (uint8_t)a[2], (uint8_t)a[3]) < 0) { set_err(u, 66, (uint8_t)a[2], (uint8_t)a[3]); return; }
+    uint8_t t = (uint8_t)a[2], s = (uint8_t)a[3];
+    if (write) {
+        int r = d64_block_write(u->disk, t, s, c->u.b.buf);
+        if (r == D64_E_RO) set_err(u, 26, t, s);
+        else if (r) set_err(u, 25, t, s);
+    } else {
+        if (d64_block_read(u->disk, t, s, c->u.b.buf)) read_err(u, 21, t, s);   /* a bad sector's data is still in the buffer */
+        c->u.b.pos = 0;
+    }
+}
+
+/* B-P:ch,pos moves the buffer pointer; B-A / B-F:drive,track,sector allocate / free a sector in the BAM. */
+VD_COLD static void cmd_buffer(vd_unit_t *u, char op, const char *p, const char *end)
+{
+    int a[3];
+    if (op == 'P') {
+        if (parse_nums(p, end, a, 2) != 2) { set_err(u, 30, 0, 0); return; }
+        vd_chan_t *c = a[0] <= 14 ? chan_find(u, a[0]) : NULL;
+        if (!c || c->mode != 5) { set_err(u, 70, 0, 0); return; }
+        c->u.b.pos = (uint16_t)(a[1] & 0xFF);
+        return;
+    }
+    if (parse_nums(p, end, a, 3) != 3) { set_err(u, 30, 0, 0); return; }
+    if (a[1] > 255 || a[2] > 255) { set_err(u, 66, (uint8_t)a[1], (uint8_t)a[2]); return; }
+    uint8_t t = (uint8_t)a[1], s = (uint8_t)a[2], nt = 0, ns = 0;
+    int r = op == 'A' ? d64_block_alloc(u->disk, t, s, &nt, &ns) : d64_block_free(u->disk, t, s);
+    if (r == D64_E_IO) set_err(u, 66, t, s);
+    else if (r == D64_E_EXISTS) set_err(u, 65, nt, ns);
+    else if (r) err_from(u, r);
+}
+
+/* C[d]:new=[d:]old[,[d:]old...]: copy one file, or join several into a new one (types after a comma are not part of a name).
+ * Duplicating a whole disk ("C1=0", dual drives only) is not a thing here: 31. */
+#define VD_COPYMAX 8
+
+/* "C:A=A,B,...": append the other sources to A, as a 1541 does it (BASIC 7's CONCAT sends exactly that; d64_copy, the shared engine's,
+ * answers 63 for an existing new name, as a 1541 does when the new name is not the first source). Every source must exist first,
+ * none may be A again or a REL file. A disk full puts A back as it was (d64_write). */
+VD_COLD static int concat_into(d64_t *d, const char *name, const char *const *src, int nsrc)
+{
+    d64_entry_t e;
+    d64_wfile_t w;
+    d64_file_t f;
+    uint8_t chunk[64];
+    int r;
+    if ((r = d64_find(d, name, &e)) <= 0) return r ? r : D64_E_NOTFOUND;
+    if ((e.type & 7) == 4) return D64_E_TYPE;
+    for (int i = 0; i < nsrc; i++) {
+        if (strcmp(src[i], name) == 0) return D64_E_EXISTS;
+        if ((r = d64_find(d, src[i], &e)) <= 0) return r ? r : D64_E_NOTFOUND;
+        if ((e.type & 7) == 4) return D64_E_TYPE;
+    }
+    if ((r = d64_append(d, name, &w))) return r;
+    for (int i = 0; i < nsrc; i++) {
+        if ((r = d64_find(d, src[i], &e)) <= 0) { d64_close_write(d, &w); return r ? r : D64_E_NOTFOUND; }
+        d64_file_open(d, &e, &f);
+        while ((r = d64_file_read(d, &f, chunk, sizeof chunk)) > 0)
+            if ((r = d64_write(d, &w, chunk, (size_t)r)) < 0) return r;      /* A is back as it was */
+        if (r < 0) { d64_close_write(d, &w); return r; }
+    }
+    return d64_close_write(d, &w);
+}
+VD_COLD static void cmd_copy(vd_unit_t *u, const char *p, const char *end)
+{
+    if (p >= end || *p != ':') { set_err(u, 31, 0, 0); return; }
+    p++;
+    const char *eq = p;
+    while (eq < end && *eq != '=') eq++;
+    char names[VD_COPYMAX + 1][17];
+    const char *src[VD_COPYMAX];
+    size_t n = (size_t)(eq - p);
+    if (eq == end || n < 1 || n > 16) { set_err(u, 34, 0, 0); return; }
+    memcpy(names[0], p, n); names[0][n] = 0;
+    int ns = 0;
+    for (p = eq + 1; p <= end; ns++) {
+        const char *q = p;
+        while (q < end && *q != ',') q++;
+        p = strip_prefix(p, q);
+        n = (size_t)(q - p);
+        if (ns == VD_COPYMAX || n < 1 || n > 16) { set_err(u, ns == VD_COPYMAX ? 33 : 34, 0, 0); return; }
+        memcpy(names[ns + 1], p, n); names[ns + 1][n] = 0;
+        src[ns] = names[ns + 1];
+        p = q + 1;
+    }
+    int r = ns > 1 && strcmp(names[0], src[0]) == 0 ? concat_into(u->disk, names[0], src + 1, ns - 1) : d64_copy(u->disk, names[0], src, ns);
+    if (r) err_from(u, r);
+}
+
+VD_COLD static void exec_command(tdrive_t *v, int unit, vd_unit_t *u, uint8_t *cmd, uint8_t len)
+{
+    /* OPEN 15,d,15,"U0>"+CHR$(n) sends 4 bytes; PRINT#15 adds a CR, making 5 */
+    if ((len == 4 || (len == 5 && cmd[4] == '\r')) && cmd[0] == 'U' && cmd[1] == '0' && cmd[2] == '>') { cmd_renumber(v, unit, u, cmd[3]); return; }
+    if (len && cmd[0] == 'P') { if (u->disk) cmd_position(u, cmd, len); else set_err(u, 74, 0, 0); return; }
+    while (len && (cmd[len - 1] == '\r' || cmd[len - 1] == '\n')) len--;
+    if (!len) return;
+    cmd[len] = 0;
+    if (len >= 2 && cmd[0] == 'C' && cmd[1] == 'D') { cmd_cd(v, unit, u, (const char *)cmd + 2, (const char *)cmd + len); return; }
+    if (len >= 2 && (cmd[0] == 'M' || cmd[0] == 'R') && cmd[1] == 'D') { cmd_folder(v, unit, u, cmd[0] == 'M', (const char *)cmd + 2, (const char *)cmd + len); return; }
+    if (cmd[0] == 'U' && len == 2 && (cmd[1] == 'I' || cmd[1] == 'J' || cmd[1] == '9')) { cmd_reset(u); return; }
+    if (cmd[0] == 'U' && len == 3 && cmd[1] == 'I' && (cmd[2] == '+' || cmd[2] == '-')) return;   /* VIC-20 / C64 bus speed: nothing to do */
+    if (!u->disk && cmd[0] == 'N' && v->host.create) {
+        const char *q = (const char *)cmd + 1;
+        while (*q >= '0' && *q <= '9') q++;                       /* "N0:" */
+        char np[VD_CMDBUF];
+        int k = cmd_path(q, (const char *)cmd + len, np, sizeof np);   /* CMD "N//SUB/:NEW.D64,ID": "/SUB/NEW.D64,ID" */
+        if (k < 0) { set_err(u, 33, 0, 0); return; }
+        if (k) cmd_new_image(v, unit, u, np, np + strlen(np));
+        else cmd_new_image(v, unit, u, q, (const char *)cmd + len);
+        return;
+    }
+    if (!u->disk && cmd[0] == 'S' && v->host.scratch) {
+        const char *q = (const char *)cmd + 1;
+        while (*q >= '0' && *q <= '9') q++;                       /* "S0:" */
+        char sp[VD_CMDBUF];
+        int k = cmd_path(q, (const char *)cmd + len, sp, sizeof sp);   /* CMD "S//GAMES/:OLD.D64": "/GAMES/OLD.D64" */
+        if (k < 0) { set_err(u, 33, 0, 0); return; }
+        if (k) cmd_scratch_images(v, unit, u, sp, sp + strlen(sp));
+        else cmd_scratch_images(v, unit, u, q, (const char *)cmd + len);
+        return;
+    }
+    if (!u->disk) { set_err(u, 74, 0, 0); return; }
+    if (cmd[0] == 'U' && len >= 2 && (cmd[1] == '1' || cmd[1] == 'A' || cmd[1] == '2' || cmd[1] == 'B')) {
+        cmd_block_io(u, (const char *)cmd + 2, (const char *)cmd + len, cmd[1] == '2' || cmd[1] == 'B'); return;
+    }
+    if (cmd[0] == 'B' && len >= 3 && cmd[1] == '-') {
+        const char *q = (const char *)cmd + 3, *e = (const char *)cmd + len;
+        switch (cmd[2]) {
+        case 'R': case 'W': cmd_block_io(u, q, e, cmd[2] == 'W'); return;
+        case 'P': case 'A': case 'F': cmd_buffer(u, (char)cmd[2], q, e); return;
+        default: set_err(u, 31, 0, 0); return;
+        }
+    }
+    if (cmd[0] == 'W' && len == 3 && cmd[1] == '-' && (cmd[2] == '0' || cmd[2] == '1')) {   /* CMD "W-1" / "W-0": write protect on / off */
+        if (cmd[2] == '1') u->disk->ro = 1;
+        else if (u->disk->write) u->disk->ro = 0;
+        else set_err(u, 26, 0, 0);                      /* a read-only image stays read-only */
+        return;
+    }
+    const char *p = (const char *)cmd + 1, *end = (const char *)cmd + len;
+    while (p < end && *p >= '0' && *p <= '9') p++;       /* optional drive number */
+    switch (cmd[0]) {
+    case 'S': {
+        if (p < end && *p == ':') p++;
+        int total = 0;
+        while (p <= end) {
+            const char *q = p;
+            while (q < end && *q != ',') q++;
+            p = strip_prefix(p, q);                         /* "S0:A,0:B": a drive prefix on every name, as a 1541 takes it */
+            char pat[18]; size_t n = (size_t)(q - p);
+            if (n && n <= 16) {
+                memcpy(pat, p, n); pat[n] = 0;
+                int r = d64_scratch(u->disk, pat);
+                if (r < 0) { err_from(u, r); return; }
+                total += r;
+            }
+            p = q + 1;
+        }
+        set_err(u, 1, (uint8_t)total, 0);
+        break; }
+    case 'N': {
+        if (p < end && *p == ':') p++;
+        const char *comma = p;
+        while (comma < end && *comma != ',') comma++;
+        char name[17], id[3];
+        size_t n = (size_t)(comma - p);
+        if (n < 1 || n > 16) { set_err(u, 33, 0, 0); break; }
+        memcpy(name, p, n); name[n] = 0;
+        int r;
+        if (comma < end && end - comma - 1 == 2) { id[0] = comma[1]; id[1] = comma[2]; id[2] = 0; r = d64_format(u->disk, name, id); }
+        else if (comma == end) r = d64_format(u->disk, name, NULL);
+        else { set_err(u, 33, 0, 0); break; }
+        if (r) err_from(u, r);
+        break; }
+    case 'R': {
+        if (p < end && *p == ':') p++;
+        const char *eq = p;
+        while (eq < end && *eq != '=') eq++;
+        char nn[17], on[17];
+        const char *o = eq < end ? strip_prefix(eq + 1, end) : end;   /* "R0:NEW=0:OLD" (the 1541 manual's form; BASIC 7's RENAME) */
+        size_t a = (size_t)(eq - p), b = (size_t)(end - o);
+        if (eq == end || a < 1 || a > 16 || b < 1 || b > 16) { set_err(u, 34, 0, 0); break; }
+        memcpy(nn, p, a); nn[a] = 0; memcpy(on, o, b); on[b] = 0;
+        int r = d64_rename(u->disk, on, nn);
+        if (r) err_from(u, r);
+        break; }
+    case 'C':
+        cmd_copy(u, p, end);
+        break;
+    case 'L': {                                        /* CMD "L:pattern": toggle the lock flag ("<" in the listing; locked files cannot be scratched) */
+        if (p < end && *p == ':') p++;
+        size_t n = (size_t)(end - p);
+        char pat[17];
+        if (n < 1 || n > 16) { set_err(u, 34, 0, 0); break; }
+        memcpy(pat, p, n); pat[n] = 0;
+        int r = d64_lock(u->disk, pat, -1);
+        if (r < 0) err_from(u, r);
+        else if (r == 0) set_err(u, 62, 0, 0);
+        break; }
+    case 'V': {                                        /* validate: the BAM rebuilt from the files, unclosed files dropped */
+        int r = d64_validate(u->disk);
+        if (r < 0) err_from(u, r);
+        break; }
+    case 'I':                                          /* initialize: nothing to do */
+        break;
+    default:
+        set_err(u, 31, 0, 0);
+    }
+}
+
+/* ---- public ------------------------------------------------------------- */
+VD_COLD void tdrive_init(tdrive_t *v)
+{
+    memset(v, 0, sizeof *v);
+    v->act = -1;
+    for (int i = 0; i < 2; i++) { v->unit[i].owner = v; v->unit[i].index = (uint8_t)i; }
+    settle(v);
+}
+
+VD_COLD void tdrive_attach(tdrive_t *v, int unit, d64_t *disk, int present)
+{
+    vd_unit_t *u = &v->unit[unit];
+    close_all(u);
+    u->disk = disk; u->present = (uint8_t)present;
+    set_err(u, 0, 0, 0);
+}
+
+VD_COLD void tdrive_close_unit(tdrive_t *v, int unit) { close_all(&v->unit[unit]); }
+
+VD_COLD void tdrive_set_devices(tdrive_t *v, uint8_t pin0, uint8_t pin1)
+{
+    if (pin0 < 8 || pin0 > 30) pin0 = 0;                /* 0 (unset) or garbage: automatic */
+    if (pin1 < 8 || pin1 > 30 || pin1 == pin0) pin1 = 0;
+    v->pin[0] = pin0; v->pin[1] = pin1;
+    settle(v);
+}
+
+VD_COLD int tdrive_scan_begin(tdrive_t *v)
+{
+    int need = 0;
+    for (int i = 0; i < 2; i++)
+        if (!v->pin[i]) { v->dev[i] = 0; need += v->unit[i].present != 0; }
+    return need;
+}
+
+VD_COLD int tdrive_scan_free(tdrive_t *v, uint8_t dev)
+{
+    int left = 0;
+    if (dev >= 8 && dev <= 30 && dev != v->pin[0] && dev != v->pin[1] && dev != v->dev[0] && dev != v->dev[1])
+        for (int i = 0; i < 2; i++)
+            if (!v->pin[i] && v->unit[i].present && !v->dev[i]) { v->dev[i] = dev; break; }
+    for (int i = 0; i < 2; i++) left += !v->pin[i] && v->unit[i].present && !v->dev[i];
+    return left;
+}
+
+VD_COLD int tdrive_unit_for(const tdrive_t *v, uint8_t dev) { return dev && dev == v->dev[0] ? 0 : dev && dev == v->dev[1] ? 1 : -1; }
+VD_COLD void tdrive_set_host(tdrive_t *v, const vd_host_t *host) { v->host = *host; }
+VD_COLD int tdrive_chan_mode(const tdrive_t *v, int unit, int ch)
+{
+    uint8_t i = v->unit[unit].slot_of[ch];
+    return i ? v->unit[unit].slot[i - 1].mode : 0;
+}
+VD_COLD int tdrive_pending_err(const tdrive_t *v, int unit) { return v->unit[unit].err; }
+VD_COLD int tdrive_active(const tdrive_t *v) { return v->act; }
+VD_COLD size_t tdrive_sizeof(void) { return sizeof(tdrive_t); }
+
+VD_COLD static int read_byte(tdrive_t *v, int unit, vd_unit_t *u, vd_chan_t *c, uint8_t *b, int *eoi)
+{
+    if (c->mode == 1) {
+        int n = d64_file_read(u->disk, &c->u.r, b, 1);
+        if (n < 0) read_err(u, 74, 0, 0);
+        if (n <= 0) return 0;
+        *eoi = d64_file_eof(&c->u.r);
+        return 1;
+    }
+    if (c->mode == 6) {                                              /* host text file: refill a chunk when it runs out; EOI on the very last byte */
+        const vd_host_t *h = &v->host;
+        if (c->u.h.pos >= c->u.h.len) {
+            int n = h->hf_read ? h->hf_read(h->ctx, unit, c->u.h.buf, VD_HFBUF) : 0;
+            c->u.h.pos = 0; c->u.h.len = (uint8_t)(n > 0 ? n : 0);
+            if (c->u.h.len == 0) return 0;
+        }
+        *b = c->u.h.buf[c->u.h.pos++];
+        if (c->u.h.pos >= c->u.h.len) {
+            int n = h->hf_read ? h->hf_read(h->ctx, unit, c->u.h.buf, VD_HFBUF) : 0;
+            c->u.h.pos = 0; c->u.h.len = (uint8_t)(n > 0 ? n : 0);
+            *eoi = c->u.h.len == 0;
+        }
+        return 1;
+    }
+    if (c->mode == 8) return rel_read(u, &c->u.l, b, eoi);
+    if (c->mode == 9) {
+        vd_plain_t *f = &c->u.p;
+        if (f->pos >= f->len) {
+            if (!f->left) return 0;
+            int n = v->host.plain_read(v->host.ctx, unit, f->buf, (uint16_t)(f->left < D64_SECTOR ? f->left : D64_SECTOR));
+            if (n <= 0) { set_err(u, 21, 0, 0); f->left = 0; return 0; }
+            f->len = (uint16_t)n; f->pos = 0; f->left -= (uint32_t)n;
+        }
+        *b = f->buf[f->pos++];
+        *eoi = f->pos >= f->len && !f->left;
+        return 1;
+    }
+    if (c->mode == 5) {
+        if (c->u.b.pos >= D64_SECTOR) return 0;
+        *b = c->u.b.buf[c->u.b.pos++];
+        *eoi = c->u.b.pos >= D64_SECTOR;
+        return 1;
+    }
+    if (c->mode == 4) {
+        vd_dirstream_t *d = &c->u.d;
+        if (d->lpos >= d->llen) dir_gen(v, unit, u, d);
+        if (d->lpos >= d->llen) return 0;
+        *b = d->line[d->lpos++];
+        *eoi = d->lpos >= d->llen && d->phase == 3;
+        return 1;
+    }
+    return 0;
+}
+
+VD_COLD int tdrive_mailbox(tdrive_t *v, uint8_t cmd, uint8_t arg, uint8_t *data, uint8_t *st)
+{
+    *data = 0; *st = 0;
+    if (cmd == VD_LISTEN || cmd == VD_TALK) {
+        v->talking = (cmd == VD_TALK);
+        v->wlen = 0;
+        int unit = tdrive_unit_for(v, arg);
+        if (unit >= 0) {
+            v->act = (int8_t)unit;
+            if (v->unit[unit].disk) v->unit[unit].disk->bad = 0;   /* a bad sector some earlier step read and did not report */
+            if (!v->unit[v->act].present) { v->act = 2; *st = ST_NODEV; }
+            return 0;
+        }
+        v->act = -1;
+        return 1;
+    }
+    if (v->act < 0) return 1;                          /* not our transaction */
+    if (v->act == 2) return 0;                         /* absent device: swallow quietly */
+    vd_unit_t *u = &v->unit[v->act];
+    int ch = v->sa & 0xF, op = v->sa & 0xF0;
+
+    switch (cmd) {
+    case VD_SECOND: case VD_TKSA:
+        v->sa = arg; v->wlen = 0;
+        if (cmd == VD_TKSA && (arg & 0xF) == 15 && u->stat_pos >= u->stat_len) status_text(u);
+        return 0;
+    case VD_CIOUT:
+        if (op == 0x60 && ch != 15) {
+            vd_chan_t *c = chan_find(u, ch);
+            if (c && c->mode == 3) {
+                int r = d64_write(u->disk, &c->u.w, &arg, 1);
+                if (r < 0) { err_from(u, r); c->mode = 0; chan_close(u, ch); *st = ST_TIMEOUT; }   /* write already aborted: just release the slot */
+            }
+            else if (c && c->mode == 7) {
+                c->u.h.buf[c->u.h.pos++] = arg;
+                if (c->u.h.pos >= VD_HFBUF) {
+                    const vd_host_t *h = &v->host;
+                    if (h->hf_write && h->hf_write(h->ctx, v->act, c->u.h.buf, c->u.h.pos)) set_err(u, 74, 0, 0);
+                    c->u.h.pos = 0;
+                }
+            }
+            else if (c && c->mode == 5 && c->u.b.pos < D64_SECTOR) c->u.b.buf[c->u.b.pos++] = arg;     /* buffer: full buffer ignores the rest */
+            else if (c && c->mode == 8 && rel_write(u, &c->u.l, arg)) *st = ST_TIMEOUT;
+        } else if (v->wlen < VD_CMDBUF - 1) {
+            v->wbuf[v->wlen++] = arg;
+        }
+        return 0;
+    case VD_UNLSN:
+        if (op == 0xF0 || op == 0xE0 || (op == 0x60 && ch == 15))
+            u->stat_len = u->stat_pos = 0;             /* a new DOS operation replaces the status message: whatever was left
+                                                          unread is dropped (as on a real drive / in VICE), so callers need
+                                                          not drain it. Reading it in pieces between operations still works. */
+        if (op == 0xF0 || (op == 0x60 && ch == 15))
+            set_err(u, 0, 0, 0);                       /* an OPEN or a command starts at 00, OK: an error nobody read does not outlive it
+                                                          (a 1541 reports 00 after any command that succeeds) */
+        if (op == 0xF0) {
+            if (ch == 15) exec_command(v, v->act, u, v->wbuf, v->wlen);
+            else chan_open(v, v->act, u, ch, v->wbuf, v->wlen);
+        } else if (op == 0x60 && ch == 15) {
+            exec_command(v, v->act, u, v->wbuf, v->wlen);
+        } else if (op == 0xE0) {
+            if (ch == 15) close_all(u); else chan_close(u, ch);
+        } else if (op == 0x60) {
+            vd_chan_t *c = chan_find(u, ch);
+            if (c && c->mode == 8 && c->u.l.wrote) rel_end_record(u, &c->u.l);
+        }
+        v->wlen = 0; v->act = -1;
+        return 0;
+    case VD_ACPTR: {
+        int eoi = 0;
+        if (ch == 15) {                                /* error channel */
+            if (u->stat_pos < u->stat_len) { *data = u->statbuf[u->stat_pos++]; if (u->stat_pos >= u->stat_len) *st = ST_EOI; }
+            else { *data = '\r'; *st = ST_EOI; }
+            return 0;
+        }
+        vd_chan_t *c = chan_find(u, ch);
+        if (!c || !read_byte(v, v->act, u, c, data, &eoi)) { *st = ST_TIMEOUT | ST_EOI; return 0; }
+        if (eoi) *st = ST_EOI;
+        return 0; }
+    case VD_UNTLK:
+        v->act = -1;
+        return 0;
+    }
+    return 1;
+}
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.h b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.h
new file mode 100644
index 0000000..32e38dd
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive.h
@@ -0,0 +1,165 @@
+/* Virtual IEC drive: the Teensy-side state machine behind the KERNAL mailbox.
+ * Units 0/1 = devices 8/9, each backed by an optional mounted d64_t.
+ * One mailbox command in, one result out; no I/O other than the d64 and host callbacks. */
+#ifndef TDRIVE_H
+#define TDRIVE_H
+#include "../../../DiskImage/d64.h"
+#include "vd_cfg.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { VD_LISTEN = 1, VD_TALK, VD_SECOND, VD_TKSA, VD_CIOUT, VD_ACPTR, VD_UNLSN, VD_UNTLK };
+
+#define VD_CMDBUF 64
+#define VD_HFBUF  64      /* chunk size of the host text file channels */
+
+/* Directory listings are generated a line at a time: no listing buffer. */
+typedef struct {
+    d64_dir_t it;               /* image directory iterator (unused for host listings) */
+    char      pat[17];
+    uint8_t   phase;            /* 0 header, 1 entries, 2 footer, 3 done */
+    uint8_t   host;             /* listing the host directory (nothing mounted) */
+    uint8_t   has_pat;
+    uint8_t   lpos, llen;       /* cursor / length of line[] */
+    uint16_t  off;              /* bytes emitted so far, load address included */
+    uint8_t   line[48];
+} vd_dirstream_t;
+
+/* REL channel: the record cursor over a d64_rel_t. One LISTEN session writes one record (the rest is zero-filled at UNLSN);
+ * a read sends a record up to its last non-zero byte, with EOI, then moves to the next. */
+typedef struct {
+    d64_rel_t f;
+    uint16_t  rec;              /* current record, 0-based */
+    uint8_t   pos;              /* byte within it */
+    uint8_t   rlen;             /* bytes a read of the current record sends (0 = not worked out yet) */
+    uint8_t   wrote;            /* bytes came in during this LISTEN session */
+    uint8_t   over;             /* 1: this record overflowed (51 reported), 2: it could not be made (52 / 72) */
+} vd_rel_t;
+
+/* A plain file on the card (nothing mounted): read through the host in 256-byte pieces. */
+typedef struct {
+    uint32_t left;              /* bytes not yet fetched from the host */
+    uint16_t pos, len;          /* cursor / fill of buf */
+    uint8_t  buf[D64_SECTOR];
+} vd_plain_t;
+
+typedef struct {
+    uint8_t  mode;              /* 0 free, 1 file read, 3 file write, 4 directory stream, 5 direct-access buffer (OPEN n,d,n,"#"),
+                                   6 / 7 host text file read / write (OPEN n,d,n,"!CONFIG[,W]" / "!STATE"), 8 REL, 9 plain file on the card */
+    union { d64_file_t r; d64_wfile_t w; vd_dirstream_t d; struct { uint16_t pos; uint8_t buf[D64_SECTOR]; } b;
+            struct { uint8_t kind, pos, len; uint8_t buf[VD_HFBUF]; } h; vd_rel_t l; vd_plain_t p; } u;
+} vd_chan_t;
+
+/* Services the host (Teensy glue / test harness) provides for image selection.
+ * Paths are passed through unconverted (PETSCII); the host converts. All optional. */
+typedef struct {
+    void *ctx;
+    int  (*mount)(void *ctx, int unit, const char *name, d64_t **out);   /* 0 ok, else DOS error code (e.g. 62) */
+    void (*unmount)(void *ctx, int unit);
+    int  (*chdir)(void *ctx, int unit, const char *name);                /* "..", subdir; 0 ok else DOS error */
+    int  (*dir_open)(void *ctx, int unit, char title[17]);               /* 0 ok */
+    int  (*dir_next)(void *ctx, int unit, char name[17], uint32_t *size, int *is_dir); /* 1 entry, 0 end */
+    void (*save_devices)(void *ctx, uint8_t pin0, uint8_t pin1);        /* persist after a U0> renumber (0 = automatic) */
+    /* A directory listing by path ($/GAMES/G.D64, $GAMES/) must not change what is selected: push remembers the unit's folder and
+     * mounted image before the walk, pop (when the listing channel closes) goes back; *out = the image to use again (NULL = none).
+     * pop with out == NULL means "keep the new selection": the snapshot is dropped (a file was loaded through the path).
+     * Both optional; without them a listing by path leaves the new folder / image selected. $==path never pops. */
+    void (*push)(void *ctx, int unit);
+    int  (*pop)(void *ctx, int unit, d64_t **out);
+    /* Host text files for the configuration utility (OPEN n,d,n,"!CONFIG" read, "!CONFIG,W" write, "!STATE" read only): the unit's disk
+     * switching list (/tdrive-config.txt) and a two-line description of what the unit has mounted ("path", "folder"). The host
+     * converts the text to / from PETSCII (a line ends with CR on the C64 side). Only one such file is open at a time on the host side.
+     * hf_open: kind VD_HF_CONFIG / VD_HF_STATE; 0 ok, else a DOS error code (62 when there is no such file to read). hf_read: up to n bytes,
+     * 0 = end of file. hf_write: 0 ok. hf_close: after the last write the host should flush. All optional (a missing hf_open = 62). */
+    int  (*hf_open)(void *ctx, int unit, int kind, int write);
+    int  (*hf_read)(void *ctx, int unit, uint8_t *buf, int n);
+    int  (*hf_write)(void *ctx, int unit, const uint8_t *buf, int n);
+    void (*hf_close)(void *ctx, int unit, int write);
+    /* "N:NAME.D64,ID" with nothing mounted: make a new all-zero image file of `size` bytes in the current folder (never over an
+     * existing file: 63) and mount it like mount(); tdrive.c then writes the header and BAM. 0 ok, else a DOS error code. */
+    int  (*create)(void *ctx, int unit, const char *name, uint32_t size, d64_t **out);
+    /* A plain file in the current folder, read with nothing mounted (LOAD"GAME.PRG"): one open at a time per unit.
+     * plain_open: 0 ok (*size = its length) or a DOS error (62); plain_read: bytes read (<0 error); plain_close: done with it. */
+    int  (*plain_open)(void *ctx, int unit, const char *name, uint32_t *size);
+    int  (*plain_read)(void *ctx, int unit, uint8_t *buf, uint16_t n);
+    void (*plain_close)(void *ctx, int unit);
+    /* MD:NAME / RD:NAME with nothing mounted: make / remove (only if empty) a folder in the current folder. 0 ok, else a DOS error:
+     * mkdir 63 if the name is taken; rmdir 62 if there is no such folder, 63 if it is not empty. */
+    int  (*mkdir)(void *ctx, int unit, const char *name);
+    int  (*rmdir)(void *ctx, int unit, const char *name);
+    /* S:NAME.D64 with nothing mounted: delete an image file in the current folder. 0 ok, else a DOS error: 62 no such file (tdrive.c
+     * counts it as 0 scratched), 26 the file is read-only on the card (FAT attribute) or the card is not writable. */
+    int  (*scratch)(void *ctx, int unit, const char *name);
+} vd_host_t;
+enum { VD_HF_CONFIG = 0, VD_HF_STATE = 1 };
+
+struct tdrive_s;
+typedef struct {
+    struct tdrive_s *owner;     /* back pointer: closing a channel may have to restore the host state */
+    uint8_t  index;             /* this unit's number (0/1) */
+    uint8_t  restore_ch;        /* channel + 1 whose close restores the folder / image selected before a path listing; 0 = none */
+    d64_t   *disk;              /* NULL: no image mounted */
+    uint8_t  present;           /* device answers on the bus */
+    uint8_t  slot_of[16];       /* channel number -> pool slot + 1 (0 = not open) */
+    vd_chan_t slot[VD_NSLOT];
+    uint8_t  statbuf[48];       /* error channel (15) text */
+    uint8_t  stat_len, stat_pos;
+    uint8_t  err, err_t, err_s; /* DOS status */
+} vd_unit_t;
+
+typedef struct tdrive_s {
+    vd_host_t host;
+    vd_unit_t unit[2];
+    uint8_t  dev[2];            /* IEC device number each unit answers to now; 0 = none (not claimed on the bus) */
+    uint8_t  pin[2];            /* the number the user chose with U0> (kept in EEPROM); 0 = automatic */
+    int8_t   act;               /* -1 none, 0/1 unit, 2 = absent device */
+    uint8_t  talking;
+    uint8_t  sa;
+    uint8_t  wlen;
+    uint8_t  wbuf[VD_CMDBUF];
+} tdrive_t;
+
+void tdrive_init(tdrive_t *v);
+void tdrive_attach(tdrive_t *v, int unit, d64_t *disk, int present);
+/* Close every channel of a unit on the disk it is on now (open files are closed properly). Before the host changes that disk
+ * behind the drive's back (a remote swap): the channels' state belongs to the old image. A listing by path being closed puts its
+ * selection back (host pop). */
+void tdrive_close_unit(tdrive_t *v, int unit);
+/* pin0/pin1: device numbers the user fixed (8..30), 0 = automatic. Automatic units start on VD_DEV0/VD_DEV1 (or the next
+ * free number) and are moved by the start-up scan below. */
+void tdrive_set_devices(tdrive_t *v, uint8_t pin0, uint8_t pin1);
+/* Start-up scan (the KERNAL probes the real serial bus for 8,9,... after reset):
+ *   scan_begin  releases the numbers of all automatic units, so the probes reach the real bus; returns how many present
+ *               units still need a number (0 = nothing to scan for).
+ *   scan_free   the probe found nothing at `dev`: give it to the next automatic present unit (SD first, then USB).
+ *               Returns how many units are still waiting. */
+int  tdrive_scan_begin(tdrive_t *v);
+int  tdrive_scan_free(tdrive_t *v, uint8_t dev);
+int  tdrive_unit_for(const tdrive_t *v, uint8_t dev);                /* unit 0/1 serving this device number, or -1 */
+void tdrive_set_host(tdrive_t *v, const vd_host_t *host);
+int  tdrive_chan_mode(const tdrive_t *v, int unit, int ch);   /* 0 closed, 1 file-read, 3 file-write, 4 directory, 5 buffer, 6/7 host text, 8 REL, 9 plain file */
+int  tdrive_active(const tdrive_t *v);                        /* unit of the open bus transaction: 0/1, 2 absent device, -1 none */
+int  tdrive_pending_err(const tdrive_t *v, int unit);         /* DOS error code waiting on the status channel (0 = none) */
+
+/* Returns 1 if the transaction is not ours (fall back to the real IEC bus);
+ * 0 if handled, with data and st filled in (st = bits to OR into KERNAL ST). */
+int tdrive_mailbox(tdrive_t *v, uint8_t cmd, uint8_t arg, uint8_t *data, uint8_t *st);
+
+size_t tdrive_sizeof(void);
+
+/* Host file names the C64 cannot use as they are get an alias of at most 16 characters (docs/DESIGN.md 44). `name` is the
+ * host's ASCII name; `out` gets the C64 spelling, upper case. A name is usable as it is when it has at most 16 characters
+ * and none the C64 cannot type or the DOS parses (* ? , = : " and anything outside $20-$7A, `); otherwise each such
+ * character becomes '^' (the up arrow) and a name over 16 characters keeps its start and its end, joined by '^':
+ *   The-Pumpkins-Breadbin-of-Horror-side1.D64 -> THE-PU^SIDE1.D64
+ * The end is the last word after ' ', '-', '_' or '.' when it has 1-5 characters, else the last 3 characters; the
+ * extension (up to 3 characters after the last '.') stays. Every alias holds a '^'. The host decides about collisions.
+ * Returns 0 = usable as is (out = name in upper case), 1 = out is an alias, -1 = empty name. */
+int vd_alias(const char *name, char out[17]);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.c b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.c
new file mode 100644
index 0000000..aa27440
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.c
@@ -0,0 +1,335 @@
+#include "tdrive_io.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+VD_COLD void vio_init(vio_t *v, vio_hot_t *hot)
+{
+    memset((void *)hot, 0, sizeof *hot);
+    memset((void *)v, 0, sizeof *v);
+    v->h = hot;
+    hot->stat = VIO_OK;                   /* idle, nothing pending */
+    hot->border = VIO_BRD_IDLE;
+    hot->id0 = VIO_ID0_VAL;
+    hot->id1 = VIO_ID1_VAL;
+    tdrive_init(&v->vd);
+    vio_publish_devices(v);
+}
+
+/* As the firmware's handlers read them (IO1Hndlr_TDrive): the register bytes in order, CMD included */
+uint8_t vio_io1_read(const vio_hot_t *h, uint8_t off) { return off < VIO_NREGS ? ((const volatile uint8_t *)h)[off] : 0; }
+
+void vio_io1_write(vio_hot_t *h, uint8_t off, uint8_t val)
+{
+    switch (off) {
+    case VIO_ARG: h->arg = val; break;
+    case VIO_LEN: h->len = val; break;
+    case VIO_CMD:
+        h->cmd = val;
+        h->stat = VIO_BUSY;          /* visible to the 6502 before it can read STAT */
+        h->pending = 1;
+        break;
+    default: break;
+    }
+}
+
+uint8_t vio_io2_read(const vio_hot_t *h, uint8_t off) { return h->window[off & (VIO_WIN - 1)]; }
+void    vio_io2_write(vio_hot_t *h, uint8_t off, uint8_t val) { h->window[off & (VIO_WIN - 1)] = val; }
+
+/* ---- fast paths, built from the byte-level commands ---- */
+VD_COLD static int bus(vio_t *v, uint8_t c, uint8_t a, uint8_t *data)
+{
+    uint8_t st = 0, d = 0;
+    tdrive_mailbox(&v->vd, c, a, &d, &st);
+    if (data) *data = d;
+    return st;
+}
+
+VD_COLD static void send_name_open(vio_t *v, uint8_t dev, uint8_t sa)
+{
+    bus(v, VD_LISTEN, dev, 0);
+    bus(v, VD_SECOND, sa, 0);
+    for (unsigned i = 0; i < v->h->len && i < VIO_WIN; i++) bus(v, VD_CIOUT, v->h->window[i], 0);
+    bus(v, VD_UNLSN, 0, 0);
+}
+
+VD_COLD static void close_chan(vio_t *v, uint8_t dev, uint8_t sa)
+{
+    bus(v, VD_LISTEN, dev, 0); bus(v, VD_SECOND, sa, 0); bus(v, VD_UNLSN, 0, 0);
+}
+
+VD_COLD static void fload_open(vio_t *v)
+{
+    uint8_t dev = v->h->arg, b0, b1 = 0;
+    v->fl_active = 0; v->fl_verify = 0;
+    if (bus(v, VD_LISTEN, dev, 0) & 0x80) { v->h->data = 5; return; }
+    bus(v, VD_UNLSN, 0, 0);                         /* finish probe transaction */
+    send_name_open(v, dev, 0xF0);
+    bus(v, VD_TALK, dev, 0); bus(v, VD_TKSA, 0x60, 0);
+    int st0 = bus(v, VD_ACPTR, 0, &b0);
+    if (st0 & 0x02) {                               /* nothing came back: file not found */
+        bus(v, VD_UNTLK, 0, 0); close_chan(v, dev, 0xE0);
+        v->h->data = 4; return;
+    }
+    v->fl_eof = (st0 & 0x40) != 0;
+    if (!v->fl_eof) { int st1 = bus(v, VD_ACPTR, 0, &b1); v->fl_eof = (st1 & 0x40) != 0; }
+    bus(v, VD_UNTLK, 0, 0);
+    v->h->window[0] = b0; v->h->window[1] = b1;
+    v->fl_active = 1; v->fl_dev = dev;
+    v->h->data = 0;
+}
+
+/* The next bytes of the file being loaded, at most max, into buf. Returns the count; *st = the ST to answer ($40 last part, $42 a read
+ * error ended it, 0 more to come). At the end the channel is closed. */
+VD_COLD static unsigned fload_read(vio_t *v, uint8_t *buf, unsigned max, uint8_t *st_out)
+{
+    unsigned n = 0;
+    uint8_t d;
+    *st_out = 0x40;                                         /* default: EOI, empty */
+    if (!v->fl_active) return 0;
+    if (v->fl_eof) { close_chan(v, v->fl_dev, 0xE0); v->fl_active = 0; return 0; }
+    int eof = 0, tmo = 0;
+    bus(v, VD_TALK, v->fl_dev, 0); bus(v, VD_TKSA, 0x60, 0);
+    while (n < max) {
+        int st = bus(v, VD_ACPTR, 0, &d);
+        if (st & 0x02) { eof = 1; tmo = 1; break; }       /* a read error (bad sector): the load ends here, ST shows $42 */
+        buf[n++] = d;
+        if (st & 0x40) { eof = 1; break; }
+    }
+    bus(v, VD_UNTLK, 0, 0);
+    *st_out = (uint8_t)(eof ? (tmo ? 0x42 : 0x40) : 0);
+    if (eof) { close_chan(v, v->fl_dev, 0xE0); v->fl_active = 0; }
+    return n;
+}
+
+VD_COLD static void fload_blk(vio_t *v)
+{
+    uint8_t st;
+    v->h->data = (uint8_t)fload_read(v, v->h->window, VIO_WIN, &st);
+    v->h->st = st;
+}
+
+VD_COLD static void fload_abandon(vio_t *v)
+{
+    if (v->fl_active) { close_chan(v, v->fl_dev, 0xE0); v->fl_active = 0; }
+}
+
+VD_COLD static int dma_can(const vio_t *v, int need_read)
+{
+    return v->dma_write && v->dma_buf && v->dma_max && (!need_read || v->dma_read);
+}
+
+/* VIO_FLOAD_DMA after VIO_FVERIFY_OPEN: the next part compared with RAM at addr. 1 = not mine (a DMA read or write failed, or an address
+ * the open did not allow): the KERNAL reports an error rather than a VERIFY result it did not get */
+VD_COLD static int fverify_dma(vio_t *v, uint32_t addr)
+{
+    if (!dma_can(v, 1) || !vio_dma_rd_ok(addr)) { fload_abandon(v); return 1; }
+    uint32_t room = 0xD000 - addr;
+    uint8_t st, mem[256];
+    unsigned n = fload_read(v, v->dma_buf, room < v->dma_max ? room : v->dma_max, &st);
+    v->h->data = 0;
+    for (unsigned off = 0; off < n; off += sizeof mem) {
+        unsigned k = n - off < sizeof mem ? n - off : (unsigned)sizeof mem;
+        if (!v->dma_read(v->dma_ctx, (uint16_t)(addr + off), mem, (uint16_t)k)) { fload_abandon(v); return 1; }
+        if (memcmp(mem, v->dma_buf + off, k)) st |= 0x10;           /* VERIFY ERROR, and on to the end as the stock loop goes */
+    }
+    v->h->st = st;
+    if (n) {
+        uint32_t end = addr + n;
+        uint8_t ptr[2] = { (uint8_t)end, (uint8_t)(end >> 8) };
+        if (!v->dma_write(v->dma_ctx, VIO_DMA_PTR, ptr, 2)) { fload_abandon(v); return 1; }
+    }
+    return 0;
+}
+
+/* VIO_FLOAD_DMA: returns 1 (not mine) when a DMA write failed; the KERNAL then reports an error instead of loading stale bytes. */
+VD_COLD static int fload_dma(vio_t *v)
+{
+    uint32_t addr = (uint32_t)v->h->arg | (uint32_t)v->h->len << 8;
+    if (v->fl_verify) return fverify_dma(v, addr);
+    if (!v->dma_write || !v->dma_buf || !v->dma_max || !vio_dma_ok(addr)) { fload_blk(v); return 0; }
+    uint32_t room = (addr < 0xD000 ? 0xD000 : 0x10000) - addr;   /* stop at I/O and at the top of memory: the window takes over there */
+    uint8_t st;
+    unsigned n = fload_read(v, v->dma_buf, room < v->dma_max ? room : v->dma_max, &st);
+    v->h->data = 0; v->h->st = st;
+    if (n) {
+        uint32_t end = addr + n;
+        uint8_t ptr[2] = { (uint8_t)end, (uint8_t)(end >> 8) };
+        if (!v->dma_write(v->dma_ctx, (uint16_t)addr, v->dma_buf, (uint16_t)n) || !v->dma_write(v->dma_ctx, VIO_DMA_PTR, ptr, 2)) {
+            fload_abandon(v);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* VIO_FVERIFY_OPEN: 1 = not mine (the KERNAL's stock VERIFY). Taken only when every byte of the file can be compared by DMA, so the
+ * file is read through once for its length and then opened again. */
+VD_COLD static int fverify_open(vio_t *v)
+{
+    if (!dma_can(v, 1)) return 1;
+    uint8_t name[VIO_WIN], nlen = v->h->len, sa, at[2];
+    memcpy(name, v->h->window, sizeof name);                /* fload_open puts the load address over the name */
+    if (!v->dma_read(v->dma_ctx, VIO_DMA_SA, &sa, 1) || !v->dma_read(v->dma_ctx, VIO_DMA_ADDR, at, 2)) return 1;
+    fload_open(v);
+    if (v->h->data) return 0;                               /* not found / no device: reported as for a LOAD */
+    uint32_t start = sa ? (uint32_t)v->h->window[0] | (uint32_t)v->h->window[1] << 8 : (uint32_t)at[0] | (uint32_t)at[1] << 8;
+    uint32_t len = 0;
+    while (v->fl_active) {
+        uint8_t st;
+        unsigned n = fload_read(v, v->dma_buf, v->dma_max, &st);   /* closes the channel at the end */
+        if (!n) break;
+        len += n;
+    }
+    fload_abandon(v);
+    if (!vio_dma_rd_ok(start) || start + len > 0xD000) return 1;
+    memcpy(v->h->window, name, sizeof name);
+    v->h->len = nlen;
+    fload_open(v);
+    if (v->h->data) return 0;
+    v->fl_verify = 1;
+    return 0;
+}
+
+VD_COLD void vio_set_dma(vio_t *v, int (*write)(void *ctx, uint16_t addr, const uint8_t *buf, uint16_t len),
+                         int (*read)(void *ctx, uint16_t addr, uint8_t *buf, uint16_t len), void *ctx, uint8_t *buf, uint16_t max)
+{
+    v->dma_write = write; v->dma_read = read; v->dma_ctx = ctx; v->dma_buf = buf; v->dma_max = max;
+}
+
+VD_COLD static void fsave_open(vio_t *v)
+{
+    uint8_t dev = v->h->arg;
+    v->fs_active = 0; v->fs_fail = 0;
+    if (bus(v, VD_LISTEN, dev, 0) & 0x80) { v->h->data = 5; return; }
+    bus(v, VD_UNLSN, 0, 0);
+    send_name_open(v, dev, 0xF1);
+    int unit = tdrive_unit_for(&v->vd, dev);
+    if (tdrive_chan_mode(&v->vd, unit, 1) == 3) { v->fs_active = 1; v->fs_dev = dev; v->h->data = 0; }
+    else { int e = tdrive_pending_err(&v->vd, unit); v->h->data = (uint8_t)(e ? e : 74); }
+}
+
+VD_COLD static void fsave_bytes(vio_t *v, const uint8_t *buf, unsigned n)
+{
+    bus(v, VD_LISTEN, v->fs_dev, 0); bus(v, VD_SECOND, 0x61, 0);
+    for (unsigned i = 0; i < n; i++) bus(v, VD_CIOUT, buf[i], 0);
+    bus(v, VD_UNLSN, 0, 0);
+}
+
+/* 1 = not mine: the save was abandoned (fsave_dma) */
+VD_COLD static int fsave_blk(vio_t *v)
+{
+    if (v->fs_fail) return 1;
+    if (!v->fs_active) return 0;
+    fsave_bytes(v, v->h->window, v->h->len < VIO_WIN ? v->h->len : VIO_WIN);
+    return 0;
+}
+
+/* VIO_FSAVE_DMA. 1 = not mine (abandoned: the new $AC/$AD could not be written, so the KERNAL would send the same bytes again) */
+VD_COLD static int fsave_dma(vio_t *v)
+{
+    v->h->data = 1;                                         /* nothing done: send a window block */
+    if (v->fs_fail) return 1;
+    if (!v->fs_active || !dma_can(v, 1)) return 0;
+    uint8_t p[4];
+    if (!v->dma_read(v->dma_ctx, VIO_DMA_SAVE, p, 4)) return 0;
+    uint32_t cur = (uint32_t)p[0] | (uint32_t)p[1] << 8, end = (uint32_t)p[2] | (uint32_t)p[3] << 8;
+    if (end <= cur || !vio_dma_rd_ok(cur)) return 0;        /* the end, or an address the CPU must read (the window path) */
+    uint32_t n = end - cur, room = 0xD000 - cur;
+    if (n > room) n = room;
+    if (n > v->dma_max) n = v->dma_max;
+    if (!v->dma_read(v->dma_ctx, (uint16_t)cur, v->dma_buf, (uint16_t)n)) return 0;   /* nothing changed: the window instead */
+    uint32_t nxt = cur + n;
+    uint8_t ptr[2] = { (uint8_t)nxt, (uint8_t)(nxt >> 8) };
+    if (!v->dma_write(v->dma_ctx, VIO_DMA_SAVE, ptr, 2)) {
+        close_chan(v, v->fs_dev, 0xE1);                     /* what came so far stays in the file, as after a save cut short */
+        v->fs_active = 0; v->fs_fail = 1;
+        return 1;
+    }
+    fsave_bytes(v, v->dma_buf, n);
+    v->h->data = 0;
+    return 0;
+}
+
+/* 1 = not mine: the save was abandoned (fsave_dma) */
+VD_COLD static int fsave_close(vio_t *v)
+{
+    v->h->data = 0;
+    if (v->fs_fail) { v->fs_fail = 0; return 1; }
+    if (!v->fs_active) return 0;
+    int unit = tdrive_unit_for(&v->vd, v->fs_dev);
+    int ok = tdrive_chan_mode(&v->vd, unit, 1) == 3;
+    close_chan(v, v->fs_dev, 0xE1);
+    if (!ok) { int e = tdrive_pending_err(&v->vd, unit); v->h->data = (uint8_t)(e ? e : 74); }
+    v->fs_active = 0;
+    return 0;
+}
+
+VD_COLD void vio_publish_devices(vio_t *v) { v->h->dev0 = v->vd.dev[0]; v->h->dev1 = v->vd.dev[1]; }
+
+VD_COLD int vio_arm_scan(vio_t *v)
+{
+    v->scan_state = 0;
+    for (int i = 0; i < 2; i++)
+        if (!v->vd.pin[i] && v->vd.unit[i].present) v->scan_state = 1;
+    return v->scan_state;
+}
+
+VD_COLD int vio_probe_begin(vio_t *v)
+{
+    v->scan_state = 3;
+    int need = tdrive_scan_begin(&v->vd);
+    vio_publish_devices(v);
+    return need;
+}
+
+VD_COLD int vio_probe_free(vio_t *v, uint8_t dev)
+{
+    int left = tdrive_scan_free(&v->vd, dev);
+    vio_publish_devices(v);
+    return left;
+}
+
+VD_COLD int vio_take_menu(vio_t *v)
+{
+    int r = v->menu_req;
+    v->menu_req = 0;
+    return r;
+}
+
+VD_COLD int vio_poll(vio_t *v)
+{
+    if (!v->h->pending) return 0;
+    uint8_t c = v->h->cmd, notmine = 0, ask = 0;
+    v->h->data = 0; v->h->st = 0;
+    if (c == VD_LISTEN || c == VD_TALK || c == VIO_FLOAD_OPEN || c == VIO_FSAVE_OPEN || c == VIO_FVERIFY_OPEN) {   /* a transaction starts */
+        if (v->scan_state == 1) { v->scan_state = 2; ask = 1; }
+        else if (v->scan_state == 2) v->scan_state = 3;                                    /* asked, not answered: this KERNAL does not scan */
+    }
+    if (ask) {
+        /* answer SCANREQ below, execute nothing */
+    } else if (c >= VD_LISTEN && c <= VD_UNTLK) {
+        uint8_t d, st;
+        notmine = (uint8_t)tdrive_mailbox(&v->vd, c, v->h->arg, &d, &st);
+        v->h->data = d; v->h->st = st;
+    } else switch (c) {
+        case VIO_FLOAD_OPEN:  if (tdrive_unit_for(&v->vd, v->h->arg) >= 0) fload_open(v);  else notmine = 1; break;
+        case VIO_FLOAD_BLK:   fload_blk(v); break;
+        case VIO_FLOAD_DMA:   notmine = (uint8_t)fload_dma(v); break;
+        case VIO_FSAVE_OPEN:  if (tdrive_unit_for(&v->vd, v->h->arg) >= 0) fsave_open(v);  else notmine = 1; break;
+        case VIO_FSAVE_BLK:   notmine = (uint8_t)fsave_blk(v); break;
+        case VIO_FSAVE_CLOSE: notmine = (uint8_t)fsave_close(v); break;
+        case VIO_FSAVE_DMA:   notmine = (uint8_t)fsave_dma(v); break;
+        case VIO_FVERIFY_OPEN: if (tdrive_unit_for(&v->vd, v->h->arg) >= 0) notmine = (uint8_t)fverify_open(v); else notmine = 1; break;
+        case VIO_SCAN:        v->scan_state = 3; v->h->data = (uint8_t)tdrive_scan_begin(&v->vd); break;
+        case VIO_FREE:        v->h->data = (uint8_t)tdrive_scan_free(&v->vd, v->h->arg); break;
+        case VIO_MENU:        v->menu_req = 1; break;
+        default: notmine = 1;
+    }
+    vio_publish_devices(v);                             /* a U0> or a scan step may have moved a unit */
+    v->h->pending = 0;                                  /* order: results first ... */
+    v->h->stat = ask ? VIO_SCANREQ : notmine ? VIO_NOTMINE : VIO_OK;   /* ... then publish the answer token */
+    return 1;
+}
+
+VD_COLD size_t vio_sizeof(void) { return sizeof(vio_t); }
+VD_COLD size_t vio_hot_sizeof(void) { return sizeof(vio_hot_t); }
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.h b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.h
new file mode 100644
index 0000000..18e93da
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_io.h
@@ -0,0 +1,136 @@
+/* Mailbox register engine for the TR+ virtual drive.
+ *
+ *   IO1 ($DE10, offsets below are relative to it): +0 CMD (W: trigger)  +1 ARG (RW)  +2 DATA (R)  +3 STAT (R)  +4 ST (R)  +5 LEN (RW)
+ *                                                  +6 DEV0 (R)  +7 DEV1 (R): IEC device number of the SD / USB drive now (0 = none)
+ *                                                  +8 BORDER (R): request for the KERNAL's IRQ routine, see VIO_BRD_* (disk-switch feedback)
+ *                                                  +9 ID0, +10 ID1 (R): VIO_ID0_VAL / VIO_ID1_VAL while the handler answers (the KERNAL's reset hook, see VIO_MENU)
+ *   IO2 ($DF80): 128-byte window (RW): file name in, data blocks in/out. $DF00-$DF7F is not ours: the REU's registers live
+ *                there in the "TDrive+REU" and "TDrive+Swift+REU" handlers (IOH_TDriveREU.c); the others leave it unanswered.
+ *
+ * ISR side (vio_io*_read/write) is O(1) and never touches storage. Everything
+ * else runs from vio_poll() in the main loop. Portable C: host tests and the
+ * Teensy glue (IOH_TDrive.c) use the same code.
+ *
+ * Everything the bus ISR touches lives in the small vio_hot_t, which the firmware keeps in fast RAM1
+ * (DTCM); the large drive state (vio_t) can sit in slower RAM2 because only the main loop uses it.
+ *
+ * STAT is a handshake token, not a flag byte: BUSY ($80) from the moment CMD is written, then
+ * OK ($5A) or NOTMINE ($A5) when the answer is complete. The 6502 waits for exactly one of the two, so a
+ * floating-bus misread (which returns the previous bus byte, $DE here) can never look like "done".
+ *
+ * Bus scan: the Teensy cannot see the serial bus, so when a unit has no fixed device number it asks the 6502 to probe it. It does
+ * so lazily, on the first transaction of a run (the TDrive handler only becomes active once the program has been loaded): that
+ * command is answered with SCANREQ instead of being executed; the KERNAL sends SCAN, then FREE for each number where its
+ * LISTEN found nobody, until the answer says nobody is waiting, and then repeats the original command. Asked once only: a
+ * KERNAL that does not understand SCANREQ just times out on that one call and the defaults stay.
+ * The TR menu probes the bus itself before it starts a program (vio_probe_begin / vio_probe_free, the same steps driven from the
+ * menu's registers), so DEV0/DEV1 are right from the program's first instruction; after that probe nothing more is asked. */
+#ifndef TDRIVE_IO_H
+#define TDRIVE_IO_H
+#include "tdrive.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { VIO_CMD = 0, VIO_ARG = 1, VIO_DATA = 2, VIO_STAT = 3, VIO_ST = 4, VIO_LEN = 5, VIO_DEV0 = 6, VIO_DEV1 = 7, VIO_BORDER = 8, VIO_ID0 = 9, VIO_ID1 = 10, VIO_NREGS = 11 };
+#define VIO_BUSY    0x80
+#define VIO_OK      0x5A
+#define VIO_NOTMINE 0xA5
+/* BORDER register values (exact: the 6502 reads it twice and ignores anything else, e.g. $DE from a late answer): */
+#define VIO_BRD_IDLE    0x80   /* nothing to do */
+#define VIO_BRD_SET     0xC0   /* | colour 0..15: set the border to it */
+#define VIO_BRD_SAVE    0xB0   /* remember the current border colour */
+#define VIO_BRD_RESTORE 0xD0   /* set the border back to the remembered colour */
+/* ID registers: the KERNAL's reset entry ($FCE2, also SYS64738) sends VIO_MENU only when it reads these. A launch from the TR menu
+ * resets the C64 too, while the menu's own IO1 handler still answers: its $DE19/$DE1A are a SID's init address (0 without a SID),
+ * and no tune starts in I/O space, so $D6xx never shows there. Unanswered, the bus floats to $DE. */
+#define VIO_ID0_VAL 0xD6
+#define VIO_ID1_VAL 0x64
+#define VIO_WIN     128   /* window size: names, fast LOAD / SAVE blocks (a power of two, see vio_io2_read) */
+#define VIO_WIN_OFS 0x80  /* the window starts at IO2 + this ($DF80) */
+#define VIO_SCANREQ 0x3C   /* answer to the first LISTEN / TALK / fast LOAD / fast SAVE of a run: "scan the bus, then ask again" (see VIO_SCAN) */
+
+/* Commands 1..8 are VD_LISTEN..VD_UNTLK (byte-level). Fast paths: */
+enum {
+    VIO_FLOAD_OPEN = 9,    /* ARG=device, window[0..LEN) = name (LEN < VIO_WIN). DATA: 0 ok (window[0..1] = load address), 4 not found, 5 no device */
+    VIO_FLOAD_BLK  = 10,   /* DATA = byte count (0..VIO_WIN) now in window; ST=$40 on the last block */
+    VIO_FSAVE_OPEN = 11,   /* ARG=device, window[0..LEN) = name. DATA: 0 ok else DOS error code (63, 72, ...) or 5 */
+    VIO_FSAVE_BLK  = 12,   /* LEN bytes (at most VIO_WIN) from window are appended to the file */
+    VIO_FSAVE_CLOSE= 13,   /* DATA: 0 ok else DOS error code */
+    VIO_SCAN       = 14,   /* start of the reset-time bus scan: releases the automatic units' numbers. DATA = units that need a number */
+    VIO_FREE       = 15,   /* ARG = a device number nobody answered at; it goes to the next unit that needs one. DATA = units still waiting */
+    VIO_MENU       = 16,   /* back to the TR menu: answered OK, then the Teensy writes back what is unsaved and resets the C64 into its menu
+                              (TDrive Config's Q; the KERNAL's cold start, SYS64738, once it has read VIO_ID0_VAL / VIO_ID1_VAL) */
+    VIO_FLOAD_DMA  = 17,   /* the next part of a fast LOAD, ARG/LEN = the address its first byte goes to (the KERNAL's $AE/$AF). Answered as
+                              VIO_FLOAD_BLK (DATA = bytes in the window), or, when the host can DMA and the address allows it (vio_dma_ok), with
+                              DATA = 0: up to dma_max bytes were written into C64 RAM by DMA and the end pointer into $AE/$AF (VIO_DMA_PTR).
+                              ST as VIO_FLOAD_BLK. A failed DMA is answered NOTMINE (the KERNAL reports an error).
+                              After VIO_FVERIFY_OPEN every answer is a DMA one: the part is compared with RAM (read by DMA), a difference
+                              ORs $10 (VERIFY ERROR) into ST, DATA = 0 and the end pointer is written as for a LOAD */
+    VIO_FSAVE_DMA  = 18,   /* the next part of a fast SAVE by DMA: the Teensy reads the KERNAL's $AC-$AF (VIO_DMA_SAVE: current, end) by DMA,
+                              then up to dma_max bytes from $AC (vio_dma_rd_ok), appends them to the file and writes the new $AC/$AD. DATA = 0:
+                              a part was saved, ask again; DATA = 1: nothing done (no DMA, nothing left, or an address the window must take),
+                              send a window block. A DMA write that failed after the read: the save is abandoned, NOTMINE now and to the
+                              following VIO_FSAVE_BLK / VIO_FSAVE_CLOSE (the KERNAL reports an error) */
+    VIO_FVERIFY_OPEN = 19  /* as VIO_FLOAD_OPEN for a VERIFY: taken (answered as FLOAD_OPEN) only when the host can read RAM by DMA and the
+                              whole file lies where a DMA read sees what the CPU sees (vio_dma_rd_ok); the start address is the file's own or,
+                              with secondary address 0 (the KERNAL's $A4, VIO_DMA_SA), $C3/$C4. Otherwise NOTMINE: the KERNAL's stock VERIFY */
+};
+#define VIO_DMA_PTR 0xAE   /* the KERNAL's LOAD pointer ($AE/$AF), written by DMA after each DMA part */
+/* DMA only to RAM the CPU's own stores would reach just the same: not $0000-$01FF (the CPU port at $00/$01, zero page, the stack the
+ * KERNAL is running on) and not $D000-$DFFF (I/O or the character ROM, depending on $01; the window path writes there with the CPU) */
+#define vio_dma_ok(a) ((a) >= 0x0200 && ((a) < 0xD000 || (a) >= 0xE000))
+/* DMA reads (SAVE, VERIFY) only where a DMA read sees what the KERNAL's own reads see: $0200-$CFFF. Not $D000-$DFFF (I/O reads change
+ * things; our own IO1/IO2 registers do not answer a DMA read) and not $E000-$FFFF: while the KERNAL runs the CPU sees the served image
+ * there, a DMA read the machine's own ROM chip */
+#define vio_dma_rd_ok(a) ((a) >= 0x0200 && (a) < 0xD000)
+#define VIO_DMA_SAVE 0xAC  /* the KERNAL's SAVE pointer and end ($AC/$AD, $AE/$AF), read by VIO_FSAVE_DMA */
+#define VIO_DMA_SA   0xA4  /* the original secondary address of a LOAD / VERIFY (fl_hook in patches/tdrive.s keeps it there) */
+#define VIO_DMA_ADDR 0xC3  /* the caller's load address ($C3/$C4), used with secondary address 0 */
+
+/* Registers + window: the only memory the bus ISR reads or writes (~140 bytes). Keep in DTCM. */
+typedef struct {
+    volatile uint8_t cmd, arg, data, stat, st, len, dev0, dev1, border, id0, id1, pending;   /* cmd..id1 are in register order (see the static_assert in IOH_TDrive.c) */
+    uint8_t window[VIO_WIN];
+} vio_hot_t;
+
+/* Drive state and fast-path bookkeeping: main loop only. */
+typedef struct {
+    tdrive_t vd;                       /* must stay first: callers pass a vio_t* where a tdrive_t* is wanted */
+    vio_hot_t *h;
+    uint8_t fl_active, fl_eof, fl_dev, fs_active, fs_dev;
+    uint8_t fl_verify;                 /* the channel was opened by VIO_FVERIFY_OPEN: VIO_FLOAD_DMA compares instead of writing */
+    uint8_t fs_fail;                   /* a VIO_FSAVE_DMA was abandoned: the rest of that save is answered NOTMINE */
+    uint8_t scan_state;                /* 0 not needed, 1 to be requested, 2 requested, 3 done */
+    uint8_t menu_req;                  /* VIO_MENU was received (see vio_take_menu) */
+    /* VIO_FLOAD_DMA (vio_set_dma; vio_init clears them, so no DMA): write len bytes at C64 address addr, 1 = done */
+    int     (*dma_write)(void *ctx, uint16_t addr, const uint8_t *buf, uint16_t len);
+    /* VIO_FSAVE_DMA, VIO_FVERIFY_OPEN: read len bytes at C64 address addr into buf, 1 = done (NULL: SAVE by window, VERIFY the stock way) */
+    int     (*dma_read)(void *ctx, uint16_t addr, uint8_t *buf, uint16_t len);
+    void     *dma_ctx;
+    uint8_t  *dma_buf;                 /* dma_max bytes, main loop only */
+    uint16_t  dma_max;
+} vio_t;
+
+void    vio_init(vio_t *v, vio_hot_t *hot);
+uint8_t vio_io1_read(const vio_hot_t *h, uint8_t off);          /* ISR */
+void    vio_io1_write(vio_hot_t *h, uint8_t off, uint8_t val);  /* ISR */
+uint8_t vio_io2_read(const vio_hot_t *h, uint8_t off);          /* ISR; off = window index (IO2 address - VIO_WIN_OFS), wraps */
+void    vio_io2_write(vio_hot_t *h, uint8_t off, uint8_t val);  /* ISR */
+int     vio_poll(vio_t *v);                  /* 1 if a command was processed */
+int     vio_arm_scan(vio_t *v);              /* call once the units and pinned numbers are set: 1 if the KERNAL will be asked to scan the bus */
+int     vio_probe_begin(vio_t *v);           /* the menu's probe before launch: releases the automatic numbers, no SCANREQ afterwards; returns units that need a number */
+int     vio_probe_free(vio_t *v, uint8_t dev);   /* nobody answered at dev during that probe (as VIO_FREE); returns units still waiting */
+int     vio_take_menu(vio_t *v);             /* 1 once after VIO_MENU: the host should return to its menu */
+void    vio_set_dma(vio_t *v, int (*write)(void *ctx, uint16_t addr, const uint8_t *buf, uint16_t len),
+                    int (*read)(void *ctx, uint16_t addr, uint8_t *buf, uint16_t len), void *ctx, uint8_t *buf, uint16_t max);
+void    vio_publish_devices(vio_t *v);       /* copy the current device numbers to the DEV0/DEV1 registers (call after tdrive_set_devices) */
+
+size_t  vio_sizeof(void);
+size_t  vio_hot_sizeof(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.c b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.c
new file mode 100644
index 0000000..6726982
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.c
@@ -0,0 +1,539 @@
+#include "tdrive_vec.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+/* wait states */
+enum { VV_W_NONE, VV_W_CALL, VV_W_DATA };
+
+/* the vector each entry replaces ([VV_NE] = GETIN, reached through the fast path only); the same addresses on a C64 and a C128, but
+ * for VV_E_MAIN, whose vector is the profile's main_vec */
+static const uint16_t vv_vec[VV_NE + 1] = { 0, 0x031A, 0x031C, 0x031E, 0x0320, 0x0322, 0x0324, 0x0326, 0x032C, 0x0330, 0x0332, 0x0302, 0x032A };
+
+/* What differs between the KERNALs (docs/DESIGN.md 56). C64: 901227-03 (the -02, SX-64 and C128 C64-mode ROMs have the same routines
+ * there). C128 in 128 mode: 318020-05 with BASIC 7.0 318018-04 / 318019-04; 315078-03, 318034-01 and 325172-01 differ only in
+ * $FC80-$FE8B, which none of these touch. */
+typedef struct {
+    uint16_t stock[VV_NE + 1];  /* the vectors as RESTOR / BASIC's init set them, used until INSTALL has read the real ones */
+    uint16_t searching;         /* "SEARCHING FOR name" (direct mode only) */
+    uint16_t loading;           /* "LOADING" / "VERIFYING" ($93); the C128's also copies $AE/$AF to $AC/$AD first */
+    uint16_t saving;            /* "SAVING name" */
+    uint16_t error1;            /* the KERNAL's error exits: error1 + 3 * (n - 1), 1 TOO MANY FILES .. 9 ILLEGAL DEVICE */
+    uint16_t files;             /* the file table: LAT, FAT = LAT + 10, SAT = LAT + 20 */
+    uint16_t restor;            /* RESTOR's table of the vectors $0314-$0333 */
+    uint16_t main_vec;          /* the entry that hooks again after a RESTOR: IMAIN on a C64 (BASIC's READY loop); the C128's BASIC 7
+                                   calls IMAIN with bank 14 in ($FF03: the character ROM where I/O, and the agent, would be), so there
+                                   it is the warm-start vector $0A00, which RUN/STOP+RESTORE's NMI routine jumps through after RESTOR */
+    uint16_t initv_main;        /* where BASIC's init keeps main_vec's value (0: it is stock[VV_E_MAIN]) */
+    uint8_t  zp_end;            /* OPEN / LOAD / SAVE PEEK the zero page $AE..zp_end-1 */
+} vv_kernal_t;
+
+static const vv_kernal_t vv_kernal[2] = {
+    { { 0, 0xF34A, 0xF291, 0xF20E, 0xF250, 0xF333, 0xF157, 0xF1CA, 0xF32F, 0xF4A5, 0xF5ED, 0xA483, 0xF13E },
+      0xF5AF, 0xF5D2, 0xF68F, 0xF6FB, 0x0259, 0xFD30, 0x0302, 0xE447 + 2, 0xC5 },
+    { { 0, 0xEFBD, 0xF188, 0xF106, 0xF14C, 0xF226, 0xEF06, 0xEF79, 0xF222, 0xF26C, 0xF54E, 0x4003, 0xEEEB },
+      0xF50F, 0xFC4A, 0xF5BC, 0xF67C, 0x0362, 0xE073, 0x0A00, 0, 0xC8 },
+};
+#define KN (&vv_kernal[e->machine == VV_M_C128])
+
+/* the bus scan's calls of the real bus: the jump table, the same on both */
+#define K_LISTEN    0xFFB1
+#define K_SECOND    0xFF93
+#define K_UNLSN     0xFFAE
+#define K_ERROR(n)  (uint16_t)(KN->error1 + 3 * ((n) - 1))
+
+/* C128 in 128 mode: the drives in BASIC 7's start-up message (docs/DESIGN.md 59). Its fourth line, "ALL RIGHTS RESERVED" (row 4, 40
+ * or 80 columns), becomes " ALL RIGHTS RESERVED  TDRIVE SD 8 USB 9", centered (column 1 / 21), like the C64 banner's second line. */
+#define K_PLOT      0xFFF0      /* C clear: the cursor to row X, column Y */
+#define ED_PRINT    0xC00C      /* the C128 editor's jump table: print A on the screen (what CHROUT does for device 3) */
+#define B_MODE      0xD7        /* bit 7: the 80-column screen is the active one */
+#define B_TBLX      0xEB        /* the cursor's row, then column ($EC) */
+#define B_ROW       4
+#define B_SCREEN40  0x0400      /* the 40-column screen as BASIC 7's start leaves it */
+static const char vv_banner_head[] = "ALL RIGHTS RESERVED";
+
+/* C128: the MMU's configuration register, and the value for each bank as the KERNAL's GETCFG table ($F7F0) has it, with I/O switched
+ * in (bit 0 clear): the agent runs in I/O. Banks 0-3 are RAM, 14 and 15 the system bank. Both RAM banks hold the KERNAL's interrupt
+ * trampolines at $FF05 and the CPU vectors, so an interrupt while bank 1 is switched in is served as usual. */
+#define MMU_CR 0xFF00
+static const uint8_t vv_bank_cfg[16] = { 0x3E, 0x7E, 0xBE, 0xFE, 0x16, 0x56, 0x96, 0xD6, 0x2A, 0x6A, 0xAA, 0xEA, 0x06, 0x0A, 0x00, 0x00 };
+
+#define P_C 0x01
+#define P_Z 0x02
+#define P_N 0x80
+
+VD_COLD void vvec_init(vvec_t *e, vio_t *v, uint16_t base)
+{
+    memset((void *)e, 0, sizeof *e);
+    e->v = v;
+    e->base = base;
+    memcpy(e->old, vv_kernal[0].stock, sizeof e->old);
+}
+
+VD_COLD void vvec_set_machine(vvec_t *e, uint8_t machine)
+{
+    e->machine = machine == VV_M_C128 ? VV_M_C128 : VV_M_C64;
+    memcpy(e->old, KN->stock, sizeof e->old);
+}
+
+VD_COLD size_t vvec_sizeof(void) { return sizeof(vvec_t); }
+
+static uint16_t target_of(const vvec_t *e, int k)
+{
+    if (k == VV_E_BSOUT) return (uint16_t)(e->base + VV_OFS_F_BSOUT);
+    if (k == VV_E_BASIN) return (uint16_t)(e->base + VV_OFS_F_BASIN);
+    if (k == VV_NE)      return (uint16_t)(e->base + VV_OFS_F_GETIN);
+    return (uint16_t)(e->base + VV_OFS_ENTRIES + 3 * k);
+}
+
+/* ---- the script in the window ---- */
+static void sc(vvec_t *e, uint8_t b) { if (e->sp < VIO_WIN - 2) e->v->h->window[e->sp++] = b; }
+
+VD_COLD static void sc_poke(vvec_t *e, uint16_t addr, const uint8_t *d, uint8_t n)
+{
+    sc(e, VV_OP_POKE); sc(e, (uint8_t)addr); sc(e, (uint8_t)(addr >> 8)); sc(e, n);
+    for (int i = n - 1; i >= 0; i--) sc(e, d[i]);                    /* the agent stores from the top down */
+}
+VD_COLD static void sc_poke1(vvec_t *e, uint16_t addr, uint8_t b) { sc_poke(e, addr, &b, 1); }
+VD_COLD static void sc_peek(vvec_t *e, uint16_t addr, uint8_t n) { sc(e, VV_OP_PEEK); sc(e, (uint8_t)addr); sc(e, (uint8_t)(addr >> 8)); sc(e, n); }
+VD_COLD static void sc_go(vvec_t *e, uint16_t to, uint8_t y, uint8_t p, uint8_t a, uint8_t x)
+{
+    sc(e, VV_OP_GO); sc(e, y); sc(e, p); sc(e, a); sc(e, x);
+    e->v->h->window[VIO_WIN - 2] = (uint8_t)to; e->v->h->window[VIO_WIN - 1] = (uint8_t)(to >> 8);
+}
+VD_COLD static void sc_ret(vvec_t *e, const vv_ctx_t *c, uint8_t a, uint8_t x, uint8_t y, int carry)
+{
+    uint8_t p = (uint8_t)((c->p & ~(P_C | P_Z | P_N)) | (carry ? P_C : 0) | (a ? 0 : P_Z) | (a & P_N));
+    sc_go(e, (uint16_t)(e->base + VV_OFS_RTS), y, p, a, x);
+}
+VD_COLD static void sc_chain(vvec_t *e, const vv_ctx_t *c, int k) { sc_go(e, e->old[k], c->y, c->p, c->a, c->x); }
+VD_COLD static void sc_error(vvec_t *e, const vv_ctx_t *c, int n) { sc_go(e, K_ERROR(n), c->y, c->p, c->a, c->x); }
+VD_COLD static void sc_call(vvec_t *e, const vv_ctx_t *c, uint16_t routine, uint8_t a, uint8_t x, uint8_t y)
+{
+    uint8_t r[2] = { (uint8_t)routine, (uint8_t)(routine >> 8) };
+    sc_poke(e, (uint16_t)(e->base + VV_OFS_CTRAMP + 1), r, 2);
+    sc_go(e, (uint16_t)(e->base + VV_OFS_CTRAMP), y, (uint8_t)(c->p & ~P_C), a, x);
+}
+
+/* one byte-level drive transaction; returns 1 when the drive says it is not ours. ST bits are ORed into *st */
+VD_COLD static int bus(vvec_t *e, uint8_t cmd, uint8_t arg, uint8_t *d, uint8_t *st)
+{
+    uint8_t dd = 0, s = 0;
+    int nm = tdrive_mailbox(&e->v->vd, cmd, arg, &dd, &s);
+    if (d) *d = dd;
+    if (st) *st |= s;
+    return nm;
+}
+
+static int ours(vvec_t *e, uint8_t dev) { return dev >= 4 && tdrive_unit_for(&e->v->vd, dev) >= 0; }
+
+/* ---- protothread ---- */
+#define PT_BEGIN(c)   switch ((c)->pc) { case 0:
+#define PT_END(c)     } (c)->pc = 0; return 0
+#define YIELD_(c, w, n) do { (c)->wait = (w); (c)->pc = (uint16_t)((n) + 1); return 1; case (n) + 1:; } while (0)
+#define YIELD(c, w)   YIELD_(c, w, __COUNTER__)
+#define DONE(c)       do { (c)->pc = 0; return 0; } while (0)
+#define CALL(r, A, X, Y) do { sc_call(e, c, (r), (A), (X), (Y)); YIELD(c, VV_W_CALL); } while (0)
+#define PEEK(ad, n)   do { sc_peek(e, (ad), (n)); YIELD(c, VV_W_DATA); } while (0)
+#define CONT()        do { sc(e, VV_OP_CONT); YIELD(c, VV_W_DATA); } while (0)
+#define CHAIN()       do { sc_chain(e, c, c->entry); DONE(c); } while (0)
+/* C128: memory in another bank. The caller's configuration is read once per call (the KERNAL is visible, so it is the system bank
+ * with I/O, but which RAM bank and ROMs the caller had in is its own business); a PEEK leaves the bank switched in until the next
+ * script, whose first op switches back. A C64, or the bank the caller has in already, needs no switch. */
+#define MMU_READ()    do { if (e->machine == VV_M_C128 && c->mmu == 0xFF) { PEEK(MMU_CR, 1); c->mmu = c->buf[0]; } } while (0)
+#define BANKED(b)     (e->machine == VV_M_C128 && vv_bank_cfg[(b) & 15] != c->mmu)
+#define BPEEK(b, ad, n) do { if (BANKED(b)) { sc_poke1(e, MMU_CR, vv_bank_cfg[(b) & 15]); PEEK((ad), (n)); sc_poke1(e, MMU_CR, c->mmu); } \
+                             else PEEK((ad), (n)); } while (0)
+#define ERROR(n)      do { sc_error(e, c, (n)); DONE(c); } while (0)
+
+/* the zero page as PEEKed from $AE ($AE-$C4 on a C64; to $C7 on a C128: BA, FNBANK) */
+#define ZP(a) c->buf[(a) - 0xAE]
+
+/* " ALL RIGHTS RESERVED  TDRIVE SD 8 USB 9" without the leading space: each unit "SD 8" / "SD10" / "NOSD", "USB 9" / "USB11" /
+ * "NOUSB" (patches/vdbanner.s); returns its length (38) */
+VD_COLD static uint8_t banner_text(const tdrive_t *vd, uint8_t *t)
+{
+    static const char *const name[2] = { "SD", "USB" };
+    uint8_t n = 0;
+    for (const char *s = vv_banner_head; *s; s++) t[n++] = (uint8_t)*s;
+    for (const char *s = "  TDRIVE "; *s; s++) t[n++] = (uint8_t)*s;
+    for (int u = 0; u < 2; u++) {
+        uint8_t d = vd->unit[u].present ? vd->dev[u] : 0;
+        if (u) t[n++] = ' ';
+        if (!d) { t[n++] = 'N'; t[n++] = 'O'; }
+        for (const char *s = name[u]; *s; s++) t[n++] = (uint8_t)*s;
+        if (d) { t[n++] = d < 10 ? ' ' : (uint8_t)('0' + d / 10); t[n++] = (uint8_t)('0' + d % 10); }
+    }
+    return n;
+}
+
+/* 1 if a 40-column screen row (screen codes) holds "ALL RIGHTS RESERVED" */
+VD_COLD static int banner_on_row(const uint8_t *row)
+{
+    const int len = (int)sizeof vv_banner_head - 1;
+    for (int i = 0; i + len <= 40; i++) {
+        int j = 0;
+        while (j < len && (row[i + j] & 0x7F) == (vv_banner_head[j] == ' ' ? 0x20 : vv_banner_head[j] & 0x3F)) j++;
+        if (j == len) return 1;
+    }
+    return 0;
+}
+
+/* hook every vector that is not ours yet (c->buf = $0302-$0333 as PEEKed; c->mainv = main_vec's value where it is elsewhere), and
+ * give the agent its fast paths' old vectors */
+VD_COLD static void install(vvec_t *e, vv_ctx_t *c)
+{
+    uint8_t img[0x34 - 0x02];
+    memcpy(img, c->buf, sizeof img);
+    if (KN->main_vec != 0x0302) {
+        uint16_t mine = target_of(e, VV_E_MAIN);
+        if (c->mainv != mine) {
+            uint8_t z[2] = { (uint8_t)mine, (uint8_t)(mine >> 8) };
+            e->old[VV_E_MAIN] = c->mainv;
+            sc_poke(e, KN->main_vec, z, 2);
+        }
+    }
+    for (int k = 1; k <= VV_NE; k++) {
+        if (k == VV_E_INSTALL || (k == VV_E_MAIN && KN->main_vec != 0x0302)) continue;
+        int o = vv_vec[k] - 0x0302;
+        uint16_t cur = (uint16_t)(img[o] | img[o + 1] << 8), mine = target_of(e, k);
+        if (cur == mine) continue;
+        e->old[k] = cur;
+        img[o] = (uint8_t)mine; img[o + 1] = (uint8_t)(mine >> 8);
+    }
+    sc_poke(e, 0x031A, img + 0x18, 0x34 - 0x1A);
+    sc_poke(e, 0x0302, img, 2);
+    uint8_t o3[6] = { (uint8_t)e->old[VV_E_BSOUT], (uint8_t)(e->old[VV_E_BSOUT] >> 8), (uint8_t)e->old[VV_E_BASIN],
+                      (uint8_t)(e->old[VV_E_BASIN] >> 8), (uint8_t)e->old[VV_NE], (uint8_t)(e->old[VV_NE] >> 8) };
+    sc_poke(e, (uint16_t)(e->base + VV_OFS_OLD), o3, 6);
+}
+
+VD_COLD static int vv_run(vvec_t *e, vv_ctx_t *c)
+{
+    vio_t *v = e->v;
+    PT_BEGIN(c);
+
+    /* OPEN, LOAD, SAVE: the file's numbers and name; the bus scan when this run has not had one */
+    if (c->entry == VV_E_OPEN || c->entry == VV_E_LOAD || c->entry == VV_E_SAVE) {
+        PEEK(0xAE, KN->zp_end - 0xAE);
+        if (e->machine == VV_M_C128) { c->ba = ZP(0xC6); c->fnbank = ZP(0xC7); }
+        c->fnlen = ZP(0xB7); c->la = ZP(0xB8); c->sa = ZP(0xB9); c->fa = ZP(0xBA);
+        c->fnadr = (uint16_t)(ZP(0xBB) | ZP(0xBC) << 8);
+        c->addr = (uint16_t)(ZP(0xC1) | ZP(0xC2) << 8);           /* SAVE: start */
+        c->end = (uint16_t)(ZP(0xAE) | ZP(0xAF) << 8);            /* SAVE: end */
+        c->cadr = (uint16_t)(ZP(0xC3) | ZP(0xC4) << 8);           /* LOAD: the caller's address */
+        c->scan = (uint8_t)(c->fa >= 4 && c->fnlen);              /* the bus scan below, when this run has not had one */
+    }
+
+    /* handlers (an if chain, not a switch: YIELD's case labels must belong to the protothread's switch) */
+    if (c->entry == VV_E_INSTALL) {
+        /* which KERNAL: the jump table's LOAD is JMP $F265 on a C128 in 128 mode, JMP $F49E on a C64 (and a C128 in C64 mode). So the
+         * same served agent works after a launch into either mode, an Exit to C128 BASIC, GO64 or a reset into the other mode. */
+        PEEK(0xFFD5, 3);
+        {
+            uint8_t m = (c->buf[0] == 0x4C && c->buf[1] == 0x65 && c->buf[2] == 0xF2) ? VV_M_C128 : VV_M_C64;
+            if (m != e->machine) vvec_set_machine(e, m);
+        }
+        if (KN->main_vec != 0x0302) { PEEK(KN->main_vec, 2); c->mainv = (uint16_t)(c->buf[0] | c->buf[1] << 8); }
+        PEEK(0x0302, 0x34 - 0x02);
+        if (c->a == VV_LAUNCH) {
+            /* from the menu's PRG loader, after the program is in memory: hook only if the vectors are still the ones RESTOR / INITV
+             * left (the ROM's own tables). A program that loaded over them (an autostart PRG) keeps its own. */
+            memcpy(c->data, c->buf, 0x32);
+            PEEK((uint16_t)(KN->restor + (0x031A - 0x0314)), 0x34 - 0x1A);
+            c->n = (uint8_t)(memcmp(c->buf, c->data + 0x18, 0x34 - 0x1A) == 0);
+            if (KN->initv_main) {
+                PEEK(KN->initv_main, 2);                      /* BASIC's init table: $0302's value */
+                c->n = (uint8_t)(c->n && !memcmp(c->buf, c->data, 2));
+            } else c->n = (uint8_t)(c->n && c->mainv == KN->stock[VV_E_MAIN]);
+            if (!c->n) { sc_ret(e, c, c->a, c->x, c->y, 1); DONE(c); }
+            memcpy(c->buf, c->data, 0x32);
+        }
+        install(e, c);
+        /* C128, from the boot ROM's loader (Exit to C128 BASIC, a 128-mode launch): BASIC 7's start-up message is on the screen and READY
+         * not printed yet. The drives go into its last line, after the bus scan that would otherwise wait for the first OPEN / LOAD /
+         * SAVE, so the numbers shown are the ones the drives keep. 40 columns: only if the row reads "ALL RIGHTS RESERVED"; 80 columns
+         * (the VDC's memory is not read): only with the cursor where the message leaves it, column 0 of row 5 or 6. */
+        if (e->machine != VV_M_C128 || c->a != VV_LAUNCH) { sc_ret(e, c, c->a, c->x, c->y, 0); DONE(c); }
+        PEEK(B_MODE, B_TBLX + 2 - B_MODE);
+        c->b0 = c->buf[0] & 0x80;
+        c->b1 = c->buf[B_TBLX - B_MODE]; c->left = c->buf[B_TBLX + 1 - B_MODE];
+        if (!c->b0) { PEEK(B_SCREEN40 + 40 * B_ROW, 40); c->scan = (uint8_t)(banner_on_row(c->buf) ? 2 : 0); }
+        else c->scan = (uint8_t)((c->b1 == 5 || c->b1 == 6) && c->left == 0 ? 2 : 0);
+        if (!c->scan) { sc_ret(e, c, c->a, c->x, c->y, 0); DONE(c); }
+    }
+
+    /* which numbers are free on the real bus: LISTEN + SECOND as OPEN does it (DESIGN.md 16), through the KERNAL. On the first OPEN,
+     * LOAD or SAVE of a run, or at the C128's launch INSTALL (the banner above) */
+    if (c->scan && v->scan_state == 1) {
+        v->scan_state = 3;
+        c->n = (uint8_t)tdrive_scan_begin(&v->vd);
+        for (c->dev = 8; c->n && c->dev < 31; c->dev++) {
+            sc_poke1(e, 0x90, 0);
+            CALL(K_LISTEN, c->dev, 0, 0);
+            if (!(c->rst & 0x80)) {
+                CALL(K_SECOND, 0x6F, 0, 0);
+                if (!(c->rst & 0x80)) { CALL(K_UNLSN, 0, 0, 0); continue; }
+            }
+            c->n = (uint8_t)tdrive_scan_free(&v->vd, c->dev);
+        }
+        vio_publish_devices(v);
+        sc_poke1(e, 0x90, c->st);
+    }
+
+    if (c->scan == 2) {               /* the C128's banner: print through the editor at row 4, then the cursor back */
+        c->n = banner_text(&v->vd, c->data);
+        CALL(K_PLOT, 0, B_ROW, c->b0 ? 21 : 1);
+        for (c->idx = 0; c->idx < c->n; c->idx++) CALL(ED_PRINT, c->data[c->idx], 0, 0);
+        CALL(K_PLOT, 0, c->b1, c->left);
+        sc_ret(e, c, c->a, c->x, c->y, 0);
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_MAIN) {      /* BASIC's READY loop (C128: its warm start): hook again after a RESTOR (RUN/STOP+RESTORE) */
+        PEEK(0x0330, 2);
+        if ((uint16_t)(c->buf[0] | c->buf[1] << 8) == e->old[VV_E_LOAD] && e->old[VV_E_LOAD] != target_of(e, VV_E_LOAD)) {
+            c->mainv = target_of(e, VV_E_MAIN);                      /* we came through it */
+            PEEK(0x0302, 0x34 - 0x02);
+            install(e, c);
+        }
+        CHAIN();
+    }
+
+    if (c->entry == VV_E_OPEN) {
+        if (c->fa < 4 || (c->sa & 0x80) || !c->fnlen || !ours(e, c->fa)) CHAIN();
+        MMU_READ();
+        /* the stock OPEN fills the file table; with the name length 0 it sends nothing */
+        sc_poke1(e, 0xB7, 0);
+        CALL(e->old[VV_E_OPEN], c->a, c->x, c->y);
+        sc_poke1(e, 0xB7, c->fnlen);
+        if (c->rp & P_C) { sc_ret(e, c, c->ra, c->rx, c->ry, 1); DONE(c); }   /* FILE OPEN, TOO MANY FILES, ... */
+        c->stx = 0;
+        bus(e, VD_LISTEN, c->fa, 0, &c->stx);
+        bus(e, VD_SECOND, (uint8_t)(c->sa | 0xF0), 0, &c->stx);           /* the table's SA is SA | $60 */
+        if (c->stx & 0x80) { bus(e, VD_UNLSN, 0, 0, 0); sc_poke1(e, 0x90, c->stx); ERROR(5); }
+        for (c->i = 0; c->i < c->fnlen; c->i = (uint16_t)(c->i + c->n)) {
+            c->n = (uint8_t)(c->fnlen - c->i > VV_CHUNK ? VV_CHUNK : c->fnlen - c->i);
+            BPEEK(c->fnbank, (uint16_t)(c->fnadr + c->i), c->n);
+            for (int j = 0; j < c->n; j++) bus(e, VD_CIOUT, c->buf[j], 0, &c->stx);
+        }
+        bus(e, VD_UNLSN, 0, 0, &c->stx);
+        sc_poke1(e, 0x90, c->stx);
+        sc_ret(e, c, c->a, c->x, c->y, 0);
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_CLOSE || c->entry == VV_E_CHKIN || c->entry == VV_E_CKOUT) {   /* CLOSE: A = logical file; CHKIN/CKOUT: X */
+        if (c->entry != VV_E_CLOSE) sc_poke1(e, 0x90, 0), c->st = 0;   /* as the stock lookup ($F30F) */
+        PEEK(KN->files, 30);                            /* LAT, FAT, SAT */
+        c->la = c->entry == VV_E_CLOSE ? c->a : c->x;
+        for (c->idx = c->nfiles; c->idx > 0 && c->buf[c->idx - 1] != c->la; c->idx--) {}
+        if (!c->idx || c->nfiles > 10) CHAIN();         /* not open: the stock routine reports it */
+        c->idx--;
+        c->fa = c->buf[10 + c->idx]; c->sa = c->buf[20 + c->idx];
+        if (!ours(e, c->fa)) CHAIN();
+        c->stx = 0;
+        if (c->entry == VV_E_CLOSE) {
+            if (c->sa & 0x80) CHAIN();
+            /* C128: CLOSE with C set leaves a drive's command channel open on the drive (stock $F1CF), as DCLOSE's U-commands need */
+            if (e->machine == VV_M_C128 && (c->p & P_C) && c->fa >= 8 && (c->sa & 0x0F) == 0x0F) CHAIN();
+            bus(e, VD_LISTEN, c->fa, 0, 0);
+            bus(e, VD_SECOND, (uint8_t)((c->sa & 0xEF) | 0xE0), 0, 0);
+            bus(e, VD_UNLSN, 0, 0, 0);
+            sc_poke1(e, (uint16_t)(KN->files + 20 + c->idx), (uint8_t)(c->sa | 0x80));   /* now the stock CLOSE only drops the entry */
+            CHAIN();
+        }
+        if (c->entry == VV_E_CHKIN) {
+            bus(e, VD_TALK, c->fa, 0, &c->stx);
+            if (!(c->sa & 0x80)) bus(e, VD_TKSA, c->sa, 0, &c->stx);
+        } else {
+            bus(e, VD_LISTEN, c->fa, 0, &c->stx);
+            if (!(c->sa & 0x80)) bus(e, VD_SECOND, c->sa, 0, &c->stx);
+        }
+        {
+            uint8_t z[3] = { c->la, c->sa, c->fa };
+            sc_poke(e, 0xB8, z, 3);
+        }
+        sc_poke1(e, 0x90, c->stx);
+        if (c->stx & 0x80) ERROR(5);
+        sc_poke1(e, c->entry == VV_E_CHKIN ? 0x99 : 0x9A, c->fa);
+        sc_ret(e, c, c->fa, c->x, c->y, 0);
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_CLRCH || c->entry == VV_E_CLALL) {
+        if (c->dflto >= 4 && !bus(e, VD_UNLSN, 0, 0, 0)) sc_poke1(e, 0x9A, 3);
+        if (c->dfltn >= 4 && !bus(e, VD_UNTLK, 0, 0, 0)) sc_poke1(e, 0x99, 0);
+        CHAIN();                                        /* the stock routine finds nothing of ours left to end */
+    }
+
+    if (c->entry == VV_E_BASIN) {                       /* also GETIN for devices 4 and up */
+        uint8_t d = 0, s = 0;
+        if (c->dfltn < 4 || c->st || bus(e, VD_ACPTR, 0, &d, &s)) CHAIN();   /* ST set: the stock code returns CR */
+        if (s) sc_poke1(e, 0x90, (uint8_t)(c->st | s));
+        sc_ret(e, c, d, c->x, c->y, 0);
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_BSOUT) {
+        uint8_t s = 0;
+        if (c->dflto < 4 || bus(e, VD_CIOUT, c->a, 0, &s)) CHAIN();
+        if (s) sc_poke1(e, 0x90, (uint8_t)(c->st | s));
+        sc_ret(e, c, c->a, c->x, c->y, 0);              /* A = the byte sent: BASIC's PRINT depends on it */
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_LOAD) {                        /* A = 0 load, 1 verify */
+        if (c->fa < 4 || !c->fnlen || !ours(e, c->fa)) CHAIN();
+        MMU_READ();
+        c->verify = c->a;
+        sc_poke1(e, 0x93, c->verify);
+        sc_poke1(e, 0x90, 0);
+        CALL(KN->searching, 0, 0, 0);
+        sc_poke1(e, 0xB9, 0x60);
+        c->stx = 0;
+        bus(e, VD_LISTEN, c->fa, 0, &c->stx);
+        bus(e, VD_SECOND, 0xF0, 0, &c->stx);
+        if (c->stx & 0x80) { bus(e, VD_UNLSN, 0, 0, 0); sc_poke1(e, 0x90, 0x80); ERROR(5); }
+        for (c->i = 0; c->i < c->fnlen; c->i = (uint16_t)(c->i + c->n)) {
+            c->n = (uint8_t)(c->fnlen - c->i > VV_CHUNK ? VV_CHUNK : c->fnlen - c->i);
+            BPEEK(c->fnbank, (uint16_t)(c->fnadr + c->i), c->n);
+            for (int j = 0; j < c->n; j++) bus(e, VD_CIOUT, c->buf[j], 0, 0);
+        }
+        bus(e, VD_UNLSN, 0, 0, 0);
+        c->stx = 0;
+        bus(e, VD_TALK, c->fa, 0, &c->stx);
+        bus(e, VD_TKSA, 0x60, 0, &c->stx);
+        {
+            uint8_t s0 = 0, s1 = 0;
+            bus(e, VD_ACPTR, 0, &c->b0, &s0);
+            if (s0 & 0x02) {                            /* nothing came: FILE NOT FOUND */
+                bus(e, VD_UNTLK, 0, 0, 0);
+                bus(e, VD_LISTEN, c->fa, 0, 0); bus(e, VD_SECOND, 0xE0, 0, 0); bus(e, VD_UNLSN, 0, 0, 0);
+                ERROR(4);
+            }
+            c->eoi = (s0 & 0x40) != 0;
+            c->b1 = 0;
+            if (!c->eoi) { bus(e, VD_ACPTR, 0, &c->b1, &s1); c->eoi = (s1 & 0x40) != 0; }
+        }
+        c->addr = c->sa ? (uint16_t)(c->b0 | c->b1 << 8) : c->cadr;   /* SA 0: the caller's address */
+        {
+            uint8_t z[2] = { (uint8_t)c->addr, (uint8_t)(c->addr >> 8) };   /* as stock: the C128's message copies it to $AC/$AD */
+            sc_poke(e, 0xAE, z, 2);
+        }
+        c->chunk = BANKED(c->ba) ? VV_CHUNK_B : VV_CHUNK;
+        CALL(KN->loading, 0, 0, 0);
+        c->stx = 0;
+        while (!c->eoi) {
+            c->n = 0;
+            while (c->n < c->chunk && !c->eoi) {
+                uint8_t s = 0, d = 0;
+                bus(e, VD_ACPTR, 0, &d, &s);
+                if (s & 0x02) { c->eoi = 1; c->stx |= 0x02; break; }   /* a read error (bad sector): the load ends here, ST $42 */
+                c->data[c->n++] = d;
+                if (s & 0x40) c->eoi = 1;
+            }
+            if (!c->n) break;
+            if (c->verify) {
+                BPEEK(c->ba, c->addr, c->n);
+                if (memcmp(c->buf, c->data, c->n)) c->stx |= 0x10;     /* VERIFY ERROR; the load goes on, as stock */
+            } else if (BANKED(c->ba)) {
+                sc_poke1(e, MMU_CR, vv_bank_cfg[c->ba & 15]);
+                sc_poke(e, c->addr, c->data, c->n);
+                sc_poke1(e, MMU_CR, c->mmu);
+                CONT();
+            } else {
+                sc_poke(e, c->addr, c->data, c->n);
+                CONT();
+            }
+            c->addr = (uint16_t)(c->addr + c->n);
+        }
+        bus(e, VD_UNTLK, 0, 0, 0);
+        bus(e, VD_LISTEN, c->fa, 0, 0); bus(e, VD_SECOND, 0xE0, 0, 0); bus(e, VD_UNLSN, 0, 0, 0);
+        {
+            uint8_t z[2] = { (uint8_t)c->addr, (uint8_t)(c->addr >> 8) };
+            sc_poke(e, 0xAE, z, 2);
+        }
+        sc_poke1(e, 0x90, (uint8_t)(0x40 | c->stx));
+        sc_ret(e, c, c->a, (uint8_t)c->addr, (uint8_t)(c->addr >> 8), 0);
+        DONE(c);
+    }
+
+    if (c->entry == VV_E_SAVE) {                        /* $C1/$C2 start, $AE/$AF end */
+        if (c->fa < 4 || !c->fnlen || !ours(e, c->fa)) CHAIN();
+        MMU_READ();
+        sc_poke1(e, 0xB9, 0x61);
+        c->stx = 0;
+        bus(e, VD_LISTEN, c->fa, 0, &c->stx);
+        bus(e, VD_SECOND, 0xF1, 0, &c->stx);
+        if (c->stx & 0x80) { bus(e, VD_UNLSN, 0, 0, 0); sc_poke1(e, 0x90, 0x80); ERROR(5); }
+        for (c->i = 0; c->i < c->fnlen; c->i = (uint16_t)(c->i + c->n)) {
+            c->n = (uint8_t)(c->fnlen - c->i > VV_CHUNK ? VV_CHUNK : c->fnlen - c->i);
+            BPEEK(c->fnbank, (uint16_t)(c->fnadr + c->i), c->n);
+            for (int j = 0; j < c->n; j++) bus(e, VD_CIOUT, c->buf[j], 0, 0);
+        }
+        bus(e, VD_UNLSN, 0, 0, 0);
+        CALL(KN->saving, 0, 0, 0);
+        bus(e, VD_LISTEN, c->fa, 0, 0);
+        bus(e, VD_SECOND, 0x61, 0, 0);
+        bus(e, VD_CIOUT, (uint8_t)c->addr, 0, 0);
+        bus(e, VD_CIOUT, (uint8_t)(c->addr >> 8), 0, 0);
+        while (c->addr < c->end) {
+            c->n = (uint8_t)(c->end - c->addr > VV_CHUNK ? VV_CHUNK : c->end - c->addr);
+            BPEEK(c->ba, c->addr, c->n);
+            for (int j = 0; j < c->n; j++) bus(e, VD_CIOUT, c->buf[j], 0, 0);
+            c->addr = (uint16_t)(c->addr + c->n);
+        }
+        bus(e, VD_UNLSN, 0, 0, 0);
+        bus(e, VD_LISTEN, c->fa, 0, 0); bus(e, VD_SECOND, 0xE1, 0, 0); bus(e, VD_UNLSN, 0, 0, 0);
+        sc_ret(e, c, c->a, c->x, c->y, 0);
+        DONE(c);
+    }
+
+    sc_ret(e, c, c->a, c->x, c->y, 0);
+    PT_END(c);
+}
+
+VD_COLD int vvec_poll(vvec_t *e)
+{
+    vio_hot_t *h = e->v->h;
+    if (!h->pending) return 0;
+    uint8_t cmd = h->cmd;
+    if (cmd != VV_C_VEC && cmd != VV_C_CONT) return vio_poll(e->v);
+    const uint8_t *w = h->window;
+    vv_ctx_t *c = 0;
+    e->sp = 0;
+    /* contexts that wait for anything but a ROM routine's result are left over (RUN/STOP+RESTORE in the middle of a handler) */
+    if (cmd == VV_C_VEC)
+        while (e->depth && e->c[e->depth - 1].wait != VV_W_CALL) e->depth--;
+    if (cmd == VV_C_VEC && w[4] == (uint8_t)(e->base + VV_OFS_CTRAMP + 5)) {   /* a ROM routine's result */
+        if (e->depth) {
+            c = &e->c[e->depth - 1];
+            c->ry = w[0]; c->rx = w[1]; c->ra = w[2]; c->rp = w[3]; c->rst = w[5];
+        }
+    } else if (cmd == VV_C_VEC) {
+        uint8_t k = (uint8_t)(w[4] - (uint8_t)(e->base + VV_OFS_ENTRIES + 2));
+        if (k % 3 == 0 && k / 3 < VV_NE) {
+            if (e->depth == VV_DEPTH) e->depth = 0;
+            c = &e->c[e->depth++];
+            memset((void *)c, 0, sizeof *c);
+            c->entry = (uint8_t)(k / 3);
+            c->mmu = 0xFF;
+            c->y = w[0]; c->x = w[1]; c->a = w[2]; c->p = w[3];
+            c->st = w[5]; c->nfiles = w[6]; c->dfltn = w[7]; c->dflto = w[8];
+        }
+    } else if (e->depth && e->c[e->depth - 1].wait == VV_W_DATA) {             /* PEEK data, or after CONT */
+        c = &e->c[e->depth - 1];
+        memcpy(c->buf, w, VIO_WIN);
+    }
+    if (!c) {
+        /* nothing to answer this (a frame from nowhere): return to the caller with C set */
+        vv_ctx_t z;
+        memset(&z, 0, sizeof z);
+        sc_ret(e, &z, 5, 0, 0, 1);
+    } else if (!vv_run(e, c)) {
+        e->depth--;                                     /* finished: it was the top */
+    }
+    h->pending = 0;
+    h->stat = VIO_OK;
+    return 1;
+}
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.h b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.h
new file mode 100644
index 0000000..442ff6a
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/tdrive_vec.h
@@ -0,0 +1,78 @@
+/* Vector engine for the plain TeensyROM (docs/DESIGN.md 53): the Teensy side of the 6502 agent in vector/vdagent.s.
+ *
+ * The KERNAL's RAM vectors point into the agent, which the Teensy serves from an IO page. Each call arrives here as a frame
+ * (the registers and a few zero-page bytes, in the mailbox window, command VV_C_VEC); the answer is a short script for the agent:
+ * POKE / PEEK C64 memory, CONT (more to come) and GO (load the registers and jump: return, chain to the vector we replaced,
+ * a KERNAL error exit, or a call of a ROM routine whose result comes back as a frame). OPEN..SAVE, the file table and the
+ * serial-bus scan are done here, on top of the byte-level drive (tdrive_mailbox); "not ours" chains to the old vector.
+ *
+ * Handlers are protothreads: one that needs memory or a ROM call yields and goes on when the agent's next frame arrives.
+ * A call that comes in while another waits for a ROM routine (that routine printed through CHROUT, or failed into CLRCHN) runs
+ * on a context of its own above it. */
+#ifndef TDRIVE_VEC_H
+#define TDRIVE_VEC_H
+#include "tdrive_io.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { VV_C_VEC = 20, VV_C_CONT = 21 };                        /* agent -> Teensy commands (after VIO_FVERIFY_OPEN = 19) */
+enum { VV_OP_GO = 0, VV_OP_POKE = 1, VV_OP_PEEK = 2, VV_OP_CONT = 4 };
+
+/* the agent's entries, in its order */
+enum { VV_E_INSTALL, VV_E_OPEN, VV_E_CLOSE, VV_E_CHKIN, VV_E_CKOUT, VV_E_CLRCH, VV_E_BASIN, VV_E_BSOUT, VV_E_CLALL,
+       VV_E_LOAD, VV_E_SAVE, VV_E_MAIN, VV_NE };
+
+/* the agent's layout (asserted in vector/vdagent.s) */
+#define VV_OFS_CTRAMP   0       /* JSR $xxxx (the routine of a CALL), then JSR enter: the result */
+#define VV_OFS_OLD      6       /* old_bsout, old_basin, old_getin: the fast paths' chain targets */
+#define VV_OFS_ENTRIES  12      /* VV_NE x JSR enter */
+#define VV_OFS_F_BSOUT  48
+#define VV_OFS_F_BASIN  59
+#define VV_OFS_F_GETIN  70
+#define VV_OFS_RTS      241
+#define VV_NZ           4       /* zero-page bytes in the frame: $90 $98 $99 $9A */
+
+#define VV_LAUNCH 0xA5          /* A at INSTALL from the menu's PRG loader: hook only vectors the program left as the ROM set them */
+#define VV_DEPTH 4              /* nested calls (a ROM routine calling back into a vector) */
+#define VV_CHUNK 118            /* bytes per POKE / PEEK of file data */
+#define VV_CHUNK_B 108          /* the same into another C128 bank: the two $FF00 POKEs around it share the window */
+
+typedef struct {
+    uint16_t pc;                /* protothread resume point (0 = start) */
+    uint8_t  entry, wait;       /* wait: VV_W_* */
+    uint8_t  y, x, a, p;        /* the registers at the call */
+    uint8_t  st, nfiles, dfltn, dflto;
+    uint8_t  ry, rx, ra, rp, rst;   /* the last CALL's result and ST after it */
+    uint8_t  buf[VIO_WIN];      /* the last PEEK */
+    /* handler state */
+    uint8_t  fnlen, la, sa, fa, verify, idx, n, dev, eoi, stx, b0, b1, left;
+    uint8_t  scan;              /* 1: run the bus scan if it is still due; 2: the same, then the C128's banner line (INSTALL) */
+    uint8_t  ba, fnbank, mmu, chunk;    /* C128: the data and name banks ($C6 / $C7), the caller's $FF00 (0xFF = not read yet),
+                                           bytes per file-data POKE / PEEK */
+    uint16_t fnadr, addr, end, cadr, i, mainv;   /* mainv: the re-hook vector's value, where it is not in $0302-$0333 (C128) */
+    uint8_t  data[VIO_WIN];
+} vv_ctx_t;
+
+/* the machine whose KERNAL the agent hooks (docs/DESIGN.md 56): a C64 (or a C128 in C64 mode), or a C128 in 128 mode */
+enum { VV_M_C64, VV_M_C128 };
+
+typedef struct {
+    vio_t   *v;
+    uint16_t base;              /* the agent's address */
+    uint8_t  machine;           /* VV_M_*: which KERNAL's addresses (vvec_set_machine) */
+    uint16_t old[VV_NE + 1];    /* the vectors we replaced, per entry; [VV_NE] = GETIN (fast path only) */
+    uint8_t  depth, sp;
+    vv_ctx_t c[VV_DEPTH];
+} vvec_t;
+
+void   vvec_init(vvec_t *e, vio_t *v, uint16_t base);   /* a C64 */
+void   vvec_set_machine(vvec_t *e, uint8_t machine);    /* INSTALL sets it from the KERNAL it finds; tests set it beforehand */
+int    vvec_poll(vvec_t *e);    /* the agent's commands; anything else goes to vio_poll. 1 if a command was processed */
+size_t vvec_sizeof(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/tdrive/vd_agent.h b/Source/Teensy/MinimalBoot/Common/tdrive/vd_agent.h
new file mode 100644
index 0000000..751a650
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/tdrive/vd_agent.h
@@ -0,0 +1,23 @@
+// The plain TeensyROM's agent (teensyrom-vdrive vector/vdagent.s), generated by tools/build_agent.py: served from IO1
+// at VD_AgentBase, mailbox registers at IO2 $DF00, window at $DF80 (docs/DESIGN.md 53).
+#pragma once
+#define VD_AgentBase 0xDE08
+#define VD_AgentRegs 0x00   // IO2 offset of the registers
+static const uint8_t VD_Agent[246] PROGMEM = {
+   0x20, 0xff, 0xff, 0x20, 0x59, 0xde, 0xca, 0xf1, 0x57, 0xf1, 0x3e, 0xf1, 0x20, 0x59, 0xde, 0x20,
+   0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59,
+   0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde, 0x20, 0x59, 0xde,
+   0x48, 0xa5, 0x9a, 0xc9, 0x04, 0x68, 0xb0, 0xe9, 0x6c, 0x0e, 0xde, 0x48, 0xa5, 0x99, 0xc9, 0x04,
+   0x68, 0xb0, 0xdb, 0x6c, 0x10, 0xde, 0x48, 0xa5, 0x99, 0xc9, 0x04, 0x68, 0xb0, 0xd0, 0x6c, 0x12,
+   0xde, 0x08, 0x48, 0x8a, 0x48, 0x98, 0x48, 0xa0, 0x05, 0xa2, 0x00, 0x68, 0x20, 0xf1, 0xde, 0xe8,
+   0x88, 0xd0, 0xf8, 0x68, 0xbc, 0xf5, 0xde, 0xb9, 0x00, 0x00, 0x20, 0xf1, 0xde, 0xe8, 0xe0, 0x09,
+   0xd0, 0xf2, 0xa9, 0x14, 0x8d, 0x00, 0xdf, 0xad, 0x03, 0xdf, 0xc9, 0x5a, 0xd0, 0xf9, 0xa2, 0x00,
+   0x20, 0xe7, 0xde, 0x4a, 0xb0, 0x1a, 0x4a, 0xb0, 0x33, 0xd0, 0x50, 0x20, 0xe7, 0xde, 0xa8, 0x20,
+   0xe7, 0xde, 0x48, 0x20, 0xe7, 0xde, 0x48, 0x20, 0xe7, 0xde, 0xaa, 0x68, 0x28, 0x6c, 0xfe, 0xdf,
