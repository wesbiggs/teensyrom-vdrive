diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/d64.c b/Source/Teensy/MinimalBoot/Common/vdrive/d64.c
new file mode 100644
index 0000000..b8e1694
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/d64.c
@@ -0,0 +1,688 @@
+#include "d64.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+/* sectors per track of a 1541 (also each side of a 1571) */
+VD_COLD static int spt35(uint8_t t)
+{
+    if (t >= 1 && t <= 17)  return 21;
+    if (t >= 18 && t <= 24) return 19;
+    if (t >= 25 && t <= 30) return 18;
+    if (t >= 31 && t <= 40) return 17;
+    return 0;
+}
+
+VD_COLD static int spt(const d64_t *d, uint8_t t)
+{
+    if (d->fmt == D64_FMT_D81) return (t >= 1 && t <= 80) ? 40 : 0;
+    if (d->fmt == D64_FMT_D71) return t > 35 ? (t <= 70 ? spt35((uint8_t)(t - 35)) : 0) : spt35(t);
+    return spt35(t);
+}
+VD_COLD int d64_sectors_in_track(const d64_t *d, uint8_t t) { return spt(d, t); }
+
+VD_COLD long d64_sector_offset(const d64_t *d, uint8_t t, uint8_t s)
+{
+    if (t < 1 || t > d->tracks || s >= spt(d, t)) return -1;
+    long off = 0;
+    if (d->fmt == D64_FMT_D81) off = (long)(t - 1) * 40;
+    else for (uint8_t i = 1; i < t; i++) off += spt(d, i);
+    return (off + s) * D64_SECTOR;
+}
+
+/* file size -> format and track count (images may carry one error byte per sector after the data) */
+VD_COLD static int classify(size_t len, uint8_t *tracks, uint8_t *fmt)
+{
+    if (len >= 819200)      { *fmt = D64_FMT_D81; *tracks = 80; }
+    else if (len >= 349696) { *fmt = D64_FMT_D71; *tracks = 70; }
+    else if (len >= 196608) { *fmt = D64_FMT_D64; *tracks = 40; }
+    else if (len >= 174848) { *fmt = D64_FMT_D64; *tracks = 35; }
+    else return -1;
+    return 0;
+}
+
+VD_COLD static void geometry(d64_t *d, uint8_t tracks)
+{
+    d->fmt = tracks == 80 ? D64_FMT_D81 : tracks == 70 ? D64_FMT_D71 : D64_FMT_D64;
+    d->tracks = tracks == 80 || tracks == 70 || tracks == 40 ? tracks : 35;
+}
+
+VD_COLD static int mem_write(void *ctx, uint8_t t, uint8_t s, const uint8_t *buf)
+{
+    d64_mem_t *m = (d64_mem_t *)ctx;
+    d64_t tmp = { 0, 0, 0, 0, 0 };
+    if (classify(m->len, &tmp.tracks, &tmp.fmt)) return -1;
+    long off = d64_sector_offset(&tmp, t, s);
+    if (off < 0 || (size_t)off + D64_SECTOR > m->len) return -1;
+    memcpy(m->data + off, buf, D64_SECTOR);
+    return 0;
+}
+
+VD_COLD static int mem_read(void *ctx, uint8_t t, uint8_t s, uint8_t *buf)
+{
+    d64_mem_t *m = (d64_mem_t *)ctx;
+    d64_t tmp = { 0, 0, 0, 0, 0 };
+    if (classify(m->len, &tmp.tracks, &tmp.fmt)) return -1;
+    long off = d64_sector_offset(&tmp, t, s);
+    if (off < 0 || (size_t)off + D64_SECTOR > m->len) return -1;
+    memcpy(buf, m->data + off, D64_SECTOR);
+    return 0;
+}
+VD_COLD void d64_mem_init(d64_mem_t *m, uint8_t *data, size_t len) { m->data = data; m->len = len; }
+VD_COLD int d64_open(d64_t *d, d64_read_fn rd, void *ctx, uint8_t tracks)
+{
+    d->read = rd; d->write = NULL; d->ctx = ctx;
+    geometry(d, tracks);
+    return 0;
+}
+VD_COLD int d64_open_size(d64_t *d, d64_read_fn rd, void *ctx, size_t size)
+{
+    uint8_t tracks, fmt;
+    if (classify(size, &tracks, &fmt)) return -1;
+    return d64_open(d, rd, ctx, tracks);
+}
+VD_COLD int d64_open_mem(d64_t *d, d64_mem_t *m)
+{
+    int r = d64_open_size(d, mem_read, m, m->len);
+    if (r) return r;
+    d->write = mem_write;
+    return 0;
+}
+
+VD_COLD static int rd(d64_t *d, uint8_t t, uint8_t s, uint8_t *b)
+{
+    if (d64_sector_offset(d, t, s) < 0) return D64_E_IO;
+    return d->read(d->ctx, t, s, b) ? D64_E_IO : 0;
+}
+VD_COLD static int wr(d64_t *d, uint8_t t, uint8_t s, const uint8_t *b)
+{
+    if (!d->write) return D64_E_RO;
+    if (d64_sector_offset(d, t, s) < 0) return D64_E_IO;
+    return d->write(d->ctx, t, s, b) ? D64_E_IO : 0;
+}
+
+/* ---- layout of the three formats ----
+ *   d64: header + BAM 18/0 (name $90, id $A2, DOS $A5), directory 18/1.., 4 bytes per track at $04 (count + 3 bitmap bytes)
+ *   d71: as d64 for tracks 1-35, flag $80 at 18/0 byte 3; side 2 counts at 18/0 $DD.., bitmaps (3 bytes per track) in 53/0
+ *   d81: header 40/0 (name $04, id $16, DOS $19), BAM 40/1 (tracks 1-40) and 40/2 (41-80), 6 bytes per track from $10
+ *        (count + 5 bitmap bytes), directory 40/3..
+ * A set bitmap bit = free sector; sector s is bit (s % 8) of byte (s / 8). */
+/* a file can't have more sectors than the disk: longer chains are loops */
+VD_COLD static uint16_t chain_limit(const d64_t *d) { return d->fmt == D64_FMT_D81 ? 3300 : d->fmt == D64_FMT_D71 ? 1400 : 800; }
+VD_COLD static uint8_t dir_track(const d64_t *d) { return d->fmt == D64_FMT_D81 ? 40 : 18; }
+VD_COLD static uint8_t dir_sector0(const d64_t *d) { return d->fmt == D64_FMT_D81 ? 3 : 1; }   /* first directory sector */
+VD_COLD static uint8_t bam_tracks(const d64_t *d) { return d->fmt == D64_FMT_D81 ? 80 : d->fmt == D64_FMT_D71 ? 70 : 35; }
+VD_COLD static uint8_t bam_reserved(const d64_t *d, uint8_t t)   /* tracks never given to files: directory (and the d71 side-2 BAM) */
+{
+    return t == dir_track(d) || (d->fmt == D64_FMT_D71 && t == 53);
+}
+
+typedef struct { uint8_t ct, cs, co, bt, bs, bo, nb; } bamloc_t;   /* count byte at (ct,cs)+co, bitmap at (bt,bs)+bo, nb bytes */
+
+VD_COLD static void bam_loc(const d64_t *d, uint8_t t, bamloc_t *b)
+{
+    if (d->fmt == D64_FMT_D81) {
+        uint8_t u = t > 40 ? (uint8_t)(t - 40) : t;
+        b->ct = b->bt = 40; b->cs = b->bs = t > 40 ? 2 : 1;
+        b->co = (uint8_t)(16 + 6 * (u - 1)); b->bo = (uint8_t)(b->co + 1); b->nb = 5;
+    } else if (d->fmt == D64_FMT_D71 && t > 35) {
+        b->ct = 18; b->cs = 0; b->co = (uint8_t)(0xDD + (t - 36));
+        b->bt = 53; b->bs = 0; b->bo = (uint8_t)(3 * (t - 36)); b->nb = 3;
+    } else {
+        b->ct = b->bt = 18; b->cs = b->bs = 0;
+        b->co = (uint8_t)(4 * t); b->bo = (uint8_t)(4 * t + 1); b->nb = 3;
+    }
+}
+
+/* Read the BAM sector(s) for track t; *cnt / *bits point into bufA / bufB. */
+VD_COLD static int bam_load(d64_t *d, uint8_t t, bamloc_t *L, uint8_t *bufA, uint8_t *bufB, uint8_t **cnt, uint8_t **bits)
+{
+    bam_loc(d, t, L);
+    int r = rd(d, L->bt, L->bs, bufA);
+    if (r) return r;
+    *bits = bufA + L->bo;
+    if (L->ct == L->bt && L->cs == L->bs) { *cnt = bufA + L->co; return 0; }
+    if ((r = rd(d, L->ct, L->cs, bufB))) return r;
+    *cnt = bufB + L->co;
+    return 0;
+}
+
+VD_COLD static int bam_store(d64_t *d, const bamloc_t *L, const uint8_t *bufA, const uint8_t *bufB)
+{
+    int r = wr(d, L->bt, L->bs, bufA);
+    if (r) return r;
+    if (L->ct != L->bt || L->cs != L->bs) r = wr(d, L->ct, L->cs, bufB);
+    return r;
+}
+
+VD_COLD static void strip(char *dst, const uint8_t *src, int n)
+{
+    int len = n;
+    while (len > 0 && src[len - 1] == 0xA0) len--;
+    memcpy(dst, src, len);
+    dst[len] = 0;
+}
+
+VD_COLD int d64_header(d64_t *d, char name[17], char id[3], char dos[3])
+{
+    uint8_t b[D64_SECTOR];
+    int n = d->fmt == D64_FMT_D81 ? 0x04 : 0x90, i = d->fmt == D64_FMT_D81 ? 0x16 : 0xA2, o = d->fmt == D64_FMT_D81 ? 0x19 : 0xA5;
+    if (rd(d, dir_track(d), 0, b)) return -1;
+    strip(name, b + n, 16);
+    id[0] = b[i]; id[1] = b[i + 1]; id[2] = 0;
+    dos[0] = b[o]; dos[1] = b[o + 1]; dos[2] = 0;
+    return 0;
+}
+
+VD_COLD int d64_blocks_free(d64_t *d)
+{
+    uint8_t b[D64_SECTOR], held_t = 0, held_s = 0xFF;
+    int free_ = 0;
+    for (uint8_t t = 1; t <= bam_tracks(d); t++) {
+        bamloc_t L;
+        bam_loc(d, t, &L);
+        if (L.ct != held_t || L.cs != held_s) { if (rd(d, L.ct, L.cs, b)) return -1; held_t = L.ct; held_s = L.cs; }
+        if (!bam_reserved(d, t)) free_ += b[L.co];
+    }
+    return free_;
+}
+
+VD_COLD int d64_dir_first(d64_t *d, d64_dir_t *it)
+{
+    uint8_t b[D64_SECTOR];
+    if (rd(d, dir_track(d), 0, b)) return -1;
+    it->track = b[0] ? b[0] : dir_track(d);
+    it->sector = b[0] ? b[1] : dir_sector0(d);
+    it->slot = 8;               /* force load on first next() */
+    it->guard = 0;
+    return 0;
+}
+
+VD_COLD int d64_dir_next(d64_t *d, d64_dir_t *it, d64_entry_t *e)
+{
+    for (;;) {
+        if (it->slot >= 8) {
+            if (it->track == 0) return 0;
+            if (++it->guard > 64) return -2;               /* loop in chain */
+            if (rd(d, it->track, it->sector, it->buf)) return -1;
+            it->cur_t = it->track; it->cur_s = it->sector;
+            it->track = it->buf[0]; it->sector = it->buf[1];   /* next sector in chain */
+            it->slot = 0;
+        }
+        const uint8_t *p = it->buf + it->slot * 32;
+        it->slot++;
+        if (p[2] == 0) continue;                           /* scratched / empty */
+        e->type = p[2];
+        e->track = p[3]; e->sector = p[4];
+        e->blocks = p[30] | (p[31] << 8);
+        strip(e->name, p + 5, 16);
+        e->dir_t = it->cur_t; e->dir_s = it->cur_s; e->dir_slot = (uint8_t)(it->slot - 1);
+        return 1;
+    }
+}
+
+VD_COLD int d64_match(const char *name, const char *pat)
+{
+    for (;; name++, pat++) {
+        if (*pat == '*') return 1;
+        if (*pat == 0) return *name == 0;
+        if (*name == 0) return 0;
+        if (*pat != '?' && *pat != *name) return 0;
+    }
+}
+
+VD_COLD int d64_find(d64_t *d, const char *pat, d64_entry_t *e)
+{
+    d64_dir_t it;
+    int r = d64_dir_first(d, &it);
+    if (r) return r;
+    while ((r = d64_dir_next(d, &it, e)) > 0)
+        if ((e->type & 7) != 0 || (e->type & 0x80)) if (d64_match(e->name, pat)) return 1;
+    return r;
+}
+
+VD_COLD int d64_file_open(d64_t *d, const d64_entry_t *e, d64_file_t *f)
+{
+    (void)d;
+    f->next_t = e->track; f->next_s = e->sector;
+    f->loaded = 0; f->pos = f->end = 0; f->guard = 0;
+    return 0;
+}
+
+VD_COLD int d64_file_eof(const d64_file_t *f)
+{
+    return f->pos >= f->end && f->next_t == 0;
+}
+
+VD_COLD int d64_file_read(d64_t *d, d64_file_t *f, uint8_t *out, size_t n)
+{
+    size_t got = 0;
+    while (got < n) {
+        if (f->pos >= f->end) {
+            if (f->next_t == 0) break;                       /* EOF (or empty file) */
+            if (++f->guard > chain_limit(d)) return -2;      /* chain loop */
+            if (rd(d, f->next_t, f->next_s, f->buf)) return -1;
+            uint8_t lt = f->buf[0], ls = f->buf[1];
+            f->pos = 2;
+            f->end = lt ? 256 : (uint16_t)(ls < 1 ? 2 : ls + 1);   /* last sector: ls = index of last used byte */
+            f->next_t = lt; f->next_s = ls;
+            f->loaded = 1;
+            continue;
+        }
+        size_t c = (size_t)(f->end - f->pos);
+        if (c > n - got) c = n - got;
+        memcpy(out + got, f->buf + f->pos, c);
+        f->pos = (uint16_t)(f->pos + c); got += c;
+    }
+    return (int)got;
+}
+
+/* ---- write support ------------------------------------------------------ */
+
+/* allocation order: nearest the directory first, one side then the other; 0 = exhausted */
+VD_COLD static int next_data_track(const d64_t *d, uint8_t t)
+{
+    if (d->fmt == D64_FMT_D81) {
+        if (t == 0) return 39;
+        if (t >= 2 && t <= 39) return t - 1;
+        if (t == 1) return 41;
+        if (t >= 41 && t <= 79) return t + 1;
+        return 0;
+    }
+    if (t == 0) return 17;
+    if (t >= 2 && t <= 17) return t - 1;
+    if (t == 1) return 19;
+    if (t >= 19 && t <= 34) return t + 1;
+    if (d->fmt == D64_FMT_D71) {
+        if (t == 35) return 52;
+        if (t >= 37 && t <= 52) return t - 1;
+        if (t == 36) return 54;
+        if (t >= 54 && t <= 69) return t + 1;
+    }
+    return 0;
+}
+
+/* Allocate one sector. In: *t,*s = hint (t==0: none). dirmode: the directory track only, never sector 0. */
+VD_COLD static int alloc_sector(d64_t *d, uint8_t *t, uint8_t *s, int interleave, int dirmode)
+{
+    uint8_t bufA[D64_SECTOR], bufB[D64_SECTOR], *cnt, *bits;
+    bamloc_t L;
+    uint8_t tr; int hint;
+    if (dirmode)   { tr = dir_track(d); hint = (*t == tr) ? *s + interleave : dir_sector0(d); }
+    else if (*t)   { tr = *t; hint = *s + interleave; }
+    else           { tr = (uint8_t)next_data_track(d, 0); hint = 0; }
+    for (;;) {
+        if (tr == 0 || tr > bam_tracks(d)) return D64_E_FULL;
+        if (dirmode || !bam_reserved(d, tr)) {
+            int r = bam_load(d, tr, &L, bufA, bufB, &cnt, &bits);
+            if (r) return r;
+            if (*cnt > 0) {
+                int n = spt(d, tr);
+                for (int i = 0; i < n; i++) {
+                    int sec = (hint + i) % n;
+                    if (dirmode && sec == 0) continue;
+                    if (bits[sec / 8] & (1 << (sec % 8))) {
+                        bits[sec / 8] &= (uint8_t)~(1 << (sec % 8));
+                        (*cnt)--;
+                        r = bam_store(d, &L, bufA, bufB);
+                        if (r) return r;
+                        *t = tr; *s = (uint8_t)sec;
+                        return 0;
+                    }
+                }
+            }
+        }
+        if (dirmode) return D64_E_FULL;
+        tr = (uint8_t)next_data_track(d, tr);
+        hint = 0;
+    }
+}
+
+VD_COLD static int free_sector(d64_t *d, uint8_t t, uint8_t s)
+{
+    uint8_t bufA[D64_SECTOR], bufB[D64_SECTOR], *cnt, *bits;
+    bamloc_t L;
+    if (t < 1 || t > bam_tracks(d) || s >= spt(d, t)) return D64_E_IO;
+    int r = bam_load(d, t, &L, bufA, bufB, &cnt, &bits);
+    if (r) return r;
+    uint8_t bit = (uint8_t)(1 << (s % 8)), *p = &bits[s / 8];
+    if (!(*p & bit)) { *p |= bit; (*cnt)++; }
+    return bam_store(d, &L, bufA, bufB);
+}
+
+VD_COLD static int valid_name(const char *n)
+{
+    size_t l = strlen(n);
+    if (l < 1 || l > 16) return 0;
+    for (; *n; n++) if (*n == '*' || *n == '?' || *n == ',' || *n == ':' || *n == '=' || *n == '"') return 0;
+    return 1;
+}
+
+/* Update directory entry bytes in place. */
+VD_COLD static int dir_update(d64_t *d, uint8_t dt, uint8_t ds, uint8_t slot, const uint8_t *entry30 /* NULL: leave */,
+                      int type, int blocks)
+{
+    uint8_t b[D64_SECTOR];
+    int r = rd(d, dt, ds, b);
+    if (r) return r;
+    uint8_t *p = b + slot * 32;
+    if (entry30) memcpy(p + 2, entry30, 30);
+    if (type >= 0) p[2] = (uint8_t)type;
+    if (blocks >= 0) { p[30] = (uint8_t)blocks; p[31] = (uint8_t)(blocks >> 8); }
+    return wr(d, dt, ds, b);
+}
+
+VD_COLD int d64_scratch_entry(d64_t *d, const d64_entry_t *e)
+{
+    if (!d->write) return D64_E_RO;
+    if (e->type & 0x40) return D64_E_LOCKED;
+    uint8_t t = e->track, s = e->sector, b[D64_SECTOR];
+    for (int guard = 0; t && guard < chain_limit(d); guard++) {
+        int r = rd(d, t, s, b);
+        if (r) break;                       /* broken chain: free what we can */
+        uint8_t nt = b[0], ns = b[1];
+        if ((r = free_sector(d, t, s))) return r;
+        t = nt; s = ns;
+    }
+    return dir_update(d, e->dir_t, e->dir_s, e->dir_slot, NULL, 0, -1);
+}
+
+VD_COLD int d64_scratch(d64_t *d, const char *pat)
+{
+    d64_dir_t it; d64_entry_t e;
+    int r = d64_dir_first(d, &it), n = 0;
+    if (r) return r;
+    while ((r = d64_dir_next(d, &it, &e)) > 0) {
+        if (!d64_match(e.name, pat)) continue;
+        r = d64_scratch_entry(d, &e);
+        if (r == D64_E_LOCKED) continue;
+        if (r) return r;
+        n++;
+    }
+    return r < 0 ? r : n;
+}
+
+VD_COLD int d64_rename(d64_t *d, const char *oldn, const char *newn)
+{
+    d64_entry_t e, x;
+    if (!valid_name(newn)) return D64_E_NAME;
+    if (!d->write) return D64_E_RO;
+    int r = d64_find(d, oldn, &e);
+    if (r < 0) return r;
+    if (r == 0) return D64_E_NOTFOUND;
+    if ((r = d64_find(d, newn, &x)) < 0) return r;
+    if (r == 1) return D64_E_EXISTS;
+    uint8_t b[D64_SECTOR];
+    if ((r = rd(d, e.dir_t, e.dir_s, b))) return r;
+    uint8_t *p = b + e.dir_slot * 32 + 5;
+    size_t l = strlen(newn);
+    memset(p, 0xA0, 16); memcpy(p, newn, l);
+    return wr(d, e.dir_t, e.dir_s, b);
+}
+
+/* Find a free directory slot, extending the directory if necessary. */
+VD_COLD static int dir_slot_alloc(d64_t *d, uint8_t *dt, uint8_t *ds, uint8_t *slot)
+{
+    uint8_t b[D64_SECTOR], t, s;
+    int r = rd(d, dir_track(d), 0, b);
+    if (r) return r;
+    t = b[0] ? b[0] : dir_track(d); s = b[0] ? b[1] : dir_sector0(d);
+    for (int guard = 0; guard < 64; guard++) {
+        if ((r = rd(d, t, s, b))) return r;
+        for (int i = 0; i < 8; i++)
+            if (b[i * 32 + 2] == 0) { *dt = t; *ds = s; *slot = (uint8_t)i; return 0; }
+        if (b[0] == 0) {                       /* last dir sector, full: extend */
+            uint8_t nt = t, ns = s;
+            if ((r = alloc_sector(d, &nt, &ns, 3, 1))) return r;
+            b[0] = nt; b[1] = ns;
+            if ((r = wr(d, t, s, b))) return r;
+            memset(b, 0, sizeof b); b[1] = 0xFF;
+            if ((r = wr(d, nt, ns, b))) return r;
+            *dt = nt; *ds = ns; *slot = 0;
+            return 0;
+        }
+        t = b[0]; s = b[1];
+    }
+    return D64_E_LOOP;
+}
+
+VD_COLD int d64_create(d64_t *d, const char *name, uint8_t type, int replace, d64_wfile_t *w)
+{
+    d64_entry_t e;
+    if (!d->write) return D64_E_RO;
+    if (!valid_name(name)) return D64_E_NAME;
+    int r = d64_find(d, name, &e);
+    if (r < 0) return r;
+    if (r == 1) {
+        if (!replace) return D64_E_EXISTS;
+        if ((r = d64_scratch_entry(d, &e))) return r;
+    }
+    uint8_t ft = 0, fs = 0, dt, ds, slot;
+    if ((r = alloc_sector(d, &ft, &fs, 10, 0))) return r;
+    if ((r = dir_slot_alloc(d, &dt, &ds, &slot))) { free_sector(d, ft, fs); return r; }
+
+    uint8_t ent[30];
+    memset(ent, 0, sizeof ent);
+    ent[0] = type & 7;                         /* unclosed until close */
+    ent[1] = ft; ent[2] = fs;
+    memset(ent + 3, 0xA0, 16); memcpy(ent + 3, name, strlen(name));
+    if ((r = dir_update(d, dt, ds, slot, ent, -1, -1))) { free_sector(d, ft, fs); return r; }
+
+    w->type = type & 7; w->dir_t = dt; w->dir_s = ds; w->dir_slot = slot;
+    w->first_t = w->cur_t = ft; w->first_s = w->cur_s = fs;
+    w->pos = 2; w->blocks = 1;
+    memset(w->buf, 0, sizeof w->buf);
+    return 0;
+}
+
+VD_COLD static void abort_write(d64_t *d, d64_wfile_t *w)
+{   /* free exactly the sectors we allocated, then drop the directory entry */
+    uint8_t t = w->first_t, s = w->first_s, b[D64_SECTOR];
+    for (int i = 0; i < w->blocks; i++) {
+        uint8_t nt = 0, ns = 0;
+        if (i + 1 < w->blocks && rd(d, t, s, b) == 0) { nt = b[0]; ns = b[1]; }
+        free_sector(d, t, s);
+        if (!nt) break;
+        t = nt; s = ns;
+    }
+    dir_update(d, w->dir_t, w->dir_s, w->dir_slot, NULL, 0, -1);
+}
+
+VD_COLD int d64_write(d64_t *d, d64_wfile_t *w, const uint8_t *data, size_t n)
+{
+    for (size_t i = 0; i < n; i++) {
+        if (w->pos == D64_SECTOR) {
+            uint8_t nt = w->cur_t, ns = w->cur_s;
+            int r = alloc_sector(d, &nt, &ns, 10, 0);
+            if (r == 0) {
+                w->buf[0] = nt; w->buf[1] = ns;
+                r = wr(d, w->cur_t, w->cur_s, w->buf);
+                if (r) free_sector(d, nt, ns);       /* don't leak the sector we just took */
+            }
+            if (r) { abort_write(d, w); return r; }
+            w->cur_t = nt; w->cur_s = ns; w->blocks++;
+            memset(w->buf, 0, sizeof w->buf);
+            w->pos = 2;
+        }
+        w->buf[w->pos++] = data[i];
+    }
+    return (int)n;
+}
+
+VD_COLD int d64_close_write(d64_t *d, d64_wfile_t *w)
+{
+    w->buf[0] = 0; w->buf[1] = (uint8_t)(w->pos - 1);   /* index of last used byte */
+    int r = wr(d, w->cur_t, w->cur_s, w->buf);
+    if (r) return r;
+    return dir_update(d, w->dir_t, w->dir_s, w->dir_slot, NULL, 0x80 | w->type, w->blocks);
+}
+
+VD_COLD int d64_format(d64_t *d, const char *name, const char *id)
+{
+    uint8_t b[D64_SECTOR];
+    uint8_t idb[2];
+    const int d81 = d->fmt == D64_FMT_D81, d71 = d->fmt == D64_FMT_D71;
+    const uint8_t dt = dir_track(d);
+    const int name_off = d81 ? 0x04 : 0x90, id_off = d81 ? 0x16 : 0xA2;
+    if (!d->write) return D64_E_RO;
+    if (!valid_name(name)) return D64_E_NAME;
+    if (id) {
+        if (strlen(id) != 2) return D64_E_NAME;
+        idb[0] = (uint8_t)id[0]; idb[1] = (uint8_t)id[1];
+        memset(b, 0, sizeof b);
+        for (uint8_t t = 1; t <= d->tracks; t++)
+            for (int sct = 0; sct < spt(d, t); sct++)
+                if (t != dt || sct > (d81 ? 3 : 1)) { int r = wr(d, t, (uint8_t)sct, b); if (r) return r; }
+    } else {
+        int r = rd(d, dt, 0, b);
+        if (r) return r;
+        idb[0] = b[id_off]; idb[1] = b[id_off + 1];
+    }
+    /* BAM: every sector free, then the system sectors taken */
+    uint8_t bam[3][D64_SECTOR];                                 /* d64/d71: [0] = 18/0, [1] = 53/0.  d81: [1] = 40/1, [2] = 40/2 */
+    memset(bam, 0, sizeof bam);
+    for (uint8_t t = 1; t <= bam_tracks(d); t++) {
+        bamloc_t L;
+        bam_loc(d, t, &L);
+        uint8_t *cs = bam[d81 ? L.cs : (L.ct == 18 ? 0 : 1)], *bs = bam[d81 ? L.bs : (L.bt == 18 ? 0 : 1)];
+        int n = spt(d, t);
+        cs[L.co] = (uint8_t)n;
+        for (int sct = 0; sct < n; sct++) bs[L.bo + sct / 8] |= (uint8_t)(1 << (sct % 8));
+    }
+    if (d81) {
+        bamloc_t L; bam_loc(d, 40, &L);
+        bam[1][L.co] = 36; bam[1][L.bo] &= 0xF0;                /* 40/0..40/3 in use */
+        for (int k = 1; k <= 2; k++) {
+            bam[k][0] = k == 1 ? 40 : 0; bam[k][1] = k == 1 ? 2 : 0xFF;
+            bam[k][2] = 'D'; bam[k][3] = 0xBB; bam[k][4] = idb[0]; bam[k][5] = idb[1]; bam[k][6] = 0xC0;
+        }
+        memset(b, 0, sizeof b);
+        b[0] = 40; b[1] = 3; b[2] = 'D';
+        memset(b + 0x04, 0xA0, 16); memcpy(b + 0x04, name, strlen(name));
+        b[0x14] = b[0x15] = 0xA0;
+        b[0x16] = idb[0]; b[0x17] = idb[1];
+        b[0x18] = 0xA0; b[0x19] = '3'; b[0x1A] = 'D'; b[0x1B] = b[0x1C] = 0xA0;
+        int r = wr(d, 40, 0, b); if (r) return r;
+        if ((r = wr(d, 40, 1, bam[1]))) return r;
+        if ((r = wr(d, 40, 2, bam[2]))) return r;
+        memset(b, 0, sizeof b); b[1] = 0xFF;
+        return wr(d, 40, 3, b);
+    }
+    uint8_t *h = bam[0];                                        /* header sector 18/0 = the first BAM sector */
+    h[0] = 18; h[1] = 1; h[2] = 'A'; h[3] = d71 ? 0x80 : 0;
+    bamloc_t L; bam_loc(d, 18, &L);
+    h[L.co] -= 2; h[L.bo] &= 0xFC;                              /* 18/0 and 18/1 in use */
+    if (d71) {
+        bam_loc(d, 53, &L);
+        bam[0][L.co] = 0;                                       /* track 53 holds the side-2 BAM: no file sectors */
+        memset(bam[1] + L.bo, 0, 3);
+    }
+    memset(h + name_off, 0xA0, 16); memcpy(h + name_off, name, strlen(name));
+    h[0xA0] = h[0xA1] = 0xA0;
+    h[0xA2] = idb[0]; h[0xA3] = idb[1];
+    h[0xA4] = 0xA0; h[0xA5] = '2'; h[0xA6] = 'A';
+    h[0xA7] = h[0xA8] = h[0xA9] = h[0xAA] = 0xA0;
+    int r = wr(d, 18, 0, h);
+    if (r) return r;
+    if (d71 && (r = wr(d, 53, 0, bam[1]))) return r;
+    memset(b, 0, sizeof b); b[1] = 0xFF;
+    return wr(d, 18, 1, b);
+}
+
+/* ---- BASIC listing ------------------------------------------------------ */
+VD_COLD static void put(d64_bas_t *b, uint8_t c)
+{
+    if (b->len >= b->cap) { b->ok = 0; return; }
+    b->p[b->len++] = c;
+}
+VD_COLD static void line_begin(d64_bas_t *b, uint16_t num)
+{
+    b->link_at = (uint16_t)b->len;
+    put(b, 0); put(b, 0);                              /* link patched in line_end */
+    put(b, num & 0xFF); put(b, num >> 8);
+}
+VD_COLD static void line_end(d64_bas_t *b)
+{
+    put(b, 0);
+    uint16_t next = (uint16_t)(0x0401 + b->base + b->len - 2);   /* -2: load address bytes come first */
+    if (b->ok) { b->p[b->link_at] = next & 0xFF; b->p[b->link_at + 1] = next >> 8; }
+}
+VD_COLD static void puts_(d64_bas_t *b, const char *s) { while (*s) put(b, (uint8_t)*s++); }
+
+VD_COLD void d64_bas_begin_at(d64_bas_t *b, uint8_t *out, size_t cap, size_t base)
+{
+    b->p = out; b->cap = cap; b->len = 0; b->base = base; b->ok = 1; b->link_at = 0;
+    if (base == 0) { put(b, 0x01); put(b, 0x04); }      /* load address $0401 */
+}
+
+VD_COLD void d64_bas_begin(d64_bas_t *b, uint8_t *out, size_t cap) { d64_bas_begin_at(b, out, cap, 0); }
+
+VD_COLD void d64_bas_header(d64_bas_t *b, const char *name, const char *id, const char *dos)
+{
+    line_begin(b, 0);
+    put(b, 0x12); put(b, '"');                         /* reverse video */
+    int n = (int)strlen(name);
+    for (int i = 0; i < 16; i++) put(b, i < n ? (uint8_t)name[i] : 0x20);
+    put(b, '"'); put(b, ' '); puts_(b, id); put(b, ' '); puts_(b, dos);
+    line_end(b);
+}
+
+VD_COLD void d64_bas_entry(d64_bas_t *b, uint16_t blocks, const char *name, const char *type3, int closed, int locked)
+{
+    line_begin(b, blocks);
+    int pad = blocks < 10 ? 3 : blocks < 100 ? 2 : blocks < 1000 ? 1 : 0;
+    for (int i = 0; i < pad; i++) put(b, ' ');
+    put(b, '"');
+    int l = (int)strlen(name);
+    for (int i = 0; i < l; i++) put(b, (uint8_t)name[i]);
+    put(b, '"');
+    for (int i = l; i < 16; i++) put(b, ' ');
+    put(b, closed ? ' ' : '*');
+    puts_(b, type3);
+    put(b, locked ? '<' : ' ');
+    line_end(b);
+}
+
+VD_COLD void d64_bas_footer(d64_bas_t *b, uint16_t free_blocks)
+{
+    line_begin(b, free_blocks);
+    puts_(b, "BLOCKS FREE.             ");
+    line_end(b);
+}
+
+VD_COLD size_t d64_bas_end(d64_bas_t *b)
+{
+    put(b, 0); put(b, 0);                              /* end of program */
+    return b->ok ? b->len : 0;
+}
+
+static const char *const TYPES[8] = { "DEL", "SEQ", "PRG", "USR", "REL", "???", "???", "???" };
+
+VD_COLD size_t d64_build_dir(d64_t *d, const char *pattern, uint8_t *out, size_t cap)
+{
+    d64_bas_t b;
+    char name[17], id[3], dos[3];
+    d64_bas_begin(&b, out, cap);
+    if (d64_header(d, name, id, dos)) return 0;
+    d64_bas_header(&b, name, id, dos);
+
+    d64_dir_t it; d64_entry_t e;
+    if (d64_dir_first(d, &it)) return 0;
+    int r;
+    while ((r = d64_dir_next(d, &it, &e)) > 0) {
+        if (pattern && !d64_match(e.name, pattern)) continue;
+        d64_bas_entry(&b, e.blocks, e.name, TYPES[e.type & 7], (e.type & 0x80) != 0, (e.type & 0x40) != 0);
+    }
+    if (r < 0) return 0;
+
+    int fr = d64_blocks_free(d);
+    if (fr < 0) return 0;
+    d64_bas_footer(&b, (uint16_t)fr);
+    return d64_bas_end(&b);
+}
+
+VD_COLD size_t d64_sizeof_d64(void)   { return sizeof(d64_t); }
+VD_COLD size_t d64_sizeof_mem(void)   { return sizeof(d64_mem_t); }
+VD_COLD size_t d64_sizeof_dir(void)   { return sizeof(d64_dir_t); }
+VD_COLD size_t d64_sizeof_wfile(void) { return sizeof(d64_wfile_t); }
+VD_COLD size_t d64_sizeof_file(void)  { return sizeof(d64_file_t); }
+VD_COLD size_t d64_sizeof_entry(void) { return sizeof(d64_entry_t); }
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/d64.h b/Source/Teensy/MinimalBoot/Common/vdrive/d64.h
new file mode 100644
index 0000000..2dadfcf
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/d64.h
@@ -0,0 +1,135 @@
+/* Disk image engine (read + write) for .d64 (1541, 35/40 tracks), .d71 (1571, 70 tracks) and .d81 (1581, 80 tracks).
+ * Portable C99, no malloc: all state lives in caller structs and sectors are fetched through a callback, so the same
+ * code runs on the Teensy (SD/USB file backend) and on the host (tests, VICE mock). Names keep the d64_ prefix. */
+#ifndef D64_H
+#define D64_H
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define D64_SECTOR 256
+
+/* Fetch one 256-byte sector. Return 0 on success. */
+typedef int (*d64_read_fn)(void *ctx, uint8_t track, uint8_t sector, uint8_t *buf);
+
+/* Store one 256-byte sector. Return 0 on success. NULL = read-only disk. */
+typedef int (*d64_write_fn)(void *ctx, uint8_t track, uint8_t sector, const uint8_t *buf);
+
+enum {
+    D64_OK = 0,
+    D64_E_IO = -1,       /* sector read/write failed or link out of range */
+    D64_E_LOOP = -2,     /* chain loop */
+    D64_E_FULL = -3,     /* disk (or directory) full   -> DOS 72 */
+    D64_E_EXISTS = -4,   /* file exists                -> DOS 63 */
+    D64_E_NAME = -5,     /* bad file name              -> DOS 33 */
+    D64_E_RO = -6,       /* read-only disk             -> DOS 26 */
+    D64_E_LOCKED = -7,   /* file is locked             -> DOS 26 */
+    D64_E_NOTFOUND = -8  /* file not found             -> DOS 62 */
+};
+
+enum { D64_FMT_D64 = 0, D64_FMT_D71 = 1, D64_FMT_D81 = 2 };
+
+typedef struct {
+    d64_read_fn  read;
+    d64_write_fn write;
+    void       *ctx;
+    uint8_t     tracks;          /* 35 or 40 (d64), 70 (d71), 80 (d81) */
+    uint8_t     fmt;             /* D64_FMT_* */
+} d64_t;
+
+typedef struct {
+    uint8_t  type;               /* raw type byte: bit7 closed, bit6 locked, low 3 = DEL/SEQ/PRG/USR/REL */
+    uint8_t  track, sector;      /* first data sector */
+    uint16_t blocks;
+    char     name[17];           /* PETSCII, $A0 padding stripped, NUL terminated */
+    uint8_t  dir_t, dir_s, dir_slot;   /* where this entry lives (for update/scratch) */
+} d64_entry_t;
+
+typedef struct {
+    uint8_t track, sector;       /* next directory sector in chain */
+    uint8_t cur_t, cur_s;        /* sector held in buf */
+    uint8_t slot;                /* next entry (0-7) in buf */
+    uint8_t guard;
+    uint8_t buf[D64_SECTOR];
+} d64_dir_t;
+
+typedef struct {
+    uint8_t  next_t, next_s;     /* next sector in chain (0,x = none) */
+    uint8_t  loaded;             /* buf holds a sector */
+    uint16_t pos, end;           /* read cursor / one past last valid byte in buf */
+    uint16_t guard;
+    uint8_t  buf[D64_SECTOR];
+} d64_file_t;
+
+typedef struct {
+    uint8_t  type;               /* DEL/SEQ/PRG/USR (low 3 bits) */
+    uint8_t  dir_t, dir_s, dir_slot;
+    uint8_t  first_t, first_s;
+    uint8_t  cur_t, cur_s;       /* sector being filled */
+    uint16_t pos;                /* next free index in buf (2..256) */
+    uint16_t blocks;             /* sectors allocated so far */
+    uint8_t  buf[D64_SECTOR];
+} d64_wfile_t;
+
+/* Memory-image backend (host tests / mock). Writable if data is. */
+typedef struct { uint8_t *data; size_t len; } d64_mem_t;
+void d64_mem_init(d64_mem_t *m, uint8_t *data, size_t len);
+int  d64_open_mem(d64_t *d, d64_mem_t *m);          /* image size selects the format */
+int  d64_open(d64_t *d, d64_read_fn rd, void *ctx, uint8_t tracks);   /* tracks: 35/40 = d64, 70 = d71, 80 = d81 */
+int  d64_open_size(d64_t *d, d64_read_fn rd, void *ctx, size_t file_size);   /* format from the file size (error bytes allowed); -1 if too small */
+
+int  d64_sectors_in_track(const d64_t *d, uint8_t track);   /* 0 if invalid */
+long d64_sector_offset(const d64_t *d, uint8_t track, uint8_t sector); /* byte offset in image, -1 if invalid */
+
+/* Disk header: name (16 PETSCII, stripped), id (2), dos type (2), NUL terminated. */
+int  d64_header(d64_t *d, char name[17], char id[3], char dos[3]);
+int  d64_blocks_free(d64_t *d);                     /* 1541 convention: track 18 not counted */
+
+int  d64_dir_first(d64_t *d, d64_dir_t *it);
+int  d64_dir_next(d64_t *d, d64_dir_t *it, d64_entry_t *e);   /* 1 entry, 0 end, <0 error */
+
+/* CBM wildcard match: '?' any one char, '*' rest of name. */
+int  d64_match(const char *name, const char *pattern);
+int  d64_find(d64_t *d, const char *pattern, d64_entry_t *e); /* 1 found, 0 not found, <0 error */
+
+int  d64_file_open(d64_t *d, const d64_entry_t *e, d64_file_t *f);
+int  d64_file_read(d64_t *d, d64_file_t *f, uint8_t *out, size_t n); /* bytes read; 0 = EOF; <0 error */
+int  d64_file_eof(const d64_file_t *f);             /* 1 when no more bytes will follow */
+
+/* BASIC directory listing (load address $0401), optional name pattern (NULL = all).
+ * Returns length written, or 0 if cap is too small. */
+size_t d64_build_dir(d64_t *d, const char *pattern, uint8_t *out, size_t cap);
+
+/* ---- write support ----
+ * d64_create allocates the first sector and a directory slot (file shows as
+ * unclosed "splat" until d64_close_write). replace!=0 scratches an existing
+ * file of that name first (DOS "@:"). */
+int  d64_create(d64_t *d, const char *name, uint8_t type, int replace, d64_wfile_t *w);
+int  d64_write(d64_t *d, d64_wfile_t *w, const uint8_t *data, size_t n); /* n or <0; on D64_E_FULL the file is removed */
+int  d64_close_write(d64_t *d, d64_wfile_t *w);
+int  d64_scratch_entry(d64_t *d, const d64_entry_t *e);          /* frees chain, marks entry deleted */
+int  d64_scratch(d64_t *d, const char *pattern);                 /* returns files scratched or <0 */
+int  d64_rename(d64_t *d, const char *oldname, const char *newname);
+int  d64_format(d64_t *d, const char *name, const char *id);     /* id==NULL: quick (BAM + directory only) */
+
+/* Generic BASIC-listing builder (also used for host directory listings). */
+typedef struct { uint8_t *p; size_t cap, len, base; uint16_t link_at; int ok; } d64_bas_t;
+void   d64_bas_begin(d64_bas_t *b, uint8_t *out, size_t cap);
+/* Incremental form: build one line at a time into a small buffer. base = bytes already emitted
+ * (load address included) so the line link pointers stay right; base==0 also emits the load address. */
+void   d64_bas_begin_at(d64_bas_t *b, uint8_t *out, size_t cap, size_t base);
+void   d64_bas_header(d64_bas_t *b, const char *name, const char *id, const char *dos);
+void   d64_bas_entry(d64_bas_t *b, uint16_t blocks, const char *name, const char *type3, int closed, int locked);
+void   d64_bas_footer(d64_bas_t *b, uint16_t free_blocks);
+size_t d64_bas_end(d64_bas_t *b);                    /* length, or 0 if the buffer overflowed */
+
+size_t d64_sizeof_d64(void);  size_t d64_sizeof_mem(void);
+size_t d64_sizeof_dir(void);  size_t d64_sizeof_wfile(void);  size_t d64_sizeof_file(void);  size_t d64_sizeof_entry(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/vd_cfg.h b/Source/Teensy/MinimalBoot/Common/vdrive/vd_cfg.h
new file mode 100644
index 0000000..20f3ecc
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/vd_cfg.h
@@ -0,0 +1,25 @@
+/* Build-time knobs shared by d64.c / vdrive.c / vdrive_io.c. */
+#ifndef VD_CFG_H
+#define VD_CFG_H
+/* Placement for code that is NOT reachable from the bus interrupt. The firmware
+ * glue defines this as FLASHMEM so only the O(1) register accessors stay in RAM1. */
+#ifndef VD_COLD
+#define VD_COLD
+#endif
+
+/* IEC device numbers of the two virtual drives (unit 0 = SD, unit 1 = USB). Any other device number
+ * keeps using the real serial bus, so e.g. -DVD_DEV0=10 -DVD_DEV1=11 leaves physical drives 8 and 9
+ * alone. The KERNAL image contains no device numbers: change them here and rebuild the firmware only. */
+#ifndef VD_DEV0
+#define VD_DEV0 8
+#endif
+#ifndef VD_DEV1
+#define VD_DEV1 9
+#endif
+
+/* Simultaneously open data channels per unit. Real 1541s have 5; the pool is shared by
+ * LOAD (channel 0), SAVE (1), and OPENs 2-14. Each slot costs ~290 bytes. */
+#ifndef VD_NSLOT
+#define VD_NSLOT 6
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.c b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.c
new file mode 100644
index 0000000..93711d9
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.c
@@ -0,0 +1,595 @@
+#include "vdrive.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+#define ST_TIMEOUT 0x02
+#define ST_EOI     0x40
+#define ST_NODEV   0x80
+
+/* ---- status channel ---------------------------------------------------- */
+static const struct { uint8_t code; const char *msg; } MSGS[] = {
+    {0, " OK"}, {1, "FILES SCRATCHED"}, {26, "WRITE PROTECT ON"}, {30, "SYNTAX ERROR"},
+    {31, "SYNTAX ERROR"}, {33, "SYNTAX ERROR"}, {62, "FILE NOT FOUND"}, {63, "FILE EXISTS"},
+    {70, "NO CHANNEL"}, {72, "DISK FULL"}, {73, "TRVDRIVE V1.0"}, {74, "DRIVE NOT READY"},
+};
+
+VD_COLD static void set_err(vd_unit_t *u, uint8_t code, uint8_t t, uint8_t s)
+{ u->err = code; u->err_t = t; u->err_s = s; }
+
+static uint8_t *put2(uint8_t *p, unsigned n) { *p++ = (uint8_t)('0' + n / 10 % 10); *p++ = (uint8_t)('0' + n % 10); return p; }
+
+/* Render "NN,MESSAGE,TT,SS\r" into statbuf and clear the error. */
+VD_COLD static uint16_t status_text(vd_unit_t *u)
+{
+    uint8_t *p = u->statbuf;
+    const char *m = "";
+    for (unsigned i = 0; i < sizeof MSGS / sizeof MSGS[0]; i++) if (MSGS[i].code == u->err) m = MSGS[i].msg;
+    p = put2(p, u->err); *p++ = ',';
+    while (*m) *p++ = (uint8_t)*m++;
+    *p++ = ','; p = put2(p, u->err_t); *p++ = ','; p = put2(p, u->err_s); *p++ = '\r';
+    uint16_t n = (uint16_t)(p - u->statbuf);
+    set_err(u, 0, 0, 0);
+    u->stat_len = (uint8_t)n; u->stat_pos = 0;
+    return n;
+}
+
+VD_COLD static void err_from(vd_unit_t *u, int r)
+{
+    switch (r) {
+    case D64_E_FULL:    set_err(u, 72, 0, 0); break;
+    case D64_E_EXISTS:  set_err(u, 63, 0, 0); break;
+    case D64_E_NAME:    set_err(u, 33, 0, 0); break;
+    case D64_E_RO:
+    case D64_E_LOCKED:  set_err(u, 26, 0, 0); break;
+    case D64_E_NOTFOUND:set_err(u, 62, 0, 0); break;
+    default:            set_err(u, 74, 0, 0); break;
+    }
+}
+
+/* ---- channels ---------------------------------------------------------- */
+VD_COLD static vd_chan_t *chan_find(vd_unit_t *u, int ch)
+{
+    uint8_t i = u->slot_of[ch];
+    return i ? &u->slot[i - 1] : NULL;
+}
+
+VD_COLD static void close_all(vd_unit_t *u);
+
+/* Undo the temporary selection of a listing by path: the folder / image that was selected before is selected again. */
+VD_COLD static void restore_selection(vd_unit_t *u)
+{
+    u->restore_ch = 0;
+    close_all(u);                                                 /* anything opened on the temporary image meanwhile goes with it */
+    vdrive_t *v = u->owner;
+    d64_t *d = NULL;
+    u->disk = NULL;
+    if (v && v->host.pop) v->host.pop(v->host.ctx, u->index, &d);
+    u->disk = d;
+}
+
+VD_COLD static void chan_close(vd_unit_t *u, int ch)
+{
+    vd_chan_t *c = chan_find(u, ch);
+    if (!c) return;
+    if (c->mode == 3 && u->disk) {
+        int r = d64_close_write(u->disk, &c->u.w);
+        if (r) err_from(u, r);
+    }
+    c->mode = 0;
+    u->slot_of[ch] = 0;
+    if (u->restore_ch == ch + 1) restore_selection(u);
+}
+
+VD_COLD static vd_chan_t *chan_alloc(vd_unit_t *u, int ch)
+{
+    chan_close(u, ch);
+    for (int i = 0; i < VD_NSLOT; i++) {
+        int used = 0;
+        for (int k = 0; k < 16; k++) if (u->slot_of[k] == i + 1) used = 1;
+        if (!used) { u->slot_of[ch] = (uint8_t)(i + 1); u->slot[i].mode = 0; return &u->slot[i]; }
+    }
+    set_err(u, 70, 0, 0);                              /* NO CHANNEL */
+    return NULL;
+}
+
+VD_COLD static void close_all(vd_unit_t *u) { for (int i = 0; i < 16; i++) chan_close(u, i); }
+
+/* name[0..len) -> split off a leading "0:" style drive prefix; returns pointer to name proper. */
+VD_COLD static const char *strip_prefix(const char *p, const char *end)
+{
+    for (const char *q = p; q < end && q < p + 3; q++) if (*q == ':') return q + 1;
+    return p;
+}
+
+typedef struct { char name[VD_CMDBUF]; int has_name; uint8_t type; char mode; int replace; int ok; } open_spec_t;
+
+VD_COLD static open_spec_t parse_open(const uint8_t *raw, uint8_t len)
+{
+    open_spec_t o; memset(&o, 0, sizeof o);
+    char buf[VD_CMDBUF + 1];
+    memcpy(buf, raw, len); buf[len] = 0;
+    const char *p = buf, *end = buf + len;
+    if (*p == '@') { o.replace = 1; p++; }
+    p = strip_prefix(p, end);
+    const char *comma = p;
+    while (comma < end && *comma != ',') comma++;
+    size_t nl = (size_t)(comma - p);
+    memcpy(o.name, p, nl); o.name[nl] = 0; o.has_name = nl > 0;
+    o.ok = 1;
+    while (comma < end) {
+        const char *f = comma + 1;
+        switch (*f) {
+        case 'P': o.type = 2; break;
+        case 'S': o.type = 1; break;
+        case 'U': o.type = 3; break;
+        case 'L': o.type = 4; break;
+        case 'R': case 'W': case 'A': o.mode = *f; break;
+        default: break;
+        }
+        comma = f;
+        while (comma < end && *comma != ',') comma++;
+    }
+    return o;
+}
+
+static const char *const DIRTYPES[8] = { "DEL", "SEQ", "PRG", "USR", "REL", "???", "???", "???" };
+
+/* 64, 71 or 81 for a name ending in .D64 / .D71 / .D81 (PETSCII or ASCII, either case), else 0 */
+VD_COLD static int image_kind(const char *s)
+{
+    size_t l = strlen(s);
+    if (l < 4) return 0;
+    const uint8_t *e = (const uint8_t *)s + l - 4;
+    if ((e[0] & 0x7F) != '.' || ((e[1] & 0x7F) | 0x20) != 'd') return 0;
+    if (e[2] == '6' && e[3] == '4') return 64;
+    if (e[2] == '7' && e[3] == '1') return 71;
+    if (e[2] == '8' && e[3] == '1') return 81;
+    return 0;
+}
+
+VD_COLD static const char *image_tag(const char *s) { int k = image_kind(s); return k == 71 ? "D71" : k == 81 ? "D81" : "D64"; }
+
+VD_COLD static void leave_image(vdrive_t *v, int unit, vd_unit_t *u)
+{
+    if (!u->disk) return;
+    close_all(u); u->disk = NULL;
+    if (v->host.unmount) v->host.unmount(v->host.ctx, unit);
+}
+
+/* Follow "[/]dir/dir/image.d64[/rest]" on the host: a leading "/" starts at the card root, ".." (or the left arrow "_") goes
+ * up, a component with an image suffix is mounted, any other component is a folder. A component with a wildcard is not
+ * entered: it ends the walk as the pattern. *rest points at what is left (the file name after an image, a pattern, or ""
+ * when the path ended on the folder / image). Returns 0 or a DOS error code. Modifies p. */
+VD_COLD static int path_walk(vdrive_t *v, int unit, vd_unit_t *u, char *p, char **rest)
+{
+    const vd_host_t *h = &v->host;
+    int r;
+    *rest = p + strlen(p);
+    if (!h->chdir || !h->mount) return 33;
+    if (*p == '/') { leave_image(v, unit, u); if ((r = h->chdir(h->ctx, unit, "/"))) return r; }
+    while (*p) {
+        char *c = p, *sl = strchr(p, '/');
+        if (sl) { *sl = 0; p = sl + 1; } else p += strlen(p);
+        if (!*c) continue;                                                  /* "//" or a trailing "/" */
+        if (strpbrk(c, "*?")) { if (sl) *sl = '/'; *rest = c; return 0; }
+        if (!strcmp(c, "..") || !strcmp(c, "_")) {
+            if (u->disk) leave_image(v, unit, u);                           /* up from an image = unmount */
+            else if ((r = h->chdir(h->ctx, unit, ".."))) return r;
+        } else if (image_kind(c)) {
+            d64_t *d = NULL;
+            leave_image(v, unit, u);
+            if ((r = h->mount(h->ctx, unit, c, &d))) return r;
+            u->disk = d;
+            *rest = p;
+            return 0;
+        } else {
+            leave_image(v, unit, u);
+            if ((r = h->chdir(h->ctx, unit, c))) return r;
+        }
+    }
+    return 0;
+}
+
+/* One line of the directory per call into d->line; sets d->phase = 3 and llen = 0 when finished. */
+VD_COLD static void dir_gen(vdrive_t *v, int unit, vd_unit_t *u, vd_dirstream_t *d)
+{
+    d64_bas_t b;
+    char name[17], id[3], dos[3];
+    d->lpos = 0; d->llen = 0;
+    while (d->phase != 3) {
+        d64_bas_begin_at(&b, d->line, sizeof d->line, d->off);
+        if (d->phase == 0) {
+            if (d->host) {
+                char title[17];
+                if (v->host.dir_open(v->host.ctx, unit, title)) { d->phase = 3; return; }
+                { char idn[3] = { (char)('0' + v->dev[unit] / 10 % 10), (char)('0' + v->dev[unit] % 10), 0 };   /* shows the device number */
+                  d64_bas_header(&b, title, idn, "2A"); }
+            } else {
+                if (d64_header(u->disk, name, id, dos) || d64_dir_first(u->disk, &d->it)) { d->phase = 3; return; }
+                d64_bas_header(&b, name, id, dos);
+            }
+            d->phase = 1;
+        } else if (d->phase == 1) {
+            int got = 0;
+            for (;;) {
+                if (d->host) {
+                    uint32_t size; int is_dir;
+                    if (v->host.dir_next(v->host.ctx, unit, name, &size, &is_dir) <= 0) break;
+                    if (d->has_pat && !d64_match(name, d->pat)) continue;
+                    uint32_t blocks = is_dir ? 0 : (size + 253) / 254;
+                    d64_bas_entry(&b, (uint16_t)(blocks > 65535 ? 65535 : blocks), name,
+                                  is_dir ? "DIR" : image_kind(name) ? image_tag(name) : "PRG", 1, 0);
+                    got = 1; break;
+                } else {
+                    d64_entry_t e;
+                    int r = d64_dir_next(u->disk, &d->it, &e);
+                    if (r < 0) { d->phase = 3; return; }       /* damaged directory: stop listing */
+                    if (r == 0) break;
+                    if (d->has_pat && !d64_match(e.name, d->pat)) continue;
+                    d64_bas_entry(&b, e.blocks, e.name, DIRTYPES[e.type & 7], (e.type & 0x80) != 0, (e.type & 0x40) != 0);
+                    got = 1; break;
+                }
+            }
+            if (!got) { d->phase = 2; continue; }
+        } else {
+            int fr = d->host ? 0 : d64_blocks_free(u->disk);
+            if (fr < 0) fr = 0;
+            d64_bas_footer(&b, (uint16_t)fr);
+            d64_bas_end(&b);
+            d->phase = 3;
+        }
+        d->llen = (uint8_t)b.len;
+        d->off = (uint16_t)(d->off + b.len);
+        return;
+    }
+}
+
+VD_COLD static void open_dir_pat(vdrive_t *v, int unit, vd_unit_t *u, int ch, const char *pat)
+{
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    vd_dirstream_t *d = &c->u.d;
+    memset(d, 0, sizeof *d);
+    d->host = u->disk == NULL;
+    size_t n = 0;
+    while (pat[n] && n < 16) { d->pat[n] = pat[n]; n++; }
+    d->pat[n] = 0; d->has_pat = n != 0;
+    c->mode = 4;
+    dir_gen(v, unit, u, d);                            /* first line now, so failures report at OPEN time */
+    if (d->llen == 0) { chan_close(u, ch); set_err(u, 74, 0, 0); }
+}
+
+/* A listing by path only shows what is there: the folder / image selected before is restored when its channel closes.
+ * begin_temp remembers it (first closing an earlier listing that is still open), end_temp arms the restore for channel ch. */
+VD_COLD static void begin_temp(vdrive_t *v, int unit, vd_unit_t *u)
+{
+    if (u->restore_ch) chan_close(u, u->restore_ch - 1);
+    v->host.push(v->host.ctx, unit);
+}
+VD_COLD static void end_temp(vd_unit_t *u, int ch)
+{
+    if (chan_find(u, ch)) u->restore_ch = (uint8_t)(ch + 1);     /* restored by that channel's close */
+    else restore_selection(u);                                    /* the listing never opened */
+}
+
+/* "$[n][:]pattern": the directory of the mounted image, or of the current host folder. A pattern with a "/" in it (or, with
+ * nothing mounted, ending in an image suffix) is a path: LOAD"$/GAMES/DEMO.D64" mounts the image and lists it,
+ * LOAD"$GAMES/" lists that folder, LOAD"$GAMES/DEMO.D64/S*" lists the matching files in the image.
+ * "$==path" (also "$:==" / "$0:==") is always a path, even without a "/" or an image suffix: $==GAMES enters the folder GAMES,
+ * $==T a folder called T (a single "=" is a CBM listing modifier, $=T / $=P, and is left alone). */
+VD_COLD static void open_dir(vdrive_t *v, int unit, vd_unit_t *u, int ch, const uint8_t *raw, uint8_t len)
+{
+    char spec[VD_CMDBUF];
+    size_t n = 0;
+    uint8_t i = 1;
+    while (i < len && raw[i] >= '0' && raw[i] <= '9') i++;
+    if (i < len && raw[i] == ':') i++;
+    int force = i + 1 < len && raw[i] == '=' && raw[i + 1] == '=';     /* "$==path": always a path (a single "=" is a CBM listing modifier: $=T, $=P) */
+    if (force) i += 2;
+    while (i < len && raw[i] != ',' && n < sizeof spec - 1) spec[n++] = (char)raw[i++];
+    spec[n] = 0;
+    char *pat = spec;
+    if (force || strchr(spec, '/') || (!u->disk && !strpbrk(spec, "*?") && image_kind(spec))) {
+        int temp = !force && v->host.push && v->host.pop;
+        if (temp) begin_temp(v, unit, u);
+        int r = path_walk(v, unit, u, spec, &pat);
+        if (r) { set_err(u, (uint8_t)r, 0, 0); if (temp) restore_selection(u); return; }
+        open_dir_pat(v, unit, u, ch, pat);
+        if (temp) end_temp(u, ch);
+        return;
+    }
+    open_dir_pat(v, unit, u, ch, pat);
+}
+VD_COLD static void chan_open(vdrive_t *v, int unit, vd_unit_t *u, int ch, const uint8_t *raw, uint8_t len)
+{
+    chan_close(u, ch);
+    if (len && raw[0] == '$' && (u->disk || (v->host.dir_open && v->host.dir_next))) { open_dir(v, unit, u, ch, raw, len); return; }
+    open_spec_t o = parse_open(raw, len);
+    if (!o.has_name) { set_err(u, u->disk ? 33 : 74, 0, 0); return; }
+    char mode = o.mode ? o.mode : (ch == 1 ? 'W' : 'R');
+    if (mode != 'R' && mode != 'W') { set_err(u, 33, 0, 0); return; }   /* append not supported */
+    /* "DIR/IMAGE.D64/FILE" (or a bare "IMAGE.D64" read with nothing mounted): walk there first, the file name is what is left */
+    if (strchr(o.name, '/') || (mode == 'R' && !u->disk && image_kind(o.name))) {
+        char *rest;
+        int temp = mode == 'R' && v->host.push && v->host.pop;
+        if (temp) begin_temp(v, unit, u);
+        int r = path_walk(v, unit, u, o.name, &rest);
+        if (r) { set_err(u, (uint8_t)r, 0, 0); if (temp) restore_selection(u); return; }
+        if (!*rest) {                                                         /* it named a folder / image: show what is in it, nothing stays selected */
+            open_dir_pat(v, unit, u, ch, "");
+            if (temp) end_temp(u, ch);
+            return;
+        }
+        memmove(o.name, rest, strlen(rest) + 1);                              /* a file through a path: the folder / image stay selected for the program */
+        if (temp) v->host.pop(v->host.ctx, unit, NULL);                       /* (out == NULL: keep the selection, drop the snapshot) */
+    }
+    if (strlen(o.name) > 16) { set_err(u, 33, 0, 0); return; }
+    if (!u->disk) { set_err(u, 74, 0, 0); return; }
+    vd_chan_t *c = chan_alloc(u, ch);
+    if (!c) return;
+    if (mode == 'R') {
+        d64_entry_t e;
+        int r = d64_find(u->disk, o.name, &e);
+        if (r < 0) { err_from(u, r); chan_close(u, ch); return; }
+        if (r == 0) { set_err(u, 62, 0, 0); chan_close(u, ch); return; }
+        d64_file_open(u->disk, &e, &c->u.r);
+        c->mode = 1;
+    } else {
+        uint8_t type = o.type ? o.type : (ch == 1 ? 2 : 1);
+        int r = d64_create(u->disk, o.name, type, o.replace, &c->u.w);
+        if (r) { err_from(u, r); chan_close(u, ch); return; }
+        c->mode = 3;
+    }
+}
+
+/* ---- command channel ---------------------------------------------------- */
+/* CD[n]:path -- same path syntax as a LOAD name (see path_walk): CD:/GAMES/DEMO.D64, CD:.., CD:_ (left arrow), CD:/ (root). */
+VD_COLD static void cmd_cd(vdrive_t *v, int unit, vd_unit_t *u, const char *p, const char *end)
+{
+    const char *q = p;
+    while (q < end && *q >= '0' && *q <= '9') q++;
+    if (q < end && *q == ':') p = q + 1;                         /* "CD:" and "CD0:" */
+    char path[VD_CMDBUF]; size_t n = (size_t)(end - p);
+    if (n >= sizeof path) { set_err(u, 33, 0, 0); return; }
+    memcpy(path, p, n); path[n] = 0;
+    if (!n) return;
+    char *rest;
+    int r = path_walk(v, unit, u, path, &rest);
+    if (r) set_err(u, (uint8_t)r, 0, 0);
+    else if (*rest) set_err(u, 33, 0, 0);                        /* something after the image / a wildcard: not a directory */
+}
+
+/* UI / UJ / U9: reset the drive. Closes every channel, keeps the mounted image, answers the "73" power-on message. */
+VD_COLD static void cmd_reset(vd_unit_t *u)
+{
+    close_all(u);
+    set_err(u, 73, 0, 0);
+}
+
+/* Device numbers: a unit uses its pinned number, or else the default / next free one until the start-up scan moves it. */
+VD_COLD static void settle(vdrive_t *v)
+{
+    for (int i = 0; i < 2; i++) {
+        uint8_t n = v->pin[i];
+        if (!n) {
+            n = i ? VD_DEV1 : VD_DEV0;
+            while (n <= 30 && (n == v->pin[0] || n == v->pin[1] || (i == 1 && n == v->dev[0]))) n++;
+            if (n > 30) n = 0;
+        }
+        v->dev[i] = n;
+    }
+}
+
+/* "U0>"+CHR$(n): this drive answers as device n from now on (n = 0: automatic again). Persisted via the host. */
+VD_COLD static void cmd_renumber(vdrive_t *v, int unit, vd_unit_t *u, uint8_t n)
+{
+    if (n && (n < 8 || n > 30 || n == v->dev[1 - unit])) { set_err(u, 33, 0, 0); return; }
+    v->pin[unit] = n;
+    settle(v);
+    if (v->host.save_devices) v->host.save_devices(v->host.ctx, v->pin[0], v->pin[1]);
+}
+
+VD_COLD static void exec_command(vdrive_t *v, int unit, vd_unit_t *u, uint8_t *cmd, uint8_t len)
+{
+    /* OPEN 15,d,15,"U0>"+CHR$(n) sends 4 bytes; PRINT#15 adds a CR, making 5 */
+    if ((len == 4 || (len == 5 && cmd[4] == '\r')) && cmd[0] == 'U' && cmd[1] == '0' && cmd[2] == '>') { cmd_renumber(v, unit, u, cmd[3]); return; }
+    while (len && (cmd[len - 1] == '\r' || cmd[len - 1] == '\n')) len--;
+    if (!len) return;
+    cmd[len] = 0;
+    if (len >= 2 && cmd[0] == 'C' && cmd[1] == 'D') { cmd_cd(v, unit, u, (const char *)cmd + 2, (const char *)cmd + len); return; }
+    if (cmd[0] == 'U' && len == 2 && (cmd[1] == 'I' || cmd[1] == 'J' || cmd[1] == '9')) { cmd_reset(u); return; }
+    if (cmd[0] == 'U' && len == 3 && cmd[1] == 'I' && (cmd[2] == '+' || cmd[2] == '-')) return;   /* VIC-20 / C64 bus speed: nothing to do */
+    if (!u->disk) { set_err(u, 74, 0, 0); return; }
+    const char *p = (const char *)cmd + 1, *end = (const char *)cmd + len;
+    while (p < end && *p >= '0' && *p <= '9') p++;       /* optional drive number */
+    switch (cmd[0]) {
+    case 'S': {
+        if (p < end && *p == ':') p++;
+        int total = 0;
+        while (p <= end) {
+            const char *q = p;
+            while (q < end && *q != ',') q++;
+            char pat[18]; size_t n = (size_t)(q - p);
+            if (n && n <= 16) {
+                memcpy(pat, p, n); pat[n] = 0;
+                int r = d64_scratch(u->disk, pat);
+                if (r < 0) { err_from(u, r); return; }
+                total += r;
+            }
+            p = q + 1;
+        }
+        set_err(u, 1, (uint8_t)total, 0);
+        break; }
+    case 'N': {
+        if (p < end && *p == ':') p++;
+        const char *comma = p;
+        while (comma < end && *comma != ',') comma++;
+        char name[17], id[3];
+        size_t n = (size_t)(comma - p);
+        if (n < 1 || n > 16) { set_err(u, 33, 0, 0); break; }
+        memcpy(name, p, n); name[n] = 0;
+        int r;
+        if (comma < end && end - comma - 1 == 2) { id[0] = comma[1]; id[1] = comma[2]; id[2] = 0; r = d64_format(u->disk, name, id); }
+        else if (comma == end) r = d64_format(u->disk, name, NULL);
+        else { set_err(u, 33, 0, 0); break; }
+        if (r) err_from(u, r);
+        break; }
+    case 'R': {
+        if (p < end && *p == ':') p++;
+        const char *eq = p;
+        while (eq < end && *eq != '=') eq++;
+        char nn[17], on[17];
+        size_t a = (size_t)(eq - p), b = (size_t)(end - eq - 1);
+        if (eq == end || a < 1 || a > 16 || b < 1 || b > 16) { set_err(u, 34, 0, 0); break; }
+        memcpy(nn, p, a); nn[a] = 0; memcpy(on, eq + 1, b); on[b] = 0;
+        int r = d64_rename(u->disk, on, nn);
+        if (r) err_from(u, r);
+        break; }
+    case 'I': case 'V':                                /* initialize / validate: nothing to do */
+        break;
+    default:
+        set_err(u, 31, 0, 0);
+    }
+}
+
+/* ---- public ------------------------------------------------------------- */
+VD_COLD void vdrive_init(vdrive_t *v)
+{
+    memset(v, 0, sizeof *v);
+    v->act = -1;
+    for (int i = 0; i < 2; i++) { v->unit[i].owner = v; v->unit[i].index = (uint8_t)i; }
+    settle(v);
+}
+
+VD_COLD void vdrive_attach(vdrive_t *v, int unit, d64_t *disk, int present)
+{
+    vd_unit_t *u = &v->unit[unit];
+    close_all(u);
+    u->disk = disk; u->present = (uint8_t)present;
+    set_err(u, 0, 0, 0);
+}
+
+VD_COLD void vdrive_set_devices(vdrive_t *v, uint8_t pin0, uint8_t pin1)
+{
+    if (pin0 < 8 || pin0 > 30) pin0 = 0;                /* 0 (unset) or garbage: automatic */
+    if (pin1 < 8 || pin1 > 30 || pin1 == pin0) pin1 = 0;
+    v->pin[0] = pin0; v->pin[1] = pin1;
+    settle(v);
+}
+
+VD_COLD int vdrive_scan_begin(vdrive_t *v)
+{
+    int need = 0;
+    for (int i = 0; i < 2; i++)
+        if (!v->pin[i]) { v->dev[i] = 0; need += v->unit[i].present != 0; }
+    return need;
+}
+
+VD_COLD int vdrive_scan_free(vdrive_t *v, uint8_t dev)
+{
+    int left = 0;
+    if (dev >= 8 && dev <= 30 && dev != v->pin[0] && dev != v->pin[1] && dev != v->dev[0] && dev != v->dev[1])
+        for (int i = 0; i < 2; i++)
+            if (!v->pin[i] && v->unit[i].present && !v->dev[i]) { v->dev[i] = dev; break; }
+    for (int i = 0; i < 2; i++) left += !v->pin[i] && v->unit[i].present && !v->dev[i];
+    return left;
+}
+
+VD_COLD int vdrive_unit_for(const vdrive_t *v, uint8_t dev) { return dev && dev == v->dev[0] ? 0 : dev && dev == v->dev[1] ? 1 : -1; }
+VD_COLD void vdrive_set_host(vdrive_t *v, const vd_host_t *host) { v->host = *host; }
+VD_COLD int vdrive_chan_mode(const vdrive_t *v, int unit, int ch)
+{
+    uint8_t i = v->unit[unit].slot_of[ch];
+    return i ? v->unit[unit].slot[i - 1].mode : 0;
+}
+VD_COLD int vdrive_pending_err(const vdrive_t *v, int unit) { return v->unit[unit].err; }
+VD_COLD int vdrive_active(const vdrive_t *v) { return v->act; }
+VD_COLD size_t vdrive_sizeof(void) { return sizeof(vdrive_t); }
+
+VD_COLD static int read_byte(vdrive_t *v, int unit, vd_unit_t *u, vd_chan_t *c, uint8_t *b, int *eoi)
+{
+    if (c->mode == 1) {
+        int n = d64_file_read(u->disk, &c->u.r, b, 1);
+        if (n <= 0) return 0;
+        *eoi = d64_file_eof(&c->u.r);
+        return 1;
+    }
+    if (c->mode == 4) {
+        vd_dirstream_t *d = &c->u.d;
+        if (d->lpos >= d->llen) dir_gen(v, unit, u, d);
+        if (d->lpos >= d->llen) return 0;
+        *b = d->line[d->lpos++];
+        *eoi = d->lpos >= d->llen && d->phase == 3;
+        return 1;
+    }
+    return 0;
+}
+
+VD_COLD int vdrive_mailbox(vdrive_t *v, uint8_t cmd, uint8_t arg, uint8_t *data, uint8_t *st)
+{
+    *data = 0; *st = 0;
+    if (cmd == VD_LISTEN || cmd == VD_TALK) {
+        v->talking = (cmd == VD_TALK);
+        v->wlen = 0;
+        int unit = vdrive_unit_for(v, arg);
+        if (unit >= 0) {
+            v->act = (int8_t)unit;
+            if (!v->unit[v->act].present) { v->act = 2; *st = ST_NODEV; }
+            return 0;
+        }
+        v->act = -1;
+        return 1;
+    }
+    if (v->act < 0) return 1;                          /* not our transaction */
+    if (v->act == 2) return 0;                         /* absent device: swallow quietly */
+    vd_unit_t *u = &v->unit[v->act];
+    int ch = v->sa & 0xF, op = v->sa & 0xF0;
+
+    switch (cmd) {
+    case VD_SECOND: case VD_TKSA:
+        v->sa = arg; v->wlen = 0;
+        if (cmd == VD_TKSA && (arg & 0xF) == 15 && u->stat_pos >= u->stat_len) status_text(u);
+        return 0;
+    case VD_CIOUT:
+        if (op == 0x60 && ch != 15) {
+            vd_chan_t *c = chan_find(u, ch);
+            if (c && c->mode == 3) {
+                int r = d64_write(u->disk, &c->u.w, &arg, 1);
+                if (r < 0) { err_from(u, r); c->mode = 0; chan_close(u, ch); *st = ST_TIMEOUT; }   /* write already aborted: just release the slot */
+            }
+        } else if (v->wlen < VD_CMDBUF - 1) {
+            v->wbuf[v->wlen++] = arg;
+        }
+        return 0;
+    case VD_UNLSN:
+        if (op == 0xF0 || op == 0xE0 || (op == 0x60 && ch == 15))
+            u->stat_len = u->stat_pos = 0;             /* a new DOS operation replaces the status message: whatever was left
+                                                          unread is dropped (as on a real drive / in VICE), so callers need
+                                                          not drain it. Reading it in pieces between operations still works. */
+        if (op == 0xF0) {
+            if (ch == 15) exec_command(v, v->act, u, v->wbuf, v->wlen);
+            else chan_open(v, v->act, u, ch, v->wbuf, v->wlen);
+        } else if (op == 0x60 && ch == 15) {
+            exec_command(v, v->act, u, v->wbuf, v->wlen);
+        } else if (op == 0xE0) {
+            if (ch == 15) close_all(u); else chan_close(u, ch);
+        }
+        v->wlen = 0; v->act = -1;
+        return 0;
+    case VD_ACPTR: {
+        int eoi = 0;
+        if (ch == 15) {                                /* error channel */
+            if (u->stat_pos < u->stat_len) { *data = u->statbuf[u->stat_pos++]; if (u->stat_pos >= u->stat_len) *st = ST_EOI; }
+            else { *data = '\r'; *st = ST_EOI; }
+            return 0;
+        }
+        vd_chan_t *c = chan_find(u, ch);
+        if (!c || !read_byte(v, v->act, u, c, data, &eoi)) { *st = ST_TIMEOUT | ST_EOI; return 0; }
+        if (eoi) *st = ST_EOI;
+        return 0; }
+    case VD_UNTLK:
+        v->act = -1;
+        return 0;
+    }
+    return 1;
+}
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.h b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.h
new file mode 100644
index 0000000..928050a
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive.h
@@ -0,0 +1,105 @@
+/* Virtual IEC drive: the Teensy-side state machine behind the KERNAL mailbox.
+ * Units 0/1 = devices 8/9, each backed by an optional mounted d64_t.
+ * One mailbox command in, one result out; no I/O other than the d64 and host callbacks. */
+#ifndef VDRIVE_H
+#define VDRIVE_H
+#include "d64.h"
+#include "vd_cfg.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { VD_LISTEN = 1, VD_TALK, VD_SECOND, VD_TKSA, VD_CIOUT, VD_ACPTR, VD_UNLSN, VD_UNTLK };
+
+#define VD_CMDBUF 64
+
+/* Directory listings are generated a line at a time: no listing buffer. */
+typedef struct {
+    d64_dir_t it;               /* image directory iterator (unused for host listings) */
+    char      pat[17];
+    uint8_t   phase;            /* 0 header, 1 entries, 2 footer, 3 done */
+    uint8_t   host;             /* listing the host directory (nothing mounted) */
+    uint8_t   has_pat;
+    uint8_t   lpos, llen;       /* cursor / length of line[] */
+    uint16_t  off;              /* bytes emitted so far, load address included */
+    uint8_t   line[48];
+} vd_dirstream_t;
+
+typedef struct {
+    uint8_t  mode;              /* 0 free, 1 file read, 3 file write, 4 directory stream */
+    union { d64_file_t r; d64_wfile_t w; vd_dirstream_t d; } u;
+} vd_chan_t;
+
+/* Services the host (Teensy glue / test harness) provides for image selection.
+ * Paths are passed through unconverted (PETSCII); the host converts. All optional. */
+typedef struct {
+    void *ctx;
+    int  (*mount)(void *ctx, int unit, const char *name, d64_t **out);   /* 0 ok, else DOS error code (e.g. 62) */
+    void (*unmount)(void *ctx, int unit);
+    int  (*chdir)(void *ctx, int unit, const char *name);                /* "..", subdir; 0 ok else DOS error */
+    int  (*dir_open)(void *ctx, int unit, char title[17]);               /* 0 ok */
+    int  (*dir_next)(void *ctx, int unit, char name[17], uint32_t *size, int *is_dir); /* 1 entry, 0 end */
+    void (*save_devices)(void *ctx, uint8_t pin0, uint8_t pin1);        /* persist after a U0> renumber (0 = automatic) */
+    /* A directory listing by path ($/GAMES/G.D64, $GAMES/) must not change what is selected: push remembers the unit's folder and
+     * mounted image before the walk, pop (when the listing channel closes) goes back; *out = the image to use again (NULL = none).
+     * pop with out == NULL means "keep the new selection": the snapshot is dropped (a file was loaded through the path).
+     * Both optional; without them a listing by path leaves the new folder / image selected. $==path never pops. */
+    void (*push)(void *ctx, int unit);
+    int  (*pop)(void *ctx, int unit, d64_t **out);
+} vd_host_t;
+
+struct vdrive_s;
+typedef struct {
+    struct vdrive_s *owner;     /* back pointer: closing a channel may have to restore the host state */
+    uint8_t  index;             /* this unit's number (0/1) */
+    uint8_t  restore_ch;        /* channel + 1 whose close restores the folder / image selected before a path listing; 0 = none */
+    d64_t   *disk;              /* NULL: no image mounted */
+    uint8_t  present;           /* device answers on the bus */
+    uint8_t  slot_of[16];       /* channel number -> pool slot + 1 (0 = not open) */
+    vd_chan_t slot[VD_NSLOT];
+    uint8_t  statbuf[48];       /* error channel (15) text */
+    uint8_t  stat_len, stat_pos;
+    uint8_t  err, err_t, err_s; /* DOS status */
+} vd_unit_t;
+
+typedef struct vdrive_s {
+    vd_host_t host;
+    vd_unit_t unit[2];
+    uint8_t  dev[2];            /* IEC device number each unit answers to now; 0 = none (not claimed on the bus) */
+    uint8_t  pin[2];            /* the number the user chose with U0> (kept in EEPROM); 0 = automatic */
+    int8_t   act;               /* -1 none, 0/1 unit, 2 = absent device */
+    uint8_t  talking;
+    uint8_t  sa;
+    uint8_t  wlen;
+    uint8_t  wbuf[VD_CMDBUF];
+} vdrive_t;
+
+void vdrive_init(vdrive_t *v);
+void vdrive_attach(vdrive_t *v, int unit, d64_t *disk, int present);
+/* pin0/pin1: device numbers the user fixed (8..30), 0 = automatic. Automatic units start on VD_DEV0/VD_DEV1 (or the next
+ * free number) and are moved by the start-up scan below. */
+void vdrive_set_devices(vdrive_t *v, uint8_t pin0, uint8_t pin1);
+/* Start-up scan (the KERNAL probes the real serial bus for 8,9,... after reset):
+ *   scan_begin  releases the numbers of all automatic units, so the probes reach the real bus; returns how many present
+ *               units still need a number (0 = nothing to scan for).
+ *   scan_free   the probe found nothing at `dev`: give it to the next automatic present unit (SD first, then USB).
+ *               Returns how many units are still waiting. */
+int  vdrive_scan_begin(vdrive_t *v);
+int  vdrive_scan_free(vdrive_t *v, uint8_t dev);
+int  vdrive_unit_for(const vdrive_t *v, uint8_t dev);                /* unit 0/1 serving this device number, or -1 */
+void vdrive_set_host(vdrive_t *v, const vd_host_t *host);
+int  vdrive_chan_mode(const vdrive_t *v, int unit, int ch);   /* 0 closed, 1 file-read, 3 file-write, 4 directory */
+int  vdrive_active(const vdrive_t *v);                        /* unit of the open bus transaction: 0/1, 2 absent device, -1 none */
+int  vdrive_pending_err(const vdrive_t *v, int unit);         /* DOS error code waiting on the status channel (0 = none) */
+
+/* Returns 1 if the transaction is not ours (fall back to the real IEC bus);
+ * 0 if handled, with data and st filled in (st = bits to OR into KERNAL ST). */
+int vdrive_mailbox(vdrive_t *v, uint8_t cmd, uint8_t arg, uint8_t *data, uint8_t *st);
+
+size_t vdrive_sizeof(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.c b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.c
new file mode 100644
index 0000000..a77d8a2
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.c
@@ -0,0 +1,182 @@
+#include "vdrive_io.h"
+#include "vd_cfg.h"
+#include <string.h>
+
+VD_COLD void vio_init(vio_t *v, vio_hot_t *hot)
+{
+    memset((void *)hot, 0, sizeof *hot);
+    memset((void *)v, 0, sizeof *v);
+    v->h = hot;
+    hot->stat = VIO_OK;                   /* idle, nothing pending */
+    vdrive_init(&v->vd);
+    vio_publish_devices(v);
+}
+
+uint8_t vio_io1_read(const vio_hot_t *h, uint8_t off)
+{
+    switch (off) {
+    case VIO_ARG:  return h->arg;
+    case VIO_DATA: return h->data;
+    case VIO_STAT: return h->stat;
+    case VIO_ST:   return h->st;
+    case VIO_LEN:  return h->len;
+    case VIO_DEV0: return h->dev0;
+    case VIO_DEV1: return h->dev1;
+    default:       return 0;
+    }
+}
+
+void vio_io1_write(vio_hot_t *h, uint8_t off, uint8_t val)
+{
+    switch (off) {
+    case VIO_ARG: h->arg = val; break;
+    case VIO_LEN: h->len = val; break;
+    case VIO_CMD:
+        h->cmd = val;
+        h->stat = VIO_BUSY;          /* visible to the 6502 before it can read STAT */
+        h->pending = 1;
+        break;
+    default: break;
+    }
+}
+
+uint8_t vio_io2_read(const vio_hot_t *h, uint8_t off) { return h->window[off]; }
+void    vio_io2_write(vio_hot_t *h, uint8_t off, uint8_t val) { h->window[off] = val; }
+
+/* ---- fast paths, built from the byte-level commands ---- */
+VD_COLD static int bus(vio_t *v, uint8_t c, uint8_t a, uint8_t *data)
+{
+    uint8_t st = 0, d = 0;
+    vdrive_mailbox(&v->vd, c, a, &d, &st);
+    if (data) *data = d;
+    return st;
+}
+
+VD_COLD static void send_name_open(vio_t *v, uint8_t dev, uint8_t sa)
+{
+    bus(v, VD_LISTEN, dev, 0);
+    bus(v, VD_SECOND, sa, 0);
+    for (unsigned i = 0; i < v->h->len; i++) bus(v, VD_CIOUT, v->h->window[i], 0);
+    bus(v, VD_UNLSN, 0, 0);
+}
+
+VD_COLD static void close_chan(vio_t *v, uint8_t dev, uint8_t sa)
+{
+    bus(v, VD_LISTEN, dev, 0); bus(v, VD_SECOND, sa, 0); bus(v, VD_UNLSN, 0, 0);
+}
+
+VD_COLD static void fload_open(vio_t *v)
+{
+    uint8_t dev = v->h->arg, b0, b1 = 0;
+    v->fl_active = 0;
+    if (bus(v, VD_LISTEN, dev, 0) & 0x80) { v->h->data = 5; return; }
+    bus(v, VD_UNLSN, 0, 0);                         /* finish probe transaction */
+    send_name_open(v, dev, 0xF0);
+    bus(v, VD_TALK, dev, 0); bus(v, VD_TKSA, 0x60, 0);
+    int st0 = bus(v, VD_ACPTR, 0, &b0);
+    if (st0 & 0x02) {                               /* nothing came back: file not found */
+        bus(v, VD_UNTLK, 0, 0); close_chan(v, dev, 0xE0);
+        v->h->data = 4; return;
+    }
+    v->fl_eof = (st0 & 0x40) != 0;
+    if (!v->fl_eof) { int st1 = bus(v, VD_ACPTR, 0, &b1); v->fl_eof = (st1 & 0x40) != 0; }
+    bus(v, VD_UNTLK, 0, 0);
+    v->h->window[0] = b0; v->h->window[1] = b1;
+    v->fl_active = 1; v->fl_dev = dev;
+    v->h->data = 0;
+}
+
+VD_COLD static void fload_blk(vio_t *v)
+{
+    uint8_t n = 0, d;
+    v->h->data = 0; v->h->st = 0x40;                       /* default: EOI, empty */
+    if (!v->fl_active) return;
+    if (v->fl_eof) { close_chan(v, v->fl_dev, 0xE0); v->fl_active = 0; return; }
+    int eof = 0;
+    bus(v, VD_TALK, v->fl_dev, 0); bus(v, VD_TKSA, 0x60, 0);
+    while (n < 255) {
+        int st = bus(v, VD_ACPTR, 0, &d);
+        if (st & 0x02) { eof = 1; break; }
+        v->h->window[n++] = d;
+        if (st & 0x40) { eof = 1; break; }
+    }
+    bus(v, VD_UNTLK, 0, 0);
+    v->h->data = n;
+    v->h->st = eof ? 0x40 : 0;
+    if (eof) { close_chan(v, v->fl_dev, 0xE0); v->fl_active = 0; }
+}
+
+VD_COLD static void fsave_open(vio_t *v)
+{
+    uint8_t dev = v->h->arg;
+    v->fs_active = 0;
+    if (bus(v, VD_LISTEN, dev, 0) & 0x80) { v->h->data = 5; return; }
+    bus(v, VD_UNLSN, 0, 0);
+    send_name_open(v, dev, 0xF1);
+    int unit = vdrive_unit_for(&v->vd, dev);
+    if (vdrive_chan_mode(&v->vd, unit, 1) == 3) { v->fs_active = 1; v->fs_dev = dev; v->h->data = 0; }
+    else { int e = vdrive_pending_err(&v->vd, unit); v->h->data = (uint8_t)(e ? e : 74); }
+}
+
+VD_COLD static void fsave_blk(vio_t *v)
+{
+    if (!v->fs_active) return;
+    bus(v, VD_LISTEN, v->fs_dev, 0); bus(v, VD_SECOND, 0x61, 0);
+    for (unsigned i = 0; i < v->h->len; i++) bus(v, VD_CIOUT, v->h->window[i], 0);
+    bus(v, VD_UNLSN, 0, 0);
+}
+
+VD_COLD static void fsave_close(vio_t *v)
+{
+    v->h->data = 0;
+    if (!v->fs_active) return;
+    int unit = vdrive_unit_for(&v->vd, v->fs_dev);
+    int ok = vdrive_chan_mode(&v->vd, unit, 1) == 3;
+    close_chan(v, v->fs_dev, 0xE1);
+    if (!ok) { int e = vdrive_pending_err(&v->vd, unit); v->h->data = (uint8_t)(e ? e : 74); }
+    v->fs_active = 0;
+}
+
+VD_COLD void vio_publish_devices(vio_t *v) { v->h->dev0 = v->vd.dev[0]; v->h->dev1 = v->vd.dev[1]; }
+
+VD_COLD int vio_arm_scan(vio_t *v)
+{
+    v->scan_state = 0;
+    for (int i = 0; i < 2; i++)
+        if (!v->vd.pin[i] && v->vd.unit[i].present) v->scan_state = 1;
+    return v->scan_state;
+}
+
+VD_COLD int vio_poll(vio_t *v)
+{
+    if (!v->h->pending) return 0;
+    uint8_t c = v->h->cmd, notmine = 0, ask = 0;
+    v->h->data = 0; v->h->st = 0;
+    if (c == VD_LISTEN || c == VD_TALK || c == VIO_FLOAD_OPEN || c == VIO_FSAVE_OPEN) {     /* a transaction starts */
+        if (v->scan_state == 1) { v->scan_state = 2; ask = 1; }
+        else if (v->scan_state == 2) v->scan_state = 3;                                    /* asked, not answered: this KERNAL does not scan */
+    }
+    if (ask) {
+        /* answer SCANREQ below, execute nothing */
+    } else if (c >= VD_LISTEN && c <= VD_UNTLK) {
+        uint8_t d, st;
+        notmine = (uint8_t)vdrive_mailbox(&v->vd, c, v->h->arg, &d, &st);
+        v->h->data = d; v->h->st = st;
+    } else switch (c) {
+        case VIO_FLOAD_OPEN:  if (vdrive_unit_for(&v->vd, v->h->arg) >= 0) fload_open(v);  else notmine = 1; break;
+        case VIO_FLOAD_BLK:   fload_blk(v); break;
+        case VIO_FSAVE_OPEN:  if (vdrive_unit_for(&v->vd, v->h->arg) >= 0) fsave_open(v);  else notmine = 1; break;
+        case VIO_FSAVE_BLK:   fsave_blk(v); break;
+        case VIO_FSAVE_CLOSE: fsave_close(v); break;
+        case VIO_SCAN:        v->scan_state = 3; v->h->data = (uint8_t)vdrive_scan_begin(&v->vd); break;
+        case VIO_FREE:        v->h->data = (uint8_t)vdrive_scan_free(&v->vd, v->h->arg); break;
+        default: notmine = 1;
+    }
+    vio_publish_devices(v);                             /* a U0> or a scan step may have moved a unit */
+    v->h->pending = 0;                                  /* order: results first ... */
+    v->h->stat = ask ? VIO_SCANREQ : notmine ? VIO_NOTMINE : VIO_OK;   /* ... then publish the answer token */
+    return 1;
+}
+
+VD_COLD size_t vio_sizeof(void) { return sizeof(vio_t); }
+VD_COLD size_t vio_hot_sizeof(void) { return sizeof(vio_hot_t); }
diff --git a/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.h b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.h
new file mode 100644
index 0000000..698301b
--- /dev/null
+++ b/Source/Teensy/MinimalBoot/Common/vdrive/vdrive_io.h
@@ -0,0 +1,77 @@
+/* Mailbox register engine for the TR+ virtual drive.
+ *
+ *   IO1 ($DE10, offsets below are relative to it): +0 CMD (W: trigger)  +1 ARG (RW)  +2 DATA (R)  +3 STAT (R)  +4 ST (R)  +5 LEN (RW)
+ *                                                  +6 DEV0 (R)  +7 DEV1 (R): IEC device number of the SD / USB drive now (0 = none)
+ *   IO2 ($DF00): 256-byte window (RW): file name in, data blocks in/out
+ *
+ * ISR side (vio_io*_read/write) is O(1) and never touches storage. Everything
+ * else runs from vio_poll() in the main loop. Portable C: host tests and the
+ * Teensy glue (IOH_VDrive.c) use the same code.
+ *
+ * Everything the bus ISR touches lives in the small vio_hot_t, which the firmware keeps in fast RAM1
+ * (DTCM); the large drive state (vio_t) can sit in slower RAM2 because only the main loop uses it.
+ *
+ * STAT is a handshake token, not a flag byte: BUSY ($80) from the moment CMD is written, then
+ * OK ($5A) or NOTMINE ($A5) when the answer is complete. The 6502 waits for exactly one of the two, so a
+ * floating-bus misread (which returns the previous bus byte, $DE here) can never look like "done".
+ *
+ * Bus scan: the Teensy cannot see the serial bus, so when a unit has no fixed device number it asks the 6502 to probe it. It does
+ * so lazily, on the first transaction of a run (the VDrive handler only becomes active once the program has been loaded): that
+ * command is answered with SCANREQ instead of being executed; the KERNAL sends SCAN, then FREE for each number where its
+ * LISTEN found nobody, until the answer says nobody is waiting, and then repeats the original command. Asked once only: a
+ * KERNAL that does not understand SCANREQ just times out on that one call and the defaults stay. */
+#ifndef VDRIVE_IO_H
+#define VDRIVE_IO_H
+#include "vdrive.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { VIO_CMD = 0, VIO_ARG = 1, VIO_DATA = 2, VIO_STAT = 3, VIO_ST = 4, VIO_LEN = 5, VIO_DEV0 = 6, VIO_DEV1 = 7, VIO_NREGS = 8 };
+#define VIO_BUSY    0x80
+#define VIO_OK      0x5A
+#define VIO_NOTMINE 0xA5
+#define VIO_SCANREQ 0x3C   /* answer to the first LISTEN / TALK / fast LOAD / fast SAVE of a run: "scan the bus, then ask again" (see VIO_SCAN) */
+
+/* Commands 1..8 are VD_LISTEN..VD_UNTLK (byte-level). Fast paths: */
+enum {
+    VIO_FLOAD_OPEN = 9,    /* ARG=device, window[0..LEN) = name. DATA: 0 ok (window[0..1] = load address), 4 not found, 5 no device */
+    VIO_FLOAD_BLK  = 10,   /* DATA = byte count (0..255) now in window; ST=$40 on the last block */
+    VIO_FSAVE_OPEN = 11,   /* ARG=device, window[0..LEN) = name. DATA: 0 ok else DOS error code (63, 72, ...) or 5 */
+    VIO_FSAVE_BLK  = 12,   /* LEN bytes from window are appended to the file */
+    VIO_FSAVE_CLOSE= 13,   /* DATA: 0 ok else DOS error code */
+    VIO_SCAN       = 14,   /* start of the reset-time bus scan: releases the automatic units' numbers. DATA = units that need a number */
+    VIO_FREE       = 15    /* ARG = a device number nobody answered at; it goes to the next unit that needs one. DATA = units still waiting */
+};
+
+/* Registers + window: the only memory the bus ISR reads or writes (~270 bytes). Keep in DTCM. */
+typedef struct {
+    volatile uint8_t cmd, arg, data, stat, st, len, dev0, dev1, pending;
+    uint8_t window[256];
+} vio_hot_t;
+
+/* Drive state and fast-path bookkeeping: main loop only. */
+typedef struct {
+    vdrive_t vd;                       /* must stay first: callers pass a vio_t* where a vdrive_t* is wanted */
+    vio_hot_t *h;
+    uint8_t fl_active, fl_eof, fl_dev, fs_active, fs_dev;
+    uint8_t scan_state;                /* 0 not needed, 1 to be requested, 2 requested, 3 done */
+} vio_t;
+
+void    vio_init(vio_t *v, vio_hot_t *hot);
+uint8_t vio_io1_read(const vio_hot_t *h, uint8_t off);          /* ISR */
+void    vio_io1_write(vio_hot_t *h, uint8_t off, uint8_t val);  /* ISR */
+uint8_t vio_io2_read(const vio_hot_t *h, uint8_t off);          /* ISR */
+void    vio_io2_write(vio_hot_t *h, uint8_t off, uint8_t val);  /* ISR */
+int     vio_poll(vio_t *v);                  /* 1 if a command was processed */
+int     vio_arm_scan(vio_t *v);              /* call once the units and pinned numbers are set: 1 if the KERNAL will be asked to scan the bus */
+void    vio_publish_devices(vio_t *v);       /* copy the current device numbers to the DEV0/DEV1 registers (call after vdrive_set_devices) */
+
+size_t  vio_sizeof(void);
+size_t  vio_hot_sizeof(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
